{% extends 'pilotage/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}Ticket {{ vente.numero }}{% endblock %}

{# Un ticket se lit en colonne, comme le papier : on garde le cadre étroit plutôt
   que d'étirer une dizaine de lignes sur toute la largeur d'un écran. #}
{% block pilotage_largeur %}max-w-3xl{% endblock %}

{% block pilotage_content %}
<a href="{{ path('pilotage_ventes', {jour: vente.createdAt|date('Y-m-d')}) }}"
   class="btn btn-fantome apparition -ml-3 mb-3">{{ ui.icone('retour') }} Tickets du {{ vente.createdAt|date('d/m/Y') }}</a>

{% if not vente.estValidee %}
    <div class="alerte alerte-rouge apparition mb-4">
        {{ ui.icone('erreur') }}
        <p><span class="font-semibold">Ticket annulé.</span>{% if vente.motifAnnulation %} Motif : {{ vente.motifAnnulation }}{% endif %}</p>
    </div>
{% endif %}

{# ---- Identité du ticket ---- #}
<section class="heros apparition mb-4" style="--i: 1">
    <div class="flex items-start justify-between gap-3">
        <div>
            <div class="text-xs font-semibold uppercase tracking-[.14em] text-amber-300">Total TTC</div>
            <div class="mt-1 text-4xl font-black tabular-nums text-white {{ vente.estValidee ? '' : 'line-through opacity-60' }}">{{ fmt.fcfa(vente.totalTtc) }}</div>
            <div class="code mt-1 text-stone-400">{{ vente.numero }}</div>
        </div>
        <span class="badge {{ vente.estValidee ? 'badge-vert' : 'badge-rouge' }} badge-point">{{ vente.estValidee ? 'Validée' : 'Annulée' }}</span>
    </div>

    <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-white/10 pt-4 text-sm">
        <div>
            <dt class="text-stone-400">Caissier</dt>
            <dd class="font-semibold text-white">{{ vente.sessionCaisse.utilisateur.nom }}</dd>
        </div>
        <div>
            <dt class="text-stone-400">Date et heure</dt>
            <dd class="font-medium tabular-nums text-stone-100">{{ vente.createdAt|date('d/m/Y à H:i:s') }}</dd>
        </div>
        <div>
            <dt class="text-stone-400">Mode de vente</dt>
            <dd class="font-medium text-stone-100">{{ vente.mode.value == 'BOULANGERIE' ? 'Boulangerie' : 'Fast-food' }}</dd>
        </div>
        <div>
            <dt class="text-stone-400">Session de caisse</dt>
            <dd class="font-medium text-stone-100">
                n° {{ vente.sessionCaisse.id }}
                <span class="text-stone-400">({{ vente.sessionCaisse.estOuverte ? 'ouverte' : 'clôturée' }})</span>
            </dd>
        </div>
    </dl>
</section>

{# ---- Lignes ---- #}
<section class="carte apparition mb-4" style="--i: 2">
    <div class="carte-entete"><h2 class="carte-titre">Articles</h2><span class="carte-note">{{ ticket.lignes|length }} ligne(s)</span></div>
    <ul class="divide-y divide-stone-100 px-5">
        {% for ligne in ticket.lignes %}
            <li class="flex items-start gap-3 py-3">
                <span class="grid h-8 min-w-8 shrink-0 place-items-center rounded-lg bg-stone-100 px-1.5 text-xs font-bold tabular-nums text-stone-600">{{ fmt.unites(ligne.quantiteMillimes) }}×</span>
                <div class="min-w-0 flex-1">
                    <div class="font-medium text-stone-800">{{ ligne.nom }}</div>
                    {% if ligne.commentaire %}
                        <div class="text-xs italic text-stone-500">{{ ligne.commentaire }}</div>
                    {% endif %}
                    <div class="text-xs text-stone-400">{{ fmt.fcfa(ligne.prixUnitaire) }} l'unité</div>
                </div>
                <span class="shrink-0 font-semibold tabular-nums text-stone-900">{{ fmt.fcfa(ligne.montant) }}</span>
            </li>
        {% endfor %}
    </ul>

    <dl class="carte-pied block space-y-2 text-sm">
        {% if vente.remise > 0 %}
            <div class="flex justify-between gap-3 text-amber-700">
                <dt>Remise{% if vente.motifRemise %} <span class="text-xs">({{ vente.motifRemise }})</span>{% endif %}</dt>
                <dd class="font-semibold tabular-nums">− {{ fmt.fcfa(vente.remise) }}</dd>
            </div>
        {% endif %}
        <div class="flex justify-between gap-3"><dt class="text-stone-500">Total HT</dt><dd class="tabular-nums">{{ fmt.fcfa(vente.totalHt) }}</dd></div>
        <div class="flex justify-between gap-3"><dt class="text-stone-500">TVA</dt><dd class="tabular-nums">{{ fmt.fcfa(vente.totalTva) }}</dd></div>
        <div class="flex justify-between gap-3 border-t border-stone-200 pt-2 text-base font-bold text-stone-900"><dt>Total TTC</dt><dd class="tabular-nums">{{ fmt.fcfa(vente.totalTtc) }}</dd></div>
    </dl>
</section>

{# ---- Règlements ---- #}
<section class="carte apparition mb-4" style="--i: 3">
    <div class="carte-entete"><h2 class="carte-titre">Règlement</h2></div>
    <ul class="carte-corps space-y-2.5 text-sm">
        {% for reglement in vente.reglements %}
            <li class="flex items-center justify-between gap-3">
                <span class="flex items-center gap-2 text-stone-700">
                    <span class="kpi-icone h-8 w-8">{{ ui.icone('argent', 'h-4 w-4') }}</span>
                    {{ reglement.mode.libelle }}
                    {% if reglement.reference %}<span class="text-xs text-stone-400">({{ reglement.reference }})</span>{% endif %}
                </span>
                <span class="font-semibold tabular-nums">{{ fmt.fcfa(reglement.montant) }}</span>
            </li>
        {% endfor %}
        {% if vente.rendu > 0 %}
            <li class="flex justify-between gap-3 border-t border-stone-100 pt-2.5">
                <span class="font-medium text-stone-700">Rendu</span>
                <span class="font-bold tabular-nums">{{ fmt.fcfa(vente.rendu) }}</span>
            </li>
        {% endif %}
    </ul>
</section>

<a href="{{ path('app_caisse_ticket', {uuid: vente.uuid}) }}" target="_blank"
   class="btn btn-secondaire btn-lg apparition w-full" style="--i: 4">
    {{ ui.icone('imprimer') }} Voir le ticket imprimable
</a>
{% endblock %}
