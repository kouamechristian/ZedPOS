{# Cadre de l'espace de pilotage (dirigeante). Mobile-first : une colonne par
   défaut, la largeur ne s'élargit qu'à partir de `sm`. #}
{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}Pilotage{% endblock %} — ZedPOS{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-100 text-slate-800 pb-16">
    {# En-tête collant : sur téléphone on fait défiler beaucoup. #}
    <header class="sticky top-0 z-20 bg-slate-900 text-white shadow-lg">
        <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
            <div class="min-w-0">
                <div class="font-bold leading-tight">ZedPOS</div>
                <div class="text-xs text-slate-400 truncate">{{ block('page_title') }}</div>
            </div>
            <a href="{{ path('app_logout') }}"
               class="shrink-0 rounded-lg bg-slate-700 px-3 py-2 text-sm font-medium hover:bg-slate-600">Quitter</a>
        </div>

        <nav class="max-w-3xl mx-auto px-4 pb-2 flex gap-1.5 overflow-x-auto text-sm"
             data-turbo-prefetch="true">
            {% set courante = app.request.attributes.get('_route') %}
            {% set onglets = [
                { label: 'Aujourd\'hui', route: 'app_pilotage' },
                { label: 'Tickets',      route: 'pilotage_ventes' },
                { label: 'Audit',        route: 'pilotage_audit' },
                { label: 'Back-office',  route: 'admin_dashboard' },
            ] %}
            {% for onglet in onglets %}
                <a href="{{ path(onglet.route) }}"
                   class="shrink-0 rounded-lg px-3 py-1.5 font-medium {{ courante == onglet.route ? 'bg-white text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700' }}">
                    {{ onglet.label }}
                </a>
            {% endfor %}
        </nav>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-5">
        {% for type, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="mb-4 rounded-xl px-4 py-3 text-sm {{ type == 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block pilotage_content %}{% endblock %}
    </main>
</div>
{% endblock %}
