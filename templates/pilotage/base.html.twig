{# Cadre de l'espace de pilotage (dirigeante).

   **Mobile-first, puis large.** La dirigeante consulte cet écran depuis son
   téléphone à Abidjan : la mise en page de base reste donc une colonne unique,
   avec des chiffres lisibles à bout de bras, et les onglets descendent **en bas
   de l'écran**, là où tombe le pouce. À partir de `md`, ils remontent sous
   l'en-tête ; à partir de `lg`, le cadre s'élargit pour occuper l'écran d'un
   ordinateur — l'ordre de lecture, lui, ne change pas.

   La largeur passe par un bloc : une page qui gagnerait à rester étroite (une
   liste, une fiche) peut la redéfinir sans toucher au cadre. #}
{% extends 'base.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{# Le nom vient de /admin/parametres, jamais du gabarit. #}
{% block title %}{% block page_title %}Pilotage{% endblock %} — {{ nom_boutique() }}{% endblock %}

{% block pilotage_largeur %}max-w-3xl lg:max-w-7xl{% endblock %}

{% block body %}
{% set courante = app.request.attributes.get('_route') %}
{% set onglets = [
    { label: 'Aujourd\'hui',  court: 'Jour',     route: 'app_pilotage',     match: ['app_pilotage'],   icone: 'jour' },
    { label: 'Tickets',       court: 'Tickets',  route: 'pilotage_ventes',  match: ['pilotage_vente'], icone: 'ventes' },
    { label: 'Audit',         court: 'Audit',    route: 'pilotage_audit',   match: ['pilotage_audit'], icone: 'audit' },
    { label: 'Comptabilité',  court: 'Compta',   route: 'app_comptabilite', match: [],                 icone: 'comptabilite' },
    { label: 'Back-office',   court: 'Gestion',  route: 'admin_dashboard',  match: [],                 icone: 'backoffice' },
] %}

<div class="espace-gestion min-h-screen pb-24 md:pb-8">
    {# En-tête collant et translucide : sur téléphone on fait défiler beaucoup, et
       le nom de la boutique reste à portée d'œil. #}
    <header class="entete-flottante">
        <div class="{{ block('pilotage_largeur') }} mx-auto px-4 sm:px-6">
            <div class="flex h-16 items-center justify-between gap-3">
                <div class="flex min-w-0 items-center gap-3">
                    {# Logo saisi dans /admin/parametres, sinon la pastille « Z ».

                       Nommée `logo_entete` pour la même raison que dans le back-office :
                       la variable vit dans le bloc qui rend les pages filles. #}
                    {% set logo_entete = logo_boutique() %}
                    {% if logo_entete %}
                        <img src="{{ logo_entete }}" alt="" class="marque-logo" onerror="this.remove()">
                    {% else %}
                        <span class="marque-pastille">Z</span>
                    {% endif %}
                    {# Tronqué et non passé à la ligne, contrairement au back-office :
                       l'en-tête est collant et partagé avec « Quitter » sur un
                       téléphone — un nom sur deux lignes volerait de la hauteur aux
                       chiffres à chaque défilement. #}
                    <div class="min-w-0 leading-tight">
                        <div class="truncate text-[15px] font-bold tracking-tight text-stone-900">{{ nom_boutique() }}</div>
                        <div class="truncate text-xs font-medium text-amber-700">Pilotage · {{ block('page_title') }}</div>
                    </div>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                    {# Icône seule sur téléphone : l'en-tête est déjà partagé entre
                       le nom de la boutique et « Quitter ». #}
                    <a href="{{ path('app_compte_mot_de_passe') }}" class="btn btn-secondaire btn-sm"
                       title="Changer mon mot de passe" aria-label="Changer mon mot de passe">
                        {{ ui.icone('cle') }}<span class="max-lg:hidden">Mot de passe</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondaire btn-sm">
                        {{ ui.icone('deconnexion') }}<span class="max-sm:hidden">Quitter</span>
                    </a>
                </div>
            </div>

            <nav class="hidden pb-3 md:block" data-turbo-prefetch="true" aria-label="Espaces de pilotage">
                <div class="onglets">
                    {% for onglet in onglets %}
                        {% set actif = onglet.match|filter(prefixe => courante starts with prefixe)|length > 0 %}
                        <a href="{{ path(onglet.route) }}" class="onglet inline-flex items-center gap-1.5"
                           {% if actif %}aria-current="page"{% endif %}>
                            {{ ui.icone(onglet.icone, 'h-4 w-4') }} {{ onglet.label }}
                        </a>
                    {% endfor %}
                </div>
            </nav>
        </div>
    </header>

    <main class="contenu {{ block('pilotage_largeur') }}">
        {% block pilotage_content %}{% endblock %}
    </main>

    {# Téléphone : les mêmes onglets, en bas d'écran. #}
    <nav class="onglets-bas" aria-label="Espaces de pilotage (mobile)">
        {% for onglet in onglets %}
            {% set actif = onglet.match|filter(prefixe => courante starts with prefixe)|length > 0 %}
            <a href="{{ path(onglet.route) }}" class="onglet-bas" {% if actif %}aria-current="page"{% endif %}>
                {{ ui.icone(onglet.icone) }}
                <span>{{ onglet.court }}</span>
            </a>
        {% endfor %}
    </nav>

    {{ include('admin/_toasts.html.twig') }}
</div>
{% endblock %}
