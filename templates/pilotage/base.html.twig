{# Cadre de l'espace de pilotage (dirigeante).

   **Mobile-first, puis large.** La dirigeante consulte cet écran depuis son
   téléphone à Abidjan : la mise en page de base reste donc une colonne unique,
   avec des chiffres lisibles à bout de bras. À partir de `lg`, le cadre s'élargit
   pour occuper l'écran d'un ordinateur au lieu de laisser deux bandes vides —
   l'ordre de lecture, lui, ne change pas : ce qui vient en premier sur téléphone
   reste en haut à gauche sur grand écran.

   La largeur passe par un bloc : une page qui gagnerait à rester étroite (une
   liste, une fiche) peut la redéfinir sans toucher au cadre. #}
{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}Pilotage{% endblock %} — ZedPOS{% endblock %}

{% block pilotage_largeur %}max-w-3xl lg:max-w-7xl{% endblock %}

{% block body %}
<div class="min-h-screen bg-amber-50 text-stone-800 pb-16">
    {# En-tête collant : sur téléphone on fait défiler beaucoup.
       Dégradé chaud plutôt qu'un aplat : c'est l'écran montré au client. #}
    <header class="sticky top-0 z-20 bg-gradient-to-br from-stone-900 via-stone-900 to-amber-950 text-white shadow-lg shadow-amber-900/10">
        <div class="{{ block('pilotage_largeur') }} mx-auto px-4 py-3 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 min-w-0">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-amber-500 text-stone-900 text-sm font-black">Z</span>
                <div class="min-w-0 leading-tight">
                    <div class="titre font-bold">ZedPOS</div>
                    <div class="text-xs text-amber-200/80 truncate">{{ block('page_title') }}</div>
                </div>
            </div>
            <a href="{{ path('app_logout') }}"
               class="shrink-0 rounded-lg bg-white/10 px-3 py-2 text-sm font-medium hover:bg-white/20">Quitter</a>
        </div>

        <nav class="{{ block('pilotage_largeur') }} mx-auto px-4 pb-2.5 flex gap-1.5 overflow-x-auto text-sm"
             data-turbo-prefetch="true">
            {% set courante = app.request.attributes.get('_route') %}
            {% set onglets = [
                { label: 'Aujourd\'hui', route: 'app_pilotage' },
                { label: 'Tickets',      route: 'pilotage_ventes' },
                { label: 'Audit',        route: 'pilotage_audit' },
                { label: 'Comptabilité', route: 'app_comptabilite' },
                { label: 'Back-office',  route: 'admin_dashboard' },
            ] %}
            {% for onglet in onglets %}
                <a href="{{ path(onglet.route) }}"
                   class="shrink-0 rounded-full px-3.5 py-1.5 font-semibold transition
                          {{ courante == onglet.route
                             ? 'bg-amber-500 text-stone-900'
                             : 'bg-white/10 text-amber-100 hover:bg-white/20' }}">
                    {{ onglet.label }}
                </a>
            {% endfor %}
        </nav>
    </header>

    <main class="{{ block('pilotage_largeur') }} mx-auto px-4 py-5">
        {% for type, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="mb-4 rounded-xl px-4 py-3 text-sm {{ type == 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block pilotage_content %}{% endblock %}
    </main>
</div>
{% endblock %}
