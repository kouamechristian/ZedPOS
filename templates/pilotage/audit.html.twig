{% extends 'pilotage/base.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}

{% block page_title %}Journal d'audit{% endblock %}

{% macro valeurs(donnees) %}
    {% if donnees is empty %}
        <span class="text-stone-300">—</span>
    {% else %}
        <dl class="space-y-0.5">
            {% for cle, valeur in donnees %}
                <div class="flex gap-1.5">
                    <dt class="text-stone-400">{{ cle }} :</dt>
                    <dd class="font-medium text-stone-700 break-all">
                        {%- if valeur is null -%}<span class="text-stone-300">null</span>
                        {%- elseif valeur is same as(true) -%}oui
                        {%- elseif valeur is same as(false) -%}non
                        {%- elseif valeur is iterable -%}{{ valeur|join(', ') }}
                        {%- else -%}{{ valeur }}
                        {%- endif -%}
                    </dd>
                </div>
            {% endfor %}
        </dl>
    {% endif %}
{% endmacro %}

{% block pilotage_content %}
{% import _self as rendu %}

<div class="entete-page apparition">
    <div>
        <div class="sur-titre">Traçabilité</div>
        <h1>Journal d'audit</h1>
        <p class="mt-1.5 max-w-2xl text-sm text-stone-500">Connexions, annulations, remises, écarts et changements de comptes — dans l'ordre où ils sont arrivés.</p>
    </div>
</div>

{# ---- Filtres ---- #}
<form method="get" class="carte apparition mb-5 grid items-end gap-4 p-4 sm:grid-cols-2 lg:grid-cols-5" style="--i: 1">
    <div>
        <label for="du" class="etiquette-legere">Du</label>
        <input type="date" id="du" name="du" value="{{ filtres.du }}" class="champ">
    </div>
    <div>
        <label for="au" class="etiquette-legere">Au</label>
        <input type="date" id="au" name="au" value="{{ filtres.au }}" class="champ">
    </div>
    <div>
        <label for="utilisateur" class="etiquette-legere">Utilisateur</label>
        <select id="utilisateur" name="utilisateur" class="champ">
            <option value="">— Tous —</option>
            {% for auteur in auteurs %}
                <option value="{{ auteur.id }}" {{ filtres.utilisateur == auteur.id ? 'selected' }}>{{ auteur.nom }}</option>
            {% endfor %}
        </select>
    </div>
    <div>
        <label for="action" class="etiquette-legere">Type d'action</label>
        <select id="action" name="action" class="champ">
            <option value="">— Toutes —</option>
            {% for famille, groupe in actionsParFamille %}
                <optgroup label="{{ famille }}">
                    {% for action in groupe %}
                        <option value="{{ action.value }}" {{ filtres.action == action.value ? 'selected' }}>{{ action.libelle }}</option>
                    {% endfor %}
                </optgroup>
            {% endfor %}
        </select>
    </div>
    <div class="flex gap-2">
        <button class="btn btn-primaire flex-1">{{ ui.icone('filtre') }} Filtrer</button>
        <a href="{{ path('pilotage_audit') }}" class="btn btn-secondaire btn-icone" title="Réinitialiser" aria-label="Réinitialiser">{{ ui.icone('fermer', 'h-4 w-4') }}</a>
    </div>
</form>

<div class="mb-3 flex items-baseline justify-between text-sm text-stone-500">
    <span><strong class="font-semibold text-stone-800">{{ resultat.total }}</strong> entrée{{ resultat.total > 1 ? 's' }}</span>
    <span class="tabular-nums">Page {{ resultat.page }} / {{ resultat.pages }}</span>
</div>

{# ---- Entrées ---- #}
<div class="tableau-conteneur apparition" style="--i: 2">
    <div class="defilement-x">
        <table class="tableau">
            <thead>
                <tr>
                    <th>Horodatage</th>
                    <th>Utilisateur</th>
                    <th>Action</th>
                    <th>Entité</th>
                    <th>Avant</th>
                    <th>Après</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                {% for entree in resultat.items %}
                    {% set action = libelles[entree.action]|default(null) %}
                    <tr class="align-top {{ action and action.sensible ? 'bg-amber-50/40' : '' }}">
                        <td class="whitespace-nowrap tabular-nums text-stone-600">{{ entree.createdAt|date('d/m/Y H:i:s') }}</td>
                        <td class="cellule-principale">{{ entree.utilisateur ? entree.utilisateur.nom : '—' }}</td>
                        <td>
                            <span class="badge {{ action and action.sensible ? 'badge-ambre badge-point' : 'badge-neutre' }}">
                                {{ action ? action.libelle : entree.action }}
                            </span>
                        </td>
                        <td class="whitespace-nowrap text-stone-600">
                            {{ entree.entite }}{% if entree.entiteId %} <span class="text-stone-400">#{{ entree.entiteId }}</span>{% endif %}
                        </td>
                        <td class="text-xs">{{ rendu.valeurs(entree.avant) }}</td>
                        <td class="text-xs">{{ rendu.valeurs(entree.apres) }}</td>
                        <td class="code whitespace-nowrap text-stone-400">{{ entree.ip ?: '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="cellule-vide">Aucune entrée pour ces critères.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{{ pagination.barre(resultat, 'pilotage_audit', filtres|filter(v => v is not null)) }}

<p class="aide mt-6 flex items-center gap-2">
    {{ ui.icone('audit', 'h-4 w-4 text-stone-400') }}
    <span>Le journal d'audit est <strong>inaltérable</strong> : les entrées sont ajoutées automatiquement
    et ne peuvent être ni modifiées ni supprimées depuis l'application.</span>
</p>
{% endblock %}
