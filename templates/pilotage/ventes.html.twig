{% extends 'pilotage/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import '_pagination.html.twig' as pagination %}

{% block page_title %}Tickets du {{ jour|date('d/m/Y') }}{% endblock %}

{% block pilotage_content %}
{# Changer de jour ou de page ne rafraîchit que cette liste. #}
<turbo-frame id="liste-tickets" data-turbo-action="advance">

<form method="get" class="mb-4 flex items-center gap-2">
    <label for="jour" class="sr-only">Journée</label>
    <input type="date" id="jour" name="jour" value="{{ jour|date('Y-m-d') }}"
           class="flex-1 rounded-xl border border-stone-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-stone-400">
    <button class="rounded-xl bg-stone-900 text-white px-4 py-2.5 text-sm font-semibold hover:bg-stone-700">Voir</button>
</form>

<div class="mb-3 flex items-baseline justify-between text-sm text-stone-500">
    <span>{{ resultat.total }} ticket{{ resultat.total > 1 ? 's' }}</span>
    <span>Page {{ resultat.page }} / {{ resultat.pages }}</span>
</div>

{# Cartes plutôt qu'un tableau : lisible sur un écran étroit. Elles se rangent en
   colonnes quand la place le permet, plutôt que de s'étirer sur toute la largeur
   d'un écran d'ordinateur pour trois informations. #}
<ul class="grid gap-2 md:grid-cols-2 xl:grid-cols-3">
    {% for vente in resultat.items %}
        <li>
            <a href="{{ path('pilotage_vente', {uuid: vente.uuid}) }}" data-turbo-frame="_top"
               class="block h-full bg-white rounded-2xl shadow-sm p-4 hover:shadow-md transition">
                <div class="flex items-baseline justify-between gap-3">
                    <span class="font-mono text-xs text-stone-500">{{ vente.numero }}</span>
                    <span class="text-lg font-black tabular-nums {{ vente.estValidee ? 'text-stone-900' : 'text-stone-400 line-through' }}">
                        {{ fmt.fcfa(vente.totalTtc) }}
                    </span>
                </div>
                <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-stone-500">
                    <span class="tabular-nums">{{ vente.createdAt|date('H:i') }}</span>
                    <span class="font-medium text-stone-700">{{ vente.sessionCaisse.utilisateur.nom }}</span>
                    <span class="inline-flex rounded-full px-2 py-0.5 text-xs {{ vente.mode.value == 'BOULANGERIE' ? 'bg-amber-100 text-amber-800' : 'bg-orange-100 text-orange-800' }}">
                        {{ vente.mode.value == 'BOULANGERIE' ? 'Boulangerie' : 'Fast-food' }}
                    </span>
                    {% if not vente.estValidee %}
                        <span class="inline-flex rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-800">Annulée</span>
                    {% endif %}
                    {% if vente.remise > 0 %}
                        <span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">
                            Remise {{ fmt.fcfa(vente.remise) }}
                        </span>
                    {% endif %}
                </div>
            </a>
        </li>
    {% else %}
        <li class="bg-white rounded-2xl shadow-sm p-8 text-center text-stone-400">Aucun ticket ce jour-là.</li>
    {% endfor %}
</ul>

{{ pagination.barre(resultat, 'pilotage_ventes', {jour: jour|date('Y-m-d')}) }}

</turbo-frame>
{% endblock %}
