{% extends 'pilotage/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}{{ synthese.jour|date('d/m/Y') }}{% endblock %}

{# Pastille de variation, posée sur la carte sombre du chiffre d'affaires : verte
   si en hausse, rouge si en baisse, neutre sinon. #}
{% macro variation(bp, libelle) %}
    {% if bp is null %}
        <span class="inline-flex items-center rounded-full bg-white/10 px-2.5 py-1 text-xs font-medium text-stone-300 ring-1 ring-inset ring-white/10">
            {{ libelle }} : —
        </span>
    {% else %}
        {% set hausse = bp > 0 %}
        {% set nul = bp == 0 %}
        <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-bold ring-1 ring-inset
                     {{ nul ? 'bg-white/10 text-stone-200 ring-white/10' : (hausse ? 'bg-green-400/15 text-green-300 ring-green-400/25' : 'bg-red-400/15 text-red-300 ring-red-400/25') }}">
            {{ nul ? '=' : (hausse ? '▲' : '▼') }}
            {{ hausse ? '+' }}{{ (bp / 100)|number_format(1, ',', ' ') }} %
            <span class="font-normal opacity-80">{{ libelle }}</span>
        </span>
    {% endif %}
{% endmacro %}

{% block pilotage_content %}
{% import _self as vue %}
<h1 class="sr-only">Pilotage de la journée du {{ synthese.jour|date('d/m/Y') }}</h1>

{# ---- Alertes : annulations de ventes, à acquitter ---- #}
{% if notifications is not empty %}
    <section class="mb-5 space-y-3">
        {% for notification in notifications %}
            <div class="alerte alerte-rouge apparition shadow-sm" style="--i: {{ loop.index0 }}">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-red-100 text-red-700">{{ ui.icone('pertes') }}</span>
                <div class="min-w-0 flex-1">
                    <div class="font-bold text-red-900">{{ notification.titre }}</div>
                    <p class="mt-0.5 text-red-800">{{ notification.message }}</p>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        {% if notification.lien %}
                            <a href="{{ notification.lien }}" class="btn btn-sm btn-danger-plein">Voir le ticket</a>
                        {% endif %}
                        <form method="post" action="{{ path('pilotage_notification_lue', {id: notification.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('notification_' ~ notification.id) }}">
                            <button class="btn btn-sm btn-secondaire">J'ai vu</button>
                        </form>
                        <span class="text-xs text-red-700/80">{{ notification.createdAt|date('d/m/Y H:i') }}</span>
                    </div>
                </div>
            </div>
        {% endfor %}
    </section>
{% endif %}

{# ---- Barre d'outils : journée consultée et téléchargements ----
   Les liens de téléchargement portent `data-turbo="false"` : Turbo intercepte
   les clics et attend une page HTML en retour — sans lui, le fichier ne se
   télécharge pas et la navigation échoue en silence. #}
<section class="apparition mb-5 flex flex-wrap items-center gap-3">
    <form method="get" class="flex items-center gap-2" data-controller="soumission-auto">
        <label for="jour" class="sr-only">Journée</label>
        <div class="champ-avec-icone">
            {{ ui.icone('calendrier') }}
            <input type="date" id="jour" name="jour" value="{{ synthese.jour|date('Y-m-d') }}"
                   data-action="change->soumission-auto#soumettre" class="champ h-10 w-auto">
        </div>
        {# Repli sans JavaScript : le bouton reste, il est simplement inutile
           quand le champ se soumet tout seul. #}
        <noscript>
            <button class="btn btn-primaire">Voir</button>
        </noscript>
    </form>

    <div class="onglets" data-turbo-prefetch="true">
        {% for raccourci in raccourcis %}
            <a href="{{ path('app_pilotage', {jour: raccourci.jour}) }}" class="onglet"
               {% if raccourci.jour == synthese.jour|date('Y-m-d') %}aria-current="page"{% endif %}>
                {{ raccourci.label }}
            </a>
        {% endfor %}
    </div>

    <div class="flex items-center gap-2 sm:ml-auto">
        <a href="{{ path('pilotage_rapport_texte', {jour: synthese.jour|date('Y-m-d')}) }}" data-turbo="false" class="btn btn-secondaire">
            {{ ui.icone('telecharger') }} Rapport <span class="font-normal text-stone-400">.txt</span>
        </a>
        <a href="{{ path('pilotage_rapport_csv', {jour: synthese.jour|date('Y-m-d')}) }}" data-turbo="false" class="btn btn-secondaire">
            {{ ui.icone('telecharger') }} Ventes <span class="font-normal text-stone-400">.csv</span>
        </a>
    </div>
</section>

{# ---- Indicateurs du jour ---- #}
<section class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="heros apparition sm:col-span-2" style="--i: 1">
        <div class="flex items-center justify-between gap-3">
            <div class="text-xs font-semibold uppercase tracking-[.14em] text-amber-300">Chiffre d'affaires</div>
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-white/10 text-amber-200 ring-1 ring-inset ring-white/15">{{ ui.icone('argent') }}</span>
        </div>
        <div class="mt-2 break-words text-5xl font-black tracking-tight tabular-nums text-white sm:text-6xl">
            <span data-controller="compteur" data-compteur-cible-value="{{ synthese.caJour // 100 }}">{{ (synthese.caJour / 100)|number_format(0, ',', ' ') }}</span>
            <span class="text-2xl font-bold text-amber-300/80">FCFA</span>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
            {{ vue.variation(synthese.variationVeilleBp, 'vs veille') }}
            {{ vue.variation(synthese.variationSemaineBp, 'vs sem. dern.') }}
        </div>

        <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-white/10 pt-4 text-sm">
            <div>
                <dt class="text-stone-400">Veille</dt>
                <dd class="font-semibold tabular-nums text-stone-100">{{ fmt.fcfa(synthese.caVeille) }}</dd>
            </div>
            <div>
                <dt class="text-stone-400">Même jour, semaine dernière</dt>
                <dd class="font-semibold tabular-nums text-stone-100">{{ fmt.fcfa(synthese.caSemainePrecedente) }}</dd>
            </div>
        </dl>
    </div>

    <article class="kpi apparition flex flex-col justify-between" style="--i: 2">
        <div class="kpi-tete">
            <span class="kpi-libelle">Tickets</span>
            <span class="kpi-icone">{{ ui.icone('ventes') }}</span>
        </div>
        <div>
            <div class="kpi-valeur text-4xl">
                <span data-controller="compteur" data-compteur-cible-value="{{ synthese.nombreTickets }}">{{ synthese.nombreTickets }}</span>
            </div>
            <div class="kpi-note">
                {{ synthese.parCaissiere|length }} caissière{{ synthese.parCaissiere|length > 1 ? 's' }} en poste
            </div>
        </div>
    </article>

    <article class="kpi apparition flex flex-col justify-between" style="--i: 3">
        <div class="kpi-tete">
            <span class="kpi-libelle">Panier moyen</span>
            <span class="kpi-icone">{{ ui.icone('panier') }}</span>
        </div>
        <div>
            <div class="kpi-valeur text-4xl">
                <span data-controller="compteur" data-compteur-cible-value="{{ synthese.panierMoyen // 100 }}">{{ (synthese.panierMoyen / 100)|number_format(0, ',', ' ') }}</span>
            </div>
            <div class="kpi-note">FCFA</div>
        </div>
    </article>
</section>

{# ---- Corps : une colonne sur téléphone, trois à partir de lg ---- #}
<div class="grid gap-5 lg:grid-cols-3">

    {# ---- Ventes par caissière ---- #}
    <section class="carte apparition lg:col-span-2" style="--i: 4">
        <div class="carte-entete">
            <h2 class="carte-titre">Ventes par caissière</h2>
            {% if synthese.parCaissiere %}<span class="carte-note">sur {{ fmt.fcfa(synthese.caJour) }}</span>{% endif %}
        </div>

        <div class="carte-corps">
        {% if synthese.parCaissiere is empty %}
            <p class="py-6 text-center text-sm text-stone-400">Aucune vente encaissée ce jour-là.</p>
        {% else %}
            <div class="relative"
                 style="height: {{ 56 + synthese.parCaissiere|length * 42 }}px"
                 data-controller="graphique-caissieres"
                 data-graphique-caissieres-libelles-value="{{ caissieres.libelles|json_encode }}"
                 data-graphique-caissieres-valeurs-value="{{ caissieres.valeurs|json_encode }}"
                 data-graphique-caissieres-couleurs-value="{{ caissieres.couleurs|json_encode }}">
                <canvas data-graphique-caissieres-target="canvas" role="img"
                        aria-label="Chiffre d'affaires par caissière"></canvas>
            </div>

            <ul class="mt-4 divide-y divide-stone-100">
                {% for caissiere in synthese.parCaissiere %}
                    {% set initiales = caissiere.nom|split(' ')|filter(mot => mot is not empty)|slice(0, 2)|map(mot => mot|first|upper)|join('') %}
                    <li class="flex gap-3 py-3.5">
                        <span class="avatar h-9 w-9 text-xs">{{ initiales }}</span>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                                <span class="font-semibold text-stone-800">{{ caissiere.nom }}</span>
                                <span class="font-bold tabular-nums text-stone-900">{{ fmt.fcfa(caissiere.ca) }}</span>
                            </div>

                            <div class="mt-1.5 flex items-center gap-2">
                                <div class="jauge"><span style="width: {{ (caissiere.partBp / 100)|round }}%"></span></div>
                                <span class="w-10 text-right text-xs tabular-nums text-stone-400">
                                    {{ (caissiere.partBp / 100)|round }} %
                                </span>
                            </div>

                            <div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs text-stone-500">
                                <span class="mr-1">{{ caissiere.tickets }} ticket{{ caissiere.tickets > 1 ? 's' }}</span>
                                <span class="mr-1">panier {{ fmt.fcfa(caissiere.panierMoyen) }}</span>

                                {% if caissiere.remisesNombre > 0 %}
                                    <span class="badge badge-ambre">
                                        {{ caissiere.remisesNombre }} remise{{ caissiere.remisesNombre > 1 ? 's' }}
                                        · {{ fmt.fcfa(caissiere.remisesMontant) }}
                                    </span>
                                {% endif %}

                                {% if caissiere.annulationsNombre > 0 %}
                                    <span class="badge badge-rouge">
                                        {{ caissiere.annulationsNombre }} annulation{{ caissiere.annulationsNombre > 1 ? 's' }}
                                        · {{ fmt.fcfa(caissiere.annulationsMontant) }}
                                    </span>
                                {% endif %}

                                {# Caisse encore ouverte : l'écart n'existe pas, il ne
                                   vaut pas zéro. Afficher « 0 » laisserait croire à une
                                   caisse juste. #}
                                {% if caissiere.sessionOuverte %}
                                    <span class="badge badge-bleu badge-point">caisse ouverte</span>
                                {% elseif caissiere.ecart is null %}
                                    <span class="badge badge-neutre">non clôturée</span>
                                {% elseif caissiere.ecart == 0 %}
                                    <span class="badge badge-vert">caisse juste</span>
                                {% else %}
                                    <span class="badge badge-rouge">
                                        écart {{ caissiere.ecart > 0 ? '+' }}{{ fmt.fcfa(caissiere.ecart) }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        </div>
    </section>

    {# ---- Ventilation par mode de règlement ---- #}
    <section class="carte apparition" style="--i: 5">
        <div class="carte-entete"><h2 class="carte-titre">Modes de règlement</h2></div>
        <div class="carte-corps">
        {% if synthese.parReglement is empty %}
            <p class="py-6 text-center text-sm text-stone-400">Aucun règlement ce jour-là.</p>
        {% else %}
            <ul class="space-y-4">
                {% for ligne in synthese.parReglement %}
                    {% set part = synthese.caJour > 0 ? (ligne.montant * 100 / synthese.caJour) : 0 %}
                    <li>
                        <div class="flex items-baseline justify-between gap-3 text-sm">
                            <span class="font-medium text-stone-700">{{ ligne.libelle }}</span>
                            <span class="font-bold tabular-nums text-stone-900">{{ fmt.fcfa(ligne.montant) }}</span>
                        </div>
                        <div class="mt-1.5 flex items-center gap-2">
                            <div class="jauge jauge-sombre"><span style="width: {{ part|round }}%"></span></div>
                            <span class="w-10 text-right text-xs tabular-nums text-stone-400">{{ part|round }} %</span>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        </div>
    </section>

    {# ---- Courbe du CA sur 30 jours ---- #}
    <section class="carte apparition lg:col-span-2" style="--i: 6">
        <div class="carte-entete">
            <h2 class="carte-titre">Tendance sur 30 jours</h2>
            <span class="carte-note">jusqu’au {{ synthese.jour|date('d/m') }}</span>
        </div>
        <div class="carte-corps">
            <div class="relative h-56 lg:h-72"
                 data-controller="graphique-ca"
                 data-graphique-ca-libelles-value="{{ courbe.libelles|json_encode }}"
                 data-graphique-ca-valeurs-value="{{ courbe.valeurs|json_encode }}">
                <canvas data-graphique-ca-target="canvas" role="img"
                        aria-label="Évolution du chiffre d'affaires sur 30 jours"></canvas>
            </div>
        </div>
    </section>

    {# ---- Points de vigilance : le bloc vire à l'ambre dès qu'il y a quelque
         chose à signaler ---- #}
    {% set vigilance = synthese.aDesPointsDeVigilance %}
    <section class="carte apparition overflow-hidden {{ vigilance ? 'ring-2 ring-amber-300/70' : '' }}" style="--i: 7">
        <div class="carte-entete {{ vigilance ? 'bg-amber-50' : '' }}">
            <h2 class="carte-titre flex items-center gap-2">
                <span class="{{ vigilance ? 'text-amber-600' : 'text-green-600' }}">{{ ui.icone(vigilance ? 'pertes' : 'valide') }}</span>
                Points de vigilance
            </h2>
            {% if not vigilance %}
                <span class="badge badge-vert">journée propre</span>
            {% endif %}
        </div>

        {% set points = [
            { libelle: 'Annulations', valeur: synthese.annulationsNombre ~ (synthese.annulationsNombre > 0 ? ' · ' ~ fmt.fcfa(synthese.annulationsMontant) : ''), ton: synthese.annulationsNombre > 0 ? 'text-red-700' : 'text-stone-400' },
            { libelle: 'Remises accordées', valeur: synthese.remisesNombre ~ (synthese.remisesNombre > 0 ? ' · ' ~ fmt.fcfa(synthese.remisesMontant) : ''), ton: synthese.remisesNombre > 0 ? 'text-amber-700' : 'text-stone-400' },
            { libelle: 'Écart de caisse', valeur: synthese.ecartCaisse is null ? 'caisse non clôturée' : (synthese.ecartCaisse > 0 ? '+' : '') ~ fmt.fcfa(synthese.ecartCaisse), ton: synthese.ecartCaisse is null ? 'text-stone-400' : (synthese.ecartCaisse == 0 ? 'text-green-700' : 'text-red-700') },
            { libelle: 'Pertes valorisées', valeur: synthese.pertesNombre ~ (synthese.pertesMontant > 0 ? ' · ' ~ fmt.fcfa(synthese.pertesMontant) : ''), ton: synthese.pertesMontant > 0 ? 'text-amber-700' : 'text-stone-400' },
        ] %}
        <ul class="divide-y divide-stone-100 text-sm">
            {% for point in points %}
                <li class="flex items-baseline justify-between gap-3 px-5 py-3">
                    <span class="text-stone-600">{{ point.libelle }}</span>
                    <span class="font-semibold tabular-nums {{ point.ton }}">{{ point.valeur }}</span>
                </li>
            {% endfor %}
            <li class="px-5 py-3">
                <div class="flex items-baseline justify-between gap-3">
                    <span class="text-stone-600">Ruptures de stock</span>
                    <span class="font-semibold tabular-nums {{ synthese.rupturesStock is not empty ? 'text-red-700' : 'text-stone-400' }}">
                        {{ synthese.rupturesStock|length }}
                    </span>
                </div>
                {% if synthese.rupturesStock is not empty %}
                    <p class="mt-1 text-xs text-stone-500">{{ synthese.rupturesStock|join(', ') }}</p>
                {% endif %}
            </li>
        </ul>
    </section>

    {# ---- Top 10 des produits ---- #}
    <section class="carte apparition lg:col-span-2" style="--i: 8">
        <div class="carte-entete"><h2 class="carte-titre">Top 10 des produits</h2></div>
        {% if synthese.topProduits is empty %}
            <p class="py-8 text-center text-sm text-stone-400">Aucune vente ce jour-là.</p>
        {% else %}
            {% set premier = (synthese.topProduits|first).montant %}
            <ol class="divide-y divide-stone-100 px-2 pb-2">
                {% for produit in synthese.topProduits %}
                    <li class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition hover:bg-stone-50">
                        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg text-xs font-bold tabular-nums
                                     {{ loop.index <= 3 ? 'bg-amber-100 text-amber-800' : 'bg-stone-100 text-stone-500' }}">{{ loop.index }}</span>
                        <div class="min-w-0 flex-1">
                            <div class="truncate font-medium text-stone-800">{{ produit.nom }}</div>
                            <div class="mt-1 flex"><div class="jauge max-w-56"><span style="width: {{ premier > 0 ? produit.montant * 100 // premier : 0 }}%"></span></div></div>
                        </div>
                        <span class="shrink-0 text-sm tabular-nums text-stone-500">×{{ fmt.unites(produit.quantite) }}</span>
                        <span class="w-24 shrink-0 text-right font-semibold tabular-nums text-stone-900">{{ fmt.fcfa(produit.montant) }}</span>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </section>

    {# ---- Accès aux tickets ---- #}
    <section class="apparition flex" style="--i: 9">
        <a href="{{ path('pilotage_ventes', {jour: synthese.jour|date('Y-m-d')}) }}"
           class="group relative flex w-full flex-col items-center justify-center overflow-hidden rounded-[1.1rem] p-6 text-center text-white shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl"
           style="background: linear-gradient(135deg, #d97706, #b45309 55%, #78350f);">
            <span class="absolute -right-6 -top-6 h-28 w-28 rounded-full bg-white/10 transition-transform duration-500 group-hover:scale-125"></span>
            <span class="relative text-4xl font-black tabular-nums">{{ synthese.nombreTickets }}</span>
            <span class="relative mt-1 font-semibold">ticket{{ synthese.nombreTickets > 1 ? 's' }} du jour</span>
            <span class="relative mt-3 inline-flex items-center gap-1 text-sm text-amber-100">
                Voir le détail
                <span class="transition-transform duration-300 group-hover:translate-x-1">{{ ui.icone('suivant', 'h-4 w-4') }}</span>
            </span>
        </a>
    </section>
</div>
{% endblock %}
