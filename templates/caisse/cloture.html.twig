{% extends 'caisse/_session_base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% form_theme form 'caisse/_form_theme.html.twig' %}

{% block page_title %}Clôture Z{% endblock %}

{% block entete_actions %}
    <a href="{{ path('app_caisse_ticket_x') }}" class="rounded-lg bg-white border border-gray-300 px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">Ticket X</a>
    <a href="{{ path('app_caisse') }}" class="rounded-lg bg-white border border-gray-300 px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">← Caisse</a>
{% endblock %}

{% block caisse_content %}
<div class="mx-auto max-w-3xl grid gap-5 lg:grid-cols-2">

    {# ---- Récapitulatif de la session (le théorique n'est jamais saisi) ---- #}
    <div class="bg-white text-stone-800 rounded-2xl shadow-xl p-6">
        <h2 class="text-lg font-bold text-stone-900 mb-4">Session en cours</h2>

        <dl class="space-y-2 text-sm">
            <div class="flex justify-between"><dt class="text-stone-500">Ouverte le</dt><dd class="font-medium">{{ rapport.session.ouvertureAt|date('d/m/Y à H:i') }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">Tickets</dt><dd class="font-medium tabular-nums">{{ rapport.nombreTickets }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">CA total</dt><dd class="font-medium tabular-nums">{{ fmt.fcfa(rapport.caTotal) }}</dd></div>
        </dl>

        <div class="mt-4 pt-4 border-t border-stone-200 space-y-2 text-sm">
            <div class="flex justify-between"><span class="text-stone-500">Fond d'ouverture</span><span class="tabular-nums">{{ fmt.fcfa(rapport.fondCaisse) }}</span></div>
            <div class="flex justify-between"><span class="text-stone-500">+ Espèces encaissées</span><span class="tabular-nums">{{ fmt.fcfa(rapport.especesEncaissees) }}</span></div>
            <div class="flex justify-between"><span class="text-stone-500">− Dépenses</span><span class="tabular-nums">{{ fmt.fcfa(rapport.depenses) }}</span></div>
            <div class="flex justify-between"><span class="text-stone-500">− Sorties de caisse</span><span class="tabular-nums">{{ fmt.fcfa(rapport.sorties) }}</span></div>
        </div>

        <div class="mt-4 pt-4 border-t-2 border-stone-300 flex items-end justify-between">
            <span class="font-semibold text-stone-600">Théorique en caisse</span>
            <span class="text-2xl font-black tabular-nums text-stone-900">{{ fmt.fcfa(rapport.theorique) }}</span>
        </div>
    </div>

    {# ---- Saisie du comptage physique ---- #}
    <div class="bg-white text-stone-800 rounded-2xl shadow-xl p-6">
        <h1 class="text-xl font-black text-stone-900">Clôture de la journée</h1>
        <p class="mt-1 mb-5 text-sm text-stone-500">
            Comptez les espèces réellement présentes dans le tiroir. L'écart est calculé
            par le système ; <strong>un commentaire est obligatoire s'il n'est pas nul</strong>.
            Une fois clôturée, la journée n'est plus modifiable.
        </p>

        {# Garde-fou : le Z ne voit que les ventes que le serveur connaît. Tant que
           la file hors ligne de cette tablette n'est pas vide, on ne clôture pas
           (voir garde_cloture_controller.js). #}
        <div data-controller="garde-cloture"
             data-garde-cloture-ventes-a-verifier-value="{{ path('app_caisse_ventes_a_verifier') }}">
            <div data-garde-cloture-target="alerte"></div>

            {{ form_start(form, {attr: {'data-action': 'submit->garde-cloture#verifier'}}) }}
                {% include 'caisse/_pave_montant.html.twig' with {champ: form.montantCompte} only %}
                {{ form_row(form.commentaire) }}

                <label class="hidden mb-4 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
                       data-garde-cloture-target="confirmation">
                    <input type="checkbox" class="mt-1 h-5 w-5 shrink-0"
                           data-garde-cloture-target="case" data-action="change->garde-cloture#basculer">
                    <span>Je clôture en sachant que ces ventes refusées ne sont pas comptées dans la caisse.</span>
                </label>

                <button data-garde-cloture-target="bouton"
                        class="w-full rounded-xl bg-red-600 text-white text-lg font-bold py-4 hover:bg-red-500 disabled:opacity-40 disabled:cursor-not-allowed">
                    Clôturer la caisse (Z)
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
