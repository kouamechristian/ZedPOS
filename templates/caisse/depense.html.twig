{% extends 'caisse/_session_base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% form_theme form 'caisse/_form_theme.html.twig' %}

{% block page_title %}Dépenses de caisse{% endblock %}

{% block entete_actions %}
    <a href="{{ path('app_caisse') }}" class="rounded-lg bg-stone-700 px-3 py-2 font-medium hover:bg-stone-600">← Caisse</a>
{% endblock %}

{% block caisse_content %}
<div class="mx-auto max-w-3xl grid gap-5 lg:grid-cols-2">

    <div class="bg-white text-stone-800 rounded-2xl shadow-xl p-6">
        <h1 class="text-xl font-black text-stone-900">Sortie d'espèces</h1>
        <p class="mt-1 mb-5 text-sm text-stone-500">
            Toute somme sortie du tiroir doit être saisie ici, sinon elle apparaîtra
            comme un manquant à la clôture.
        </p>

        {{ form_start(form) }}
            {{ form_row(form.type) }}
            {{ form_row(form.categorie) }}
            {{ form_row(form.montant) }}
            {{ form_row(form.commentaire) }}

            <button class="w-full rounded-xl bg-stone-900 text-white text-lg font-bold py-4 hover:bg-stone-700">
                Enregistrer
            </button>
        {{ form_end(form) }}
    </div>

    <div class="bg-white text-stone-800 rounded-2xl shadow-xl p-6">
        <h2 class="text-lg font-bold text-stone-900 mb-1">Mouvements de la session</h2>
        <p class="text-sm text-stone-500 mb-4">Ouverte le {{ session.ouvertureAt|date('d/m/Y à H:i') }}</p>

        <ul class="divide-y divide-stone-100">
            {% for mouvement in mouvements %}
                <li class="flex items-start justify-between gap-3 py-3">
                    <div class="min-w-0">
                        <div class="font-semibold text-stone-800">{{ mouvement.libelle }}</div>
                        {% if mouvement.commentaire %}
                            <div class="text-sm text-stone-500">{{ mouvement.commentaire }}</div>
                        {% endif %}
                        <div class="text-xs text-stone-400">{{ mouvement.createdAt|date('H:i') }} — {{ mouvement.utilisateur.nom }}</div>
                    </div>
                    <div class="shrink-0 font-bold tabular-nums text-red-600">− {{ fmt.fcfa(mouvement.montant) }}</div>
                </li>
            {% else %}
                <li class="py-6 text-center text-stone-400">Aucun mouvement pour l'instant.</li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}
