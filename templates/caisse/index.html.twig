{% extends 'base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}

{% block title %}Caisse — ZedPOS{% endblock %}

{% set reglements = [
    { mode: 'ESPECES', label: 'Espèces' },
    { mode: 'WAVE', label: 'Wave' },
    { mode: 'ORANGE_MONEY', label: 'Orange Money' },
    { mode: 'MTN_MOMO', label: 'MTN MoMo' },
    { mode: 'MOOV_MONEY', label: 'Moov Money' },
] %}

{% block body %}
<style>
    /* États actifs : le sélecteur d'attribut l'emporte sur les utilitaires Tailwind. */
    .onglet-famille[data-actif] { background: #0f172a; color: #fff; border-color: #0f172a; }
    .touche-mode[data-actif] { background: #f8fafc; color: #0f172a; }
    .touche-reglement[data-actif] { box-shadow: inset 0 0 0 3px #0f172a; background: #f1f5f9; }
    .touche-produit { text-shadow: 0 1px 2px rgba(0,0,0,.45); }
</style>

<div class="h-screen flex flex-col bg-slate-100 overflow-hidden select-none"
     data-controller="caisse"
     data-caisse-mode-value="BOULANGERIE"
     data-caisse-encaisser-url-value="{{ path('app_caisse_encaisser') }}"
     data-caisse-ticket-base-value="{{ path('app_caisse_ticket', {uuid: '__UUID__'}) }}"
     data-caisse-token-value="{{ csrf_token('caisse') }}">

    {# ---- Barre supérieure : modes + tickets en attente + verrouillage ---- #}
    <header class="flex items-center gap-4 px-4 py-2 bg-slate-900 text-white shrink-0">
        <div class="flex gap-2">
            <button type="button" class="touche-mode rounded-lg px-4 py-2 text-sm font-bold bg-slate-700 text-slate-200"
                    data-action="caisse#changerMode" data-mode="BOULANGERIE" data-caisse-target="modeBtn" data-actif>Boulangerie</button>
            <button type="button" class="touche-mode rounded-lg px-4 py-2 text-sm font-bold bg-slate-700 text-slate-200"
                    data-action="caisse#changerMode" data-mode="FASTFOOD" data-caisse-target="modeBtn">Fast-food</button>
        </div>

        <div class="flex-1 flex items-center gap-2 overflow-x-auto" data-caisse-target="attente"></div>

        <div class="flex items-center gap-3 text-sm">
            <span class="text-slate-300">{{ app.user.nom }}</span>
            <a href="{{ path('app_logout') }}" class="rounded-lg bg-slate-700 px-3 py-2 font-medium hover:bg-slate-600">Verrouiller</a>
        </div>
    </header>

    <div class="flex-1 grid grid-cols-[1fr_380px_260px] min-h-0">

        {# ---- Colonne gauche : familles + grille produits ---- #}
        <section class="flex flex-col min-h-0 border-r border-slate-200">
            <div class="flex flex-wrap gap-1.5 p-2 bg-white border-b border-slate-200">
                {% for entree in catalogue %}
                    <button type="button"
                            class="onglet-famille rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700"
                            data-action="caisse#choisirFamille" data-famille-id="{{ entree.famille.id }}"
                            data-caisse-target="onglet" {{ loop.first ? 'data-actif' }}>
                        {{ entree.famille.nom }}
                    </button>
                {% endfor %}
            </div>

            <div class="flex-1 overflow-y-auto p-2">
                {% for entree in catalogue %}
                    <div data-caisse-target="grille" data-famille-id="{{ entree.famille.id }}"
                         class="gap-2"
                         style="display: {{ loop.first ? 'grid' : 'none' }}; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));">
                        {% for article in entree.articles %}
                            <button type="button"
                                    class="touche-produit flex flex-col justify-between rounded-xl p-2 text-left text-white font-semibold active:scale-95 transition"
                                    style="min-height: 92px; background: {{ article.couleur ?: '#64748b' }};"
                                    data-action="caisse#appuyerProduit"
                                    data-article-id="{{ article.id }}"
                                    data-nom="{{ article.nom }}"
                                    data-prix="{{ article.prixVenteTtc }}"
                                    data-tva="{{ article.tauxTva }}">
                                <span class="text-sm leading-tight">{{ article.nom }}</span>
                                <span class="text-sm font-bold">{{ fmt.fcfa(article.prixVenteTtc) }}</span>
                            </button>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </section>

        {# ---- Colonne centre : ticket ---- #}
        <section class="flex flex-col min-h-0 bg-white border-r border-slate-200">
            <div class="px-4 py-2 border-b border-slate-100 flex items-center justify-between">
                <span class="font-semibold text-slate-700">Ticket en cours</span>
                <button type="button" class="text-xs text-slate-400 hover:text-red-600" data-action="caisse#vider">Vider</button>
            </div>
            <div class="flex-1 overflow-y-auto" data-caisse-target="ticket"></div>
            <div class="p-4 border-t border-slate-200">
                <div class="flex items-end justify-between">
                    <span class="text-slate-500 font-medium">Total</span>
                    <span class="text-5xl font-black tabular-nums text-slate-900" data-caisse-target="total">0 FCFA</span>
                </div>
            </div>
        </section>

        {# ---- Colonne droite : règlement ---- #}
        <section class="flex flex-col min-h-0 bg-white p-3 gap-2">
            <div class="text-sm font-semibold text-slate-500 px-1">Règlement</div>
            <div class="grid gap-2">
                {% for reglement in reglements %}
                    <button type="button"
                            class="touche-reglement rounded-xl border border-slate-300 bg-white px-3 py-3 text-left font-semibold text-slate-800 hover:bg-slate-50"
                            style="min-height: 56px;"
                            data-action="caisse#choisirReglement" data-mode="{{ reglement.mode }}" data-caisse-target="reglement">
                        {{ reglement.label }}
                    </button>
                {% endfor %}
            </div>

            <div class="mt-auto grid gap-2">
                <label class="flex items-center gap-2 text-sm text-slate-600 px-1 select-none">
                    <input type="checkbox" data-caisse-target="imprimer" checked class="h-4 w-4 rounded border-slate-300">
                    Imprimer le ticket
                </label>
                <button type="button"
                        class="rounded-xl bg-green-600 text-white text-lg font-bold py-4 hover:bg-green-500 disabled:opacity-40"
                        data-action="caisse#encaisser" data-caisse-target="encaisser">Encaisser</button>
                <button type="button"
                        class="rounded-xl border border-slate-300 text-slate-700 font-semibold py-3 hover:bg-slate-50"
                        data-action="caisse#mettreEnAttente">Mise en attente</button>
            </div>
        </section>
    </div>

    {# ---- Panneau variantes / commentaire (mode fast-food) ---- #}
    <div data-caisse-target="panneau" class="hidden fixed inset-0 z-20 bg-black/50 flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-bold text-slate-900" data-caisse-target="panneauNom">Article</h2>
                <button type="button" class="text-slate-400 hover:text-slate-700 text-2xl leading-none" data-action="caisse#fermerPanneau">&times;</button>
            </div>

            <div class="flex items-center justify-center gap-4 mb-4">
                <button type="button" class="h-14 w-14 rounded-full bg-slate-200 text-2xl font-bold hover:bg-slate-300" data-action="caisse#panneauMoins">−</button>
                <span class="w-12 text-center text-3xl font-black tabular-nums" data-caisse-target="panneauQte">1</span>
                <button type="button" class="h-14 w-14 rounded-full bg-slate-200 text-2xl font-bold hover:bg-slate-300" data-action="caisse#panneauPlus">+</button>
            </div>

            <div class="flex flex-wrap gap-2 mb-3">
                {% for chip in ['Sur place', 'À emporter', 'Bien cuit', 'Sans oignon', 'Piment', 'Sans sauce'] %}
                    <button type="button" class="rounded-full border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100"
                            data-action="caisse#ajouterChip" data-texte="{{ chip }}">{{ chip }}</button>
                {% endfor %}
            </div>

            <textarea data-caisse-target="panneauCommentaire" rows="2" placeholder="Commentaire libre…"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-400"></textarea>

            <div class="mt-4 flex gap-2">
                <button type="button" class="flex-1 rounded-xl bg-slate-800 text-white font-bold py-3 hover:bg-slate-700" data-action="caisse#confirmerPanneau">Ajouter au ticket</button>
                <button type="button" class="rounded-xl border border-slate-300 px-4 py-3 font-semibold hover:bg-slate-50" data-action="caisse#fermerPanneau">Annuler</button>
            </div>
        </div>
    </div>

    {# ---- Bandeau de confirmation d'encaissement ---- #}
    <div data-caisse-target="confirmation" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-30 rounded-xl bg-slate-900 text-white px-6 py-3 shadow-lg font-semibold"></div>

    {# ---- Iframe caché : impression automatique du ticket après encaissement ---- #}
    <iframe data-caisse-target="impression" title="Impression du ticket" class="hidden" aria-hidden="true"></iframe>
</div>
{% endblock %}
