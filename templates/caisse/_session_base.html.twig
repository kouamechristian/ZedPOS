{# Cadre commun aux écrans du cycle de caisse (ouverture, dépense, clôture). #}
{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}Caisse{% endblock %} — ZedPOS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-stone-900 to-amber-950 text-stone-100 flex flex-col select-none">
    <header class="flex items-center justify-between px-5 py-3 border-b border-stone-800 shrink-0">
        <div>
            <span class="text-lg font-bold">ZedPOS</span>
            <span class="ml-2 text-sm text-stone-400">{% block entete %}{{ block('page_title') }}{% endblock %}</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
            <span class="text-stone-300">{{ app.user.nom }}</span>
            {% block entete_actions %}{% endblock %}
        </div>
    </header>

    <main class="flex-1 overflow-y-auto p-5">
        {% for type, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="mx-auto mb-4 max-w-3xl rounded-xl px-4 py-3 text-sm font-medium {{ type == 'success' ? 'bg-green-500/15 border border-green-400/40 text-green-200' : 'bg-red-500/15 border border-red-400/40 text-red-200' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block caisse_content %}{% endblock %}
    </main>
</div>
{% endblock %}
