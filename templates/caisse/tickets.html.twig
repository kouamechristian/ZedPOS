{% extends 'caisse/_session_base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}

{% block page_title %}Mes tickets{% endblock %}

{% block entete_actions %}
    <a href="{{ path('app_caisse') }}" class="rounded-lg bg-white border border-gray-300 px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">← Caisse</a>
{% endblock %}

{% block caisse_content %}
{# Composants `carte` / `badge` / pagination de l'espace de gestion — même
   disposition que /pilotage/ventes, pour que la caissière retrouve le même
   repère visuel qu'un ticket vu depuis le pilotage. #}
<div class="espace-gestion -m-5 p-5">

<div class="mb-5">
    <div class="sur-titre">Mes tickets</div>
    <h1 class="text-2xl font-bold tracking-tight text-stone-900">
        Depuis l'ouverture — {{ session.ouvertureAt|date('d/m/Y à H:i') }}
    </h1>
</div>

<div class="mb-3 flex items-baseline justify-between text-sm text-stone-500">
    <span><strong class="font-semibold text-stone-800">{{ tickets.total }}</strong> ticket{{ tickets.total > 1 ? 's' }}</span>
    <span class="tabular-nums">Page {{ tickets.page }} / {{ tickets.pages }}</span>
</div>

{# Cartes plutôt qu'un tableau, comme sur /pilotage/ventes : lisible sur un
   écran étroit, et c'est un écran de caisse — tablette ou téléphone au comptoir. #}
<ul class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
    {% for vente in tickets.items %}
        <li class="apparition" style="--i: {{ min(loop.index0, 12) }}">
            <a href="{{ path('app_caisse_ticket', {uuid: vente.uuid}) }}"
               class="carte carte-interactive group relative block h-full overflow-hidden p-4 pl-5">
                <span class="absolute inset-y-0 left-0 w-1 {{ vente.estValidee ? 'bg-gradient-to-b from-amber-400 to-amber-600' : 'bg-red-400' }}"></span>
                <div class="flex items-baseline justify-between gap-3">
                    <span class="code text-stone-500">{{ vente.numero }}</span>
                    <span class="text-lg font-black tabular-nums {{ vente.estValidee ? 'text-stone-900' : 'text-stone-400 line-through' }}">
                        {{ fmt.fcfa(vente.totalTtc) }}
                    </span>
                </div>
                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-stone-500">
                    <span class="inline-flex items-center gap-1 tabular-nums">{{ ui.icone('horloge', 'h-3.5 w-3.5') }} {{ vente.createdAt|date('H:i') }}</span>
                    {% if not vente.estValidee %}
                        <span class="badge badge-rouge badge-point">Annulée</span>
                    {% endif %}
                    {% if vente.remise > 0 %}
                        <span class="badge badge-ambre">Remise {{ fmt.fcfa(vente.remise) }}</span>
                    {% endif %}
                </div>
                {# Détail du ticket plutôt que le mode de vente : c'est ce qu'on
                   cherche en priorité sur cet écran — voir les articles vendus. #}
                <p class="mt-1.5 truncate pr-5 text-sm text-stone-600">{{ fmt.articlesVente(vente) }}</p>
                <span class="absolute bottom-3 right-3 text-stone-300 opacity-0 transition duration-300 group-hover:translate-x-0.5 group-hover:opacity-100">{{ ui.icone('chevron', 'h-4 w-4') }}</span>
            </a>
        </li>
    {% else %}
        <li class="carte p-10 text-center text-stone-400 md:col-span-2 xl:col-span-3">Aucun ticket pour l'instant.</li>
    {% endfor %}
</ul>

{{ pagination.barre(tickets, 'app_caisse_tickets') }}

</div>
{% endblock %}
