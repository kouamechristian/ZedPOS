{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Stands{% endblock %}
{% block page_sous_titre %}Les points de vente détachés, approvisionnés depuis le dépôt.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_vendeur_index') }}" class="btn btn-secondaire">{{ ui.icone('utilisateur') }} Vendeurs</a>
    <a href="{{ path('admin_stand_new') }}" class="btn btn-primaire">{{ ui.icone('plus') }} Nouveau stand</a>
{% endblock %}

{% block admin_content %}
{{ recherche.barre('admin_stand_index', 'Code, nom ou vendeur') }}
<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Stand</th>
                <th>Code</th>
                <th>Vendeur habituel</th>
                <th>Point</th>
                <th>Statut</th>
                <th class="num">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for stand in stands.items %}
                <tr>
                    <td class="cellule-principale">{{ stand.libelle }}</td>
                    <td><span class="code rounded-md bg-stone-100 px-1.5 py-0.5 text-stone-700">{{ stand.code }}</span></td>
                    <td>{{ stand.vendeurHabituel ? stand.vendeurHabituel.nom : '—' }}</td>
                    <td class="cellule-douce">{{ stand.periodicitePoint.libelle }}</td>
                    <td>{{ fmt.badge(stand.actif) }}</td>
                    <td>
                        <div class="actions-ligne">
                            {% if stand.actif %}
                                <a href="{{ path('admin_dotation_new', {stand: stand.id}) }}" class="btn btn-sm btn-secondaire">{{ ui.icone('plus') }} Doter</a>
                            {% endif %}
                            <a href="{{ path('admin_stand_edit', {id: stand.id}) }}" class="btn btn-sm btn-fantome">{{ ui.icone('modifier') }} Modifier</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="cellule-vide">Aucun stand.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{{ pagination.barre(stands, 'admin_stand_index') }}
{% endblock %}
