{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}{{ titre }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_stand_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Stands</a>
{% endblock %}

{% block admin_content %}
<div class="carte apparition max-w-xl">
    {{ form_start(form) }}
    <div class="carte-corps">
        {% if form.code is defined %}
            {{ form_row(form.code) }}
        {% endif %}
        {{ form_row(form.libelle) }}
        {{ form_row(form.vendeurHabituel) }}
        {{ form_row(form.periodicitePoint) }}

        {# Rémunération : un prix, fixé par la dirigeante seule. La gérante la voit. #}
        {% if form.modeRemuneration is defined %}
            {{ form_row(form.modeRemuneration) }}
            {{ form_row(form.tauxCommission) }}
        {% else %}
            <div class="ligne-champ">
                <span class="etiquette">Rémunération du vendeur</span>
                <p class="rounded-xl border border-dashed border-stone-300 bg-stone-50 px-3 py-2 text-sm text-stone-600">
                    {% if stand is defined %}
                        {{ stand.modeRemuneration.libelle }}{% if stand.modeRemuneration.value == 'COMMISSION' %} — {{ (stand.tauxCommission / 100)|number_format(stand.tauxCommission % 100 ? 2 : 0, ',', ' ') }} %{% endif %}
                    {% else %}
                        Commission à 0 %, jusqu'à ce que la dirigeante la fixe.
                    {% endif %}
                    <span class="mt-0.5 block text-xs text-stone-500">Seule la dirigeante peut fixer la rémunération.</span>
                </p>
            </div>
        {% endif %}

        {{ form_row(form.seuilEcartAlerte) }}
        {{ form_row(form.actif) }}
    </div>
    <div class="carte-pied">
        <button class="btn btn-primaire">{{ ui.icone('valide') }} Enregistrer</button>
        <a href="{{ path('admin_stand_index') }}" class="btn btn-fantome">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
