{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block page_title %}Paramètres de l'établissement{% endblock %}

{% block admin_content %}
<div class="max-w-2xl">
    <p class="mb-5 text-sm text-stone-500">
        Ces informations sont imprimées en tête et en pied de <strong>chaque ticket de
        caisse</strong> et de chaque rapport de clôture. Vérifiez-les avant la mise en
        service.
    </p>

    {# `form_start` pose de lui-même enctype="multipart/form-data" : le formulaire
       porte un champ fichier depuis le logo. #}
    {{ form_start(form) }}

    {# Le logo a sa propre section : sa valeur persistée est un nom de fichier, pas
       une saisie — il lui faut un aperçu et une case de retrait, là où les autres
       paramètres se contentent d'un champ engendré depuis le catalogue. #}
    <section class="mb-5 bg-white rounded-xl shadow-sm p-6">
        <h2 class="titre text-lg font-bold text-stone-900 mb-4">Logo</h2>
        <div class="flex flex-col sm:flex-row sm:items-start gap-5">
            {# Damier discret : un logo à fond transparent doit se voir tel qu'il
               sortira sur le papier, pas fondu dans le blanc de la carte. #}
            <div class="grid h-24 w-24 shrink-0 place-items-center rounded-lg border border-stone-200 bg-stone-50 overflow-hidden">
                {% if logo %}
                    <img src="{{ logo }}" alt="Logo de l'établissement" class="max-h-24 max-w-full object-contain">
                {% else %}
                    <span class="text-[11px] text-stone-400 text-center px-2">Aucun logo</span>
                {% endif %}
            </div>
            <div class="flex-1 min-w-0">
                {{ form_row(attribute(form, 'logo_fichier')) }}
                {% if logo %}
                    {{ form_row(attribute(form, 'logo_retirer')) }}
                {% else %}
                    {# Rien à retirer : la case n'a pas de sens ici. Marquée rendue,
                       sinon `form_end` la ferait réapparaître seule en bas de page
                       avec le reste du formulaire non affiché. #}
                    {% do attribute(form, 'logo_retirer').setRendered %}
                {% endif %}
            </div>
        </div>
    </section>

    {# Les groupes viennent du catalogue CleParametre : rien n'est codé en dur ici. #}
    {% for titre, champs in groupes %}
        <section class="mb-5 bg-white rounded-xl shadow-sm p-6">
            <h2 class="titre text-lg font-bold text-stone-900 mb-4">{{ titre }}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5">
                {% for champ in champs %}
                    <div class="{{ attribute(form, champ).vars.attr.rows is defined ? 'sm:col-span-2' : '' }}">
                        {{ form_row(attribute(form, champ)) }}
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endfor %}

    <div class="flex items-center gap-3">
        <button class="rounded-lg bg-stone-800 text-white px-5 py-2.5 text-sm font-semibold hover:bg-stone-700">
            Enregistrer
        </button>
        <span class="text-xs text-stone-400">Les tickets déjà imprimés ne changent pas.</span>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
