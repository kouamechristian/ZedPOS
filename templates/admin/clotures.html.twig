{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Clôtures de caisse{% endblock %}
{% block page_sous_titre %}Sessions de caisse, fond théorique, montant compté et écart constaté au Z.{% endblock %}

{% block admin_content %}

{{ recherche.barre('admin_clotures', 'Nom de la caissière') }}
<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Caissier</th>
                <th>Ouverture</th>
                <th>Clôture</th>
                <th class="num">Fond de caisse</th>
                <th class="num">Théorique</th>
                <th class="num">Compté</th>
                <th class="num">Écart</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for session in sessions.items %}
                <tr>
                    <td class="cellule-principale">{{ session.utilisateur.nom }}</td>
                    <td class="cellule-douce whitespace-nowrap tabular-nums">{{ session.ouvertureAt|date('d/m/Y H:i') }}</td>
                    <td class="cellule-douce whitespace-nowrap tabular-nums">{{ session.clotureAt ? session.clotureAt|date('d/m/Y H:i') : '—' }}</td>
                    <td class="num">{{ fmt.fcfa(session.fondCaisse) }}</td>
                    <td class="num cellule-douce">{{ session.theorique is not null ? fmt.fcfa(session.theorique) : '—' }}</td>
                    <td class="num cellule-douce">{{ session.montantCompte is not null ? fmt.fcfa(session.montantCompte) : '—' }}</td>
                    <td class="num">
                        {% if session.ecart is null %}
                            <span class="text-stone-300">—</span>
                        {% elseif session.ecart == 0 %}
                            <span class="badge badge-vert">0 FCFA</span>
                        {% else %}
                            <span class="badge {{ session.ecart > 0 ? 'badge-ambre' : 'badge-rouge' }}"
                                  title="{{ session.commentaireCloture }}">
                                {{ session.ecart > 0 ? '+' }}{{ fmt.fcfa(session.ecart) }}
                            </span>
                        {% endif %}
                    </td>
                    <td>
                        {% if session.estOuverte %}
                            <span class="badge badge-bleu badge-point">Ouverte</span>
                        {% else %}
                            <span class="badge badge-neutre">Clôturée</span>
                        {% endif %}
                    </td>
                    <td class="num">
                        <a href="{{ path('admin_cloture', {id: session.id}) }}" class="btn btn-sm btn-secondaire">
                            Rapport {{ ui.icone('chevron', 'h-3.5 w-3.5') }}
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="9" class="cellule-vide">Aucune session de caisse.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{{ pagination.barre(sessions, 'admin_clotures') }}
{% endblock %}
