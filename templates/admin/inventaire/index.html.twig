{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Inventaires{% endblock %}
{% block page_sous_titre %}Le seul chemin par lequel un stock se corrige : compter, constater l'écart, valider.{% endblock %}

{% block page_actions %}
    {# Une seule feuille ouverte à la fois : deux figeraient le même théorique et
       la seconde validation écraserait les écarts de la première. Le bouton mène
       donc à la feuille en cours plutôt que d'en ouvrir une seconde. #}
    {% if en_cours %}
        <a href="{{ path('admin_inventaire_show', {id: en_cours.id}) }}" class="btn btn-primaire">
            {{ ui.icone('inventaire') }} Reprendre le comptage
        </a>
    {% else %}
        <form method="post" action="{{ path('admin_inventaire_new') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('inventaire_nouveau') }}">
            <button class="btn btn-primaire">{{ ui.icone('plus') }} Nouvel inventaire</button>
        </form>
    {% endif %}
{% endblock %}

{% block admin_content %}

{% if en_cours %}
    <div class="alerte alerte-ambre apparition mb-5">
        {{ ui.icone('horloge') }}
        <div class="flex-1">
            Inventaire n° {{ en_cours.id }} <strong>en cours de comptage</strong>, ouvert le {{ en_cours.createdAt|date('d/m/Y à H:i') }}.
        </div>
    </div>
{% endif %}

{{ recherche.barre('admin_inventaires', 'Auteur ou commentaire') }}

<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>N°</th>
                <th>Ouvert le</th>
                <th>Par</th>
                <th>Validé le</th>
                <th class="num">Écart valorisé</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for inventaire in inventaires.items %}
                <tr>
                    <td class="cellule-principale tabular-nums">#{{ inventaire.id }}</td>
                    <td class="cellule-douce whitespace-nowrap tabular-nums">{{ inventaire.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="text-stone-700">{{ inventaire.auteur.nom }}</td>
                    <td class="cellule-douce whitespace-nowrap tabular-nums">
                        {{ inventaire.valideAt ? inventaire.valideAt|date('d/m/Y H:i') : '—' }}
                    </td>
                    <td class="num">
                        {% if inventaire.statut.value != 'VALIDE' %}
                            <span class="text-stone-300">—</span>
                        {% else %}
                            {% set ecart = inventaire.ecartValorise %}
                            {# Un manquant est une perte sèche : rouge. Un excédent
                               signale plutôt une erreur de saisie antérieure. #}
                            <span class="badge {{ ecart == 0 ? 'badge-vert' : (ecart > 0 ? 'badge-ambre' : 'badge-rouge') }}">
                                {{ ecart > 0 ? '+' }}{{ fmt.fcfa(ecart) }}
                            </span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge badge-point {{ inventaire.estEnCours ? 'badge-ambre' : 'badge-vert' }}">
                            {{ inventaire.statut.libelle }}
                        </span>
                    </td>
                    <td class="num">
                        <a href="{{ path('admin_inventaire_show', {id: inventaire.id}) }}" class="btn btn-sm {{ inventaire.estEnCours ? 'btn-primaire' : 'btn-secondaire' }}">
                            {{ inventaire.estEnCours ? 'Compter' : 'Consulter' }}
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="cellule-vide">Aucun inventaire.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>

{{ pagination.barre(inventaires, 'admin_inventaires') }}

<p class="aide mt-4">
    Valider une feuille reporte chaque écart en mouvement de stock et le trace au
    journal d'audit. C'est le seul chemin par lequel un stock se corrige.
</p>
{% endblock %}
