{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}Inventaire n° {{ inventaire.id }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_inventaires') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Inventaires</a>
    {# `data-turbo="false"` : la feuille imprimable s'ouvre dans un nouvel onglet,
       Turbo n'a pas à intercepter ce clic. #}
    <a href="{{ path('admin_inventaire_feuille', {id: inventaire.id}) }}" target="_blank" data-turbo="false"
       class="btn btn-secondaire">
        {{ ui.icone('imprimer') }} Imprimer la feuille
    </a>
{% endblock %}

{% block admin_content %}

{% if erreur is defined %}
    <div class="alerte alerte-rouge apparition mb-5" role="alert">{{ ui.icone('erreur') }}<p>{{ erreur }}</p></div>
{% endif %}

{% set comptees = inventaire.lignesComptees|length %}
{% set totalLignes = inventaire.lignes|length %}
<div class="carte apparition mb-5 flex flex-wrap items-center gap-x-6 gap-y-3 p-4 text-sm">
    <span class="badge badge-point {{ inventaire.estEnCours ? 'badge-ambre' : 'badge-vert' }}">
        {{ inventaire.statut.libelle }}
    </span>
    <span class="text-stone-600">Ouvert le {{ inventaire.createdAt|date('d/m/Y à H:i') }} par {{ inventaire.auteur.nom }}</span>
    {% if inventaire.valideAt %}
        <span class="text-stone-600">
            Validé le {{ inventaire.valideAt|date('d/m/Y à H:i') }}
            {{ inventaire.validePar ? 'par ' ~ inventaire.validePar.nom }}
        </span>
    {% endif %}
    <div class="flex min-w-56 flex-1 items-center gap-3 sm:ml-auto sm:flex-none">
        <div class="jauge"><span style="width: {{ totalLignes > 0 ? comptees * 100 // totalLignes : 0 }}%"></span></div>
        <span class="whitespace-nowrap text-stone-500">{{ comptees }} / {{ totalLignes }} ligne(s) comptée(s)</span>
    </div>
</div>

{% if inventaire.commentaire %}
    <div class="alerte alerte-ambre mb-5">{{ ui.icone('info') }}<p>{{ inventaire.commentaire }}</p></div>
{% endif %}

<form method="post" action="{{ path(inventaire.estEnCours ? 'admin_inventaire_saisir' : 'admin_inventaire_show', {id: inventaire.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('inventaire_' ~ inventaire.id) }}">

    <div class="tableau-conteneur apparition" style="--i: 1">
        <div class="defilement-x">
        <table class="tableau">
            <thead>
                <tr>
                    <th>Produit / matière</th>
                    <th>Unité</th>
                    <th class="num">Théorique</th>
                    <th class="num">Compté</th>
                    <th class="num">Écart</th>
                    <th class="num">Valorisé</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in inventaire.lignes %}
                    <tr>
                        <td class="cellule-principale">
                            {{ ligne.libelle }}
                            {% if ligne.article %}
                                <span class="badge badge-neutre ml-1">article</span>
                            {% endif %}
                        </td>
                        <td class="cellule-douce">{{ ligne.unite }}</td>
                        <td class="num cellule-douce">{{ fmt.unites(ligne.quantiteTheorique) }}</td>
                        <td class="num">
                            {% if inventaire.estEnCours %}
                                {# Case vide = « pas comptée », et non zéro : c'est
                                   toute la différence entre une ligne qu'on n'a pas
                                   eu le temps de relever et un produit épuisé. #}
                                <input type="text" inputmode="decimal" autocomplete="off"
                                       name="comptee[{{ ligne.id }}]"
                                       value="{{ ligne.estComptee ? fmt.unites(ligne.quantiteComptee)|trim : '' }}"
                                       class="champ ml-auto h-9 w-28 text-right tabular-nums"
                                       aria-label="Quantité comptée — {{ ligne.libelle }}">
                            {% else %}
                                <span class="tabular-nums">{{ ligne.estComptee ? fmt.unites(ligne.quantiteComptee) : '—' }}</span>
                            {% endif %}
                        </td>
                        <td class="num font-semibold">
                            {% if not ligne.estComptee %}
                                <span class="text-stone-300">—</span>
                            {% elseif ligne.ecart == 0 %}
                                <span class="text-green-600">0</span>
                            {% else %}
                                <span class="{{ ligne.ecart > 0 ? 'text-amber-600' : 'text-red-600' }}">
                                    {{ ligne.ecart > 0 ? '+' }}{{ fmt.unites(ligne.ecart) }}
                                </span>
                            {% endif %}
                        </td>
                        <td class="num cellule-douce">
                            {{ ligne.estComptee and ligne.ecart != 0 ? fmt.fcfa(ligne.ecartValorise) : '—' }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            {% if not inventaire.estEnCours %}
                <tfoot>
                    <tr>
                        <td colspan="5">Écart total valorisé</td>
                        <td class="num">
                            {% set total = inventaire.ecartValorise %}
                            <span class="{{ total == 0 ? 'text-green-600' : (total > 0 ? 'text-amber-600' : 'text-red-600') }}">
                                {{ total > 0 ? '+' }}{{ fmt.fcfa(total) }}
                            </span>
                        </td>
                    </tr>
                </tfoot>
            {% endif %}
        </table>
        </div>
    </div>

    {% if inventaire.estEnCours %}
        <div class="carte apparition mt-5" style="--i: 2">
            <div class="carte-corps">
                <label for="commentaire" class="etiquette">
                    Commentaire
                    <span class="font-normal text-stone-500">— obligatoire dès qu'un écart est constaté</span>
                </label>
                <textarea id="commentaire" name="commentaire" rows="2"
                          placeholder="Ce qui explique l'écart : casse non déclarée, erreur de réception, coupure de courant…"
                          class="champ"></textarea>
            </div>

            <div class="carte-pied">
                <button class="btn btn-secondaire">
                    Enregistrer le comptage
                </button>
                {# Vert : c'est l'action qui engage, comme l'encaissement en caisse.
                   Elle écrit dans le stock et ne se défait pas. #}
                <button formaction="{{ path('admin_inventaire_valider', {id: inventaire.id}) }}" class="btn btn-succes">
                    {{ ui.icone('valide') }} Valider l'inventaire
                </button>
                <span class="text-xs text-stone-500">
                    La validation reporte les écarts au stock et ne peut pas être annulée.
                </span>
            </div>
        </div>
    {% endif %}
</form>

{% if inventaire.estEnCours %}
    <form method="post" action="{{ path('admin_inventaire_abandonner', {id: inventaire.id}) }}" class="mt-4">
        <input type="hidden" name="_token" value="{{ csrf_token('inventaire_' ~ inventaire.id) }}">
        <button class="btn btn-sm btn-fantome text-stone-500 hover:text-red-700">
            {{ ui.icone('supprimer') }} Abandonner cette feuille (aucun stock ne sera modifié)
        </button>
    </form>
{% endif %}
{% endblock %}
