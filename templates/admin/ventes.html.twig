{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Ventes récentes{% endblock %}

{% block admin_content %}
<turbo-frame id="liste-ventes" data-turbo-action="advance">

{{ recherche.barre('admin_ventes', 'N° de ticket ou caissière') }}
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="text-left text-stone-500 bg-stone-50">
            <tr>
                <th class="px-5 py-3 font-medium">N°</th>
                <th class="px-5 py-3 font-medium">Date</th>
                <th class="px-5 py-3 font-medium">Mode</th>
                <th class="px-5 py-3 font-medium">Caissier</th>
                <th class="px-5 py-3 font-medium text-right">Total TTC</th>
                <th class="px-5 py-3 font-medium">Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for vente in ventes.items %}
                <tr class="border-t border-stone-100 hover:bg-stone-50">
                    <td class="px-5 py-2.5 font-mono text-xs text-stone-600">{{ vente.numero }}</td>
                    <td class="px-5 py-2.5 text-stone-600">{{ vente.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="px-5 py-2.5">
                        <span class="inline-flex rounded-full px-2 py-0.5 text-xs {{ vente.mode.value == 'BOULANGERIE' ? 'bg-amber-100 text-amber-800' : 'bg-orange-100 text-orange-800' }}">
                            {{ vente.mode.value == 'BOULANGERIE' ? 'Boulangerie' : 'Fast-food' }}
                        </span>
                    </td>
                    <td class="px-5 py-2.5 text-stone-600">{{ vente.sessionCaisse.utilisateur.nom }}</td>
                    <td class="px-5 py-2.5 text-right font-medium">{{ fmt.fcfa(vente.totalTtc) }}</td>
                    <td class="px-5 py-2.5">
                        {% if vente.statut.value == 'VALIDEE' %}
                            <span class="inline-flex rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-800">Validée</span>
                        {% else %}
                            <span class="inline-flex rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-800">Annulée</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="px-5 py-6 text-center text-stone-400">Aucune vente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{# Les liens de page restent dans le frame : seul le tableau se rafraîchit. #}
{{ pagination.barre(ventes, 'admin_ventes') }}
</turbo-frame>
{% endblock %}
