{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}Point {{ arrete.numero }}{% endblock %}
{% block page_sous_titre %}{{ arrete.stand.libelle }} · {{ arrete.vendeur.nom }} · du {{ arrete.dateDebut|date('d/m/Y') }} au {{ arrete.dateFin|date('d/m/Y') }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_point_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Points</a>
    <a href="{{ path('admin_point_fiche', {id: arrete.id}) }}" class="btn btn-secondaire" target="_blank" data-turbo="false">{{ ui.icone('imprimer') }} Imprimer la fiche</a>
    {% if arrete.estBrouillon %}
        <a href="{{ path('admin_point_stand', {id: arrete.stand.id}) }}" class="btn btn-primaire">{{ ui.icone('modifier') }} Reprendre la saisie</a>
    {% endif %}
{% endblock %}

{% block admin_content %}
<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="tableau-conteneur apparition">
        <div class="defilement-x">
        <table class="tableau">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th class="num">Confié</th>
                    <th class="num">Invendus</th>
                    <th class="num">Pertes</th>
                    <th class="num">Vendu</th>
                    <th class="num">Montant</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in resultat ? resultat.lignes : [] %}
                    <tr>
                        <td class="cellule-principale">{{ ligne.produit }}</td>
                        <td class="num tabular-nums">{{ fmt.unites(ligne.qteConfiee) }}</td>
                        <td class="num tabular-nums">{{ fmt.unites(ligne.qteRetournee) }}</td>
                        <td class="num tabular-nums">{{ fmt.unites(ligne.qtePerdue) }}</td>
                        <td class="num font-semibold tabular-nums">{{ fmt.unites(ligne.qteVendue) }}</td>
                        <td class="num tabular-nums">{{ fmt.fcfa(ligne.montantAttendu) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="cellule-vide">{{ arrete.estAnnule ? 'Point annulé : ses dotations sont de nouveau à arrêter.' : 'Aucun produit.' }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </div>

    <aside class="flex flex-col gap-4">
        <div class="carte apparition" style="--i: 1">
            <div class="carte-corps space-y-2 text-sm">
                <div class="flex items-center justify-between"><span class="text-stone-500">Statut</span>{{ include('admin/point/_statut.html.twig', {arrete: arrete}) }}</div>
                <div class="flex justify-between"><span class="text-stone-500">Montant attendu</span><strong class="tabular-nums">{{ fmt.fcfa(arrete.montantAttendu) }}</strong></div>
                <div class="flex justify-between">
                    <span class="text-stone-500">Rémunération{% if arrete.modeRemuneration.value == 'COMMISSION' %} ({{ (arrete.tauxCommission / 100)|number_format(arrete.tauxCommission % 100 ? 2 : 0, ',', ' ') }} %){% else %} (marge){% endif %}</span>
                    <strong class="tabular-nums">{{ fmt.fcfa(arrete.remunerationVendeur) }}</strong>
                </div>
                <div class="flex justify-between"><span class="text-stone-500">Net à remettre</span><strong class="text-lg tabular-nums">{{ fmt.fcfa(arrete.netARemettre) }}</strong></div>
                <div class="flex justify-between"><span class="text-stone-500">Espèces remises</span><strong class="tabular-nums">{{ arrete.montantRemis is null ? '—' : fmt.fcfa(arrete.montantRemis) }}</strong></div>
                {% if arrete.ecart is not null %}
                    <div class="flex justify-between rounded-lg px-2 py-1 {{ arrete.ecart == 0 ? 'bg-green-50 text-green-800' : (arrete.ecart < 0 ? 'bg-red-50 text-red-800' : 'bg-orange-50 text-orange-800') }}">
                        <span>Écart</span><strong class="tabular-nums">{{ fmt.fcfa(arrete.ecart) }}</strong>
                    </div>
                {% endif %}
                {% if arrete.traitementEcart and arrete.ecart is not null and arrete.ecart < 0 %}
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-stone-500">Manquant</span>
                        <span class="badge {{ arrete.traitementEcart.value == 'DETTE' ? 'badge-ambre' : 'badge-neutre' }}">{{ arrete.traitementEcart.libelle }}</span>
                    </div>
                {% endif %}
                {% if dette %}
                    <p class="rounded-lg bg-amber-50 px-3 py-2 text-amber-900">
                        Dette de {{ fmt.fcfa(dette.montant) }} — {{ dette.statut.libelle|lower }}{% if dette.estDue %}, reste {{ fmt.fcfa(dette.reste) }}{% endif %}.
                        <a href="{{ path('admin_vendeur_show', {id: dette.vendeur.id}) }}" class="lien font-medium">Fiche de {{ dette.vendeur.nom }}</a>
                    </p>
                {% endif %}
                {% if arrete.commentaireEcart %}<p class="rounded-lg bg-stone-50 px-3 py-2 text-stone-700">{{ arrete.commentaireEcart }}</p>{% endif %}
                {% if arrete.dateValidation %}<div class="flex justify-between"><span class="text-stone-500">Validé le</span><span>{{ arrete.dateValidation|date('d/m/Y H:i') }}</span></div>{% endif %}
                {% if arrete.annuleAt %}<div class="flex justify-between"><span class="text-stone-500">Annulé le</span><span>{{ arrete.annuleAt|date('d/m/Y H:i') }}</span></div>{% endif %}
                {% if arrete.motifAnnulation %}<p class="rounded-lg bg-red-50 px-3 py-2 text-red-800">{{ arrete.motifAnnulation }}</p>{% endif %}
            </div>
        </div>

        {% if annulable %}
            {# Défaire un point rouvre ce qu'un vendeur a déjà payé : motif obligatoire,
               trace au journal d'audit, et seulement le dernier point du stand. #}
            <form method="post" action="{{ path('admin_point_annuler', {id: arrete.id}) }}" class="carte apparition" style="--i: 2">
                <div class="carte-corps space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('point_' ~ arrete.id) }}">
                    <label class="block">
                        <span class="etiquette">Motif d'annulation (obligatoire)</span>
                        <input type="text" name="motif" class="champ" maxlength="255" required placeholder="Erreur de saisie des invendus…">
                    </label>
                    <p class="aide">Les mouvements de stock sont inversés, les dotations redeviennent à arrêter.{% if dette and dette.estDue %} La dette ouverte sur le manquant est annulée — impossible si le vendeur a commencé à la rembourser.{% endif %}</p>
                    <button class="btn btn-danger w-full">{{ ui.icone('supprimer') }} Annuler ce point</button>
                </div>
            </form>
        {% elseif arrete.estValide %}
            <div class="alerte alerte-bleu">{{ ui.icone('info') }}<p>Seul le dernier point validé du stand peut être annulé.</p></div>
        {% endif %}
    </aside>
</div>
{% endblock %}
