{% extends 'admin/base.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}Faire le point{% endblock %}
{% block page_sous_titre %}Choisissez le stand : la période à arrêter s'affiche aussitôt.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_point_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Points</a>
{% endblock %}

{% block admin_content %}
{% if stands is empty %}
    <div class="carte apparition p-8 text-center">
        <p class="text-stone-600">Aucun stand actif.</p>
    </div>
{% else %}
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {% for s in stands %}
            <a href="{{ path('admin_point_stand', {id: s.stand.id}) }}"
               class="carte carte-interactive apparition flex min-h-32 flex-col justify-between p-5" style="--i: {{ loop.index0 }}">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <div class="text-lg font-bold text-stone-900">{{ s.stand.libelle }}</div>
                        <div class="text-xs font-medium uppercase tracking-wide text-stone-500">{{ s.stand.code }}</div>
                    </div>
                    {% if s.brouillon %}<span class="badge badge-ambre">Point en cours</span>{% endif %}
                </div>
                <div class="mt-3 text-sm">
                    {% if s.debut is null %}
                        <span class="text-stone-500">Aucune dotation : rien à arrêter.</span>
                    {% elseif s.debut > aujourdhui %}
                        <span class="text-green-700">Arrêté jusqu'au {{ s.dernier.dateFin|date('d/m/Y') }}.</span>
                    {% else %}
                        <span class="font-semibold text-amber-800">À arrêter depuis le {{ s.debut|date('d/m/Y') }}</span>
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
