{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Production — Fiches techniques{% endblock %}
{% block page_sous_titre %}Ce que coûte chaque produit fabriqué sur place, et ce qu'il rapporte.{% endblock %}

{% block admin_content %}

{{ recherche.barre('admin_production', 'Produit ou matière') }}
<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Article fabriqué</th>
                <th class="num">Composants</th>
                <th class="num">Coût matières</th>
                <th class="num">Prix de vente</th>
                <th class="num">Marge</th>
                <th class="num"></th>
            </tr>
        </thead>
        <tbody>
            {% for fiche in fiches %}
                <tr>
                    <td class="cellule-principale">{{ fiche.article.nom }}</td>
                    <td class="num"><span class="badge badge-neutre">{{ fiche.composants }}</span></td>
                    <td class="num">{{ fmt.fcfa(fiche.cout_matieres) }}</td>
                    <td class="num">{{ fmt.fcfa(fiche.article.prixVenteTtc) }}</td>
                    <td class="num">
                        <span class="badge {{ fiche.marge >= 0 ? 'badge-vert' : 'badge-rouge' }}">{{ fmt.fcfa(fiche.marge) }}</span>
                    </td>
                    <td class="num">
                        <a href="{{ path('admin_article_show', {id: fiche.article.id, onglet: 'fiche'}) }}"
                           class="btn btn-sm btn-secondaire">{{ ui.icone('modifier') }} Modifier la fiche</a>
                    </td>
                </tr>
            {% else %}
                {# Cet écran ne fait que consulter : une fiche naît en ajoutant sa
                   première matière à un article, il n'y a pas de « nouvelle fiche »
                   à créer ici. Le dire sans donner le chemin laissait chercher. #}
                <tr>
                    <td colspan="6" class="cellule-vide">
                        <span class="mx-auto mb-3 grid h-12 w-12 place-items-center rounded-2xl bg-stone-100 text-stone-400">{{ ui.icone('production', 'h-6 w-6') }}</span>
                        <span class="block font-semibold text-stone-600">Aucune fiche technique.</span>
                        <span class="mt-1 block text-stone-500">
                            Une fiche se compose depuis un article :
                            <a href="{{ path('admin_article_index') }}" class="lien">ouvrez la liste des articles</a>,
                            puis « Fiche technique » sur la ligne du produit.
                        </span>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{{ pagination.barre(page, 'admin_production') }}
{% endblock %}
