{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}{{ titre }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_matiere_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Stock</a>
{% endblock %}

{% block admin_content %}
<div class="carte apparition max-w-3xl">
    {{ form_start(form) }}
    <div class="carte-corps">
        <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
            <div class="sm:col-span-2">{{ form_row(form.nom) }}</div>
            {{ form_row(form.uniteStock) }}
            {{ form_row(form.fournisseur) }}
            {# Le stock de départ n'est saisissable qu'à la création : ensuite il se
               compte, par un inventaire, qui laisse un mouvement et une trace. #}
            {% if form.stockInitial is defined %}
                {{ form_row(form.stockInitial) }}
            {% endif %}
            {{ form_row(form.stockMini) }}
            {{ form_row(form.coutMoyenPondere) }}
        </div>

        {% if form.stockInitial is not defined %}
            <div class="alerte alerte-bleu mt-1">
                {{ ui.icone('info') }}
                <p>
                    Le stock ne se corrige pas ici : ouvrez un
                    <a href="{{ path('admin_inventaires') }}" class="lien">inventaire</a>,
                    qui reporte l'écart en mouvement de stock et le trace au journal d'audit.
                </p>
            </div>
        {% endif %}
    </div>
    <div class="carte-pied">
        <button class="btn btn-primaire">{{ ui.icone('valide') }} Enregistrer</button>
        <a href="{{ path('admin_matiere_index') }}" class="btn btn-fantome">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
