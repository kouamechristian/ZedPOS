{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Stock — Matières premières{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_fournisseur_index') }}" class="rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-medium hover:bg-stone-50">Fournisseurs</a>
    <a href="{{ path('admin_matiere_new') }}" class="rounded-lg bg-stone-800 text-white px-3 py-2 text-sm font-semibold hover:bg-stone-700">+ Nouvelle matière</a>
{% endblock %}

{% block admin_content %}
<turbo-frame id="tableau-stock" data-turbo-action="advance">

{{ recherche.barre('admin_matiere_index', 'Matière, unité, fournisseur') }}
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="text-left text-stone-500 bg-stone-50">
            <tr>
                <th class="px-5 py-3 font-medium">Matière première</th>
                <th class="px-5 py-3 font-medium">Fournisseur</th>
                <th class="px-5 py-3 font-medium text-right">Stock actuel</th>
                <th class="px-5 py-3 font-medium text-right">Seuil</th>
                <th class="px-5 py-3 font-medium text-right">Coût / unité</th>
                <th class="px-5 py-3 font-medium text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for matiere in matieres.items %}
                {% set alerte = matiere.stockActuel < matiere.stockMini %}
                <tr class="border-t border-stone-100 hover:bg-stone-50">
                    <td class="px-5 py-3 font-medium text-stone-800">{{ matiere.nom }}</td>
                    <td class="px-5 py-3 text-stone-600">{{ matiere.fournisseur ? matiere.fournisseur.nom : '—' }}</td>
                    <td class="px-5 py-3 text-right {{ alerte ? 'text-red-600 font-semibold' : '' }}">
                        {{ fmt.unites(matiere.stockActuel) }} {{ matiere.uniteStock }}
                        {% if alerte %}<span class="ml-1 inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-700">seuil</span>{% endif %}
                    </td>
                    <td class="px-5 py-3 text-right text-stone-500">{{ fmt.unites(matiere.stockMini) }}</td>
                    <td class="px-5 py-3 text-right">{{ fmt.fcfa(matiere.coutMoyenPondere) }}</td>
                    <td class="px-5 py-3">
                        <div class="flex items-center justify-end gap-2">
                            {# _top : ces actions quittent le frame (page de formulaire,
                               ou message de confirmation affiché hors du frame). #}
                            <a href="{{ path('admin_matiere_edit', {id: matiere.id}) }}" data-turbo-frame="_top"
                               class="rounded-md border border-stone-300 px-2.5 py-1 text-xs font-medium hover:bg-stone-100">Modifier</a>
                            <form method="post" action="{{ path('admin_matiere_delete', {id: matiere.id}) }}" data-turbo-frame="_top"
                                  data-turbo-confirm="Supprimer cette matière première ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_matiere_' ~ matiere.id) }}">
                                <button class="rounded-md border border-red-300 text-red-700 px-2.5 py-1 text-xs font-medium hover:bg-red-50">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="px-5 py-6 text-center text-stone-400">Aucune matière première.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{# Reste dans le frame : seul le tableau se rafraîchit. #}
{{ pagination.barre(matieres, 'admin_matiere_index') }}
</turbo-frame>
{% endblock %}
