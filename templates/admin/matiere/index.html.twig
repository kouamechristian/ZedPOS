{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Stock — Matières premières{% endblock %}
{% block page_sous_titre %}Quantités en réserve, seuils d'alerte et coût moyen pondéré.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_fournisseur_index') }}" class="btn btn-secondaire">{{ ui.icone('fournisseurs') }} Fournisseurs</a>
    <a href="{{ path('admin_matiere_new') }}" class="btn btn-primaire">{{ ui.icone('plus') }} Nouvelle matière</a>
{% endblock %}

{% block admin_content %}
<turbo-frame id="tableau-stock" data-turbo-action="advance">

{{ recherche.barre('admin_matiere_index', 'Matière, unité, fournisseur') }}
<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Matière première</th>
                <th>Fournisseur</th>
                <th class="num">Stock actuel</th>
                <th class="num">Seuil</th>
                <th class="num">Coût / unité</th>
                <th class="num">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for matiere in matieres.items %}
                {% set alerte = matiere.stockActuel < matiere.stockMini %}
                <tr>
                    <td>
                        <div class="flex items-center gap-2.5">
                            <span class="h-2 w-2 shrink-0 rounded-full {{ alerte ? 'bg-red-500 animate-pulse' : 'bg-green-500' }}"></span>
                            <span class="cellule-principale">{{ matiere.nom }}</span>
                        </div>
                    </td>
                    <td class="cellule-douce">{{ matiere.fournisseur ? matiere.fournisseur.nom : '—' }}</td>
                    <td class="num">
                        <span class="{{ alerte ? 'font-semibold text-red-600' : 'text-stone-800' }}">{{ fmt.unites(matiere.stockActuel) }}</span>
                        <span class="text-stone-400">{{ matiere.uniteStock }}</span>
                        {% if alerte %}<span class="badge badge-rouge ml-1">seuil</span>{% endif %}
                    </td>
                    <td class="num cellule-douce">{{ fmt.unites(matiere.stockMini) }}</td>
                    <td class="num">{{ fmt.fcfa(matiere.coutMoyenPondere) }}</td>
                    <td>
                        <div class="actions-ligne">
                            {# _top : ces actions quittent le frame (page de formulaire,
                               ou message de confirmation affiché hors du frame). #}
                            <a href="{{ path('admin_matiere_edit', {id: matiere.id}) }}" data-turbo-frame="_top"
                               class="btn btn-sm btn-secondaire">{{ ui.icone('modifier') }} Modifier</a>
                            <form method="post" action="{{ path('admin_matiere_delete', {id: matiere.id}) }}" data-turbo-frame="_top"
                                  data-turbo-confirm="Supprimer cette matière première ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_matiere_' ~ matiere.id) }}">
                                <button class="btn btn-sm btn-danger btn-icone" title="Supprimer" aria-label="Supprimer">{{ ui.icone('supprimer') }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="cellule-vide">Aucune matière première.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{# Reste dans le frame : seul le tableau se rafraîchit. #}
{{ pagination.barre(matieres, 'admin_matiere_index') }}
</turbo-frame>
{% endblock %}
