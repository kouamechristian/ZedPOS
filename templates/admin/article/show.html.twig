{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}{{ article.nom }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_article_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Retour</a>
    <form method="post" action="{{ path('admin_article_delete', {id: article.id}) }}" data-turbo-confirm="Supprimer définitivement cet article ?">
        <input type="hidden" name="_token" value="{{ csrf_token('supprimer_article_' ~ article.id) }}">
        <button class="btn btn-danger">{{ ui.icone('supprimer') }} Supprimer</button>
    </form>
    <a href="{{ path('admin_article_edit', {id: article.id}) }}" class="btn btn-primaire">{{ ui.icone('modifier') }} Modifier</a>
{% endblock %}

{% block admin_content %}
<div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_20rem]">

<div class="carte apparition min-w-0">
    {# Les onglets sont en CSS pur (radios masqués + `peer-checked`) : basculer ne
       coûte donc aucune requête. Le revers est qu'ils n'ont pas d'URL — et sans
       elle, tout lien venant d'ailleurs retombait sur « Détails », y compris
       « Voir la fiche » depuis l'écran Production.

       `?onglet=fiche` choisit lequel s'ouvre. C'est ce qui rend la fiche technique
       atteignable en un clic depuis la liste des articles. #}
    {% set onglet = app.request.query.get('onglet') %}
    <input type="radio" name="onglet" id="onglet-details" class="peer/details sr-only" {{ onglet != 'fiche' ? 'checked' }}>
    <input type="radio" name="onglet" id="onglet-fiche" class="peer/fiche sr-only" {{ onglet == 'fiche' ? 'checked' }}>

    <div class="carte-entete">
        <div class="onglets">
            <label for="onglet-details" class="onglet">Détails</label>
            <label for="onglet-fiche" class="onglet">Fiche technique</label>
        </div>
        {{ fmt.badge(article.actif) }}
    </div>

    <section class="hidden peer-checked/details:block carte-corps">
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {% set details = [
                { libelle: 'Famille', valeur: article.familleProduit ? article.familleProduit.nom : '—' },
                { libelle: 'Prix de vente TTC', valeur: fmt.fcfa(article.prixVenteTtc) },
                { libelle: 'TVA', valeur: fmt.pourcent(article.tauxTva) },
                { libelle: 'Unité', valeur: article.unite },
                { libelle: 'Position en caisse', valeur: article.positionCaisse },
            ] %}
            {% for detail in details %}
                <div class="apparition rounded-xl bg-stone-50 px-4 py-3 ring-1 ring-stone-100" style="--i: {{ loop.index }}">
                    <dt class="text-xs font-medium text-stone-500">{{ detail.libelle }}</dt>
                    <dd class="mt-0.5 font-semibold text-stone-900">{{ detail.valeur }}</dd>
                </div>
            {% endfor %}
        </dl>
    </section>

    <section class="hidden peer-checked/fiche:block carte-corps">
        {% include 'admin/article/_fiche_frame.html.twig' %}
    </section>
</div>

{# Aperçu de la touche telle que la caissière la voit. #}
<aside class="carte apparition h-fit p-5" style="--i: 2">
    <h2 class="carte-titre mb-4">Touche en caisse</h2>
    <div class="grid place-items-center rounded-2xl bg-stone-100 p-6">
        <span class="flex w-36 flex-col overflow-hidden rounded-[12px] text-left shadow-md transition-transform duration-300 hover:-translate-y-1"
              style="min-height: 92px; background: {{ article.couleur ?: '#fce3b4' }}; color: #3f2a0f;">
            {% if article.image %}
                <img src="{{ image_article(article.image) }}" alt="" class="h-20 w-full shrink-0 object-cover" onerror="this.remove()">
            {% endif %}
            <span class="flex flex-1 flex-col justify-between p-3">
                <span class="text-[15px] font-medium leading-snug">{{ article.nom }}</span>
                <span class="text-sm opacity-75">{{ fmt.fcfa(article.prixVenteTtc) }}</span>
            </span>
        </span>
    </div>
    <p class="aide mt-3">La couleur et la photo se changent depuis « Modifier ».</p>
</aside>

</div>
{% endblock %}
