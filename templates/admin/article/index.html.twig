{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}

{% block page_title %}Articles{% endblock %}
{% block page_sous_titre %}Le catalogue de la caisse : prix, TVA, fiches techniques et marges.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_famille_index') }}" class="btn btn-secondaire">Familles</a>
    {# Import en masse : garnir un catalogue au démarrage, ou ajouter une gamme
       entière. Bouton secondaire — c'est l'action rare, « + Nouvel article »
       reste le geste courant et garde donc le bouton plein. #}
    <a href="{{ path('admin_article_import') }}" class="btn btn-secondaire">Importer</a>
    <a href="{{ path('admin_article_new') }}" class="btn btn-primaire">{{ ui.icone('plus') }} Nouvel article</a>
{% endblock %}

{% block admin_content %}
{# Filtres + tableau dans un seul frame : filtrer ne recharge que cette zone,
   la navigation latérale et l'en-tête ne bougent pas. #}
<turbo-frame id="liste-articles" data-turbo-action="advance">

<form method="get" class="carte apparition mb-4 flex flex-wrap items-end gap-3 p-3.5">
    <div class="w-full sm:w-72">
        <label class="etiquette-legere" for="filtre-recherche">Recherche</label>
        <div class="champ-avec-icone">
            {{ ui.icone('recherche') }}
            <input type="search" id="filtre-recherche" name="q" value="{{ recherche }}" placeholder="Nom de l'article" class="champ">
        </div>
    </div>
    <div class="min-w-40">
        <label class="etiquette-legere" for="filtre-famille">Famille</label>
        <select id="filtre-famille" name="famille" class="champ">
            <option value="">Toutes</option>
            {% for famille in familles %}
                <option value="{{ famille.id }}" {{ famille_active and famille_active.id == famille.id ? 'selected' }}>{{ famille.nom }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="min-w-36">
        <label class="etiquette-legere" for="filtre-statut">Statut</label>
        <select id="filtre-statut" name="statut" class="champ">
            <option value="">Tous</option>
            <option value="actifs" {{ statut == 'actifs' ? 'selected' }}>Actifs</option>
            <option value="inactifs" {{ statut == 'inactifs' ? 'selected' }}>Inactifs</option>
        </select>
    </div>
    <button class="btn btn-secondaire">{{ ui.icone('filtre') }} Filtrer</button>
    {% if recherche or famille_active or statut %}
        <a href="{{ path('admin_article_index') }}" class="btn btn-fantome">{{ ui.icone('fermer', 'h-4 w-4') }} Réinitialiser</a>
    {% endif %}
</form>

<div class="tableau-conteneur apparition" style="--i: 1">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Article</th>
                <th>Famille</th>
                <th class="num">Prix TTC</th>
                <th>TVA</th>
                {% if is_granted('ARTICLE_VOIR_COUT') %}
                    <th class="num">Coût / Marge</th>
                {% endif %}
                <th>Statut</th>
                <th class="num">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for article in articles.items %}
                <tr>
                    <td>
                        <div class="flex items-center gap-3">
                            {# La photo remplace la pastille de couleur quand il y
                               en a une : c'est elle que la caissière verra. #}
                            {% if article.image %}
                                <img src="{{ image_article(article.image) }}" alt="" loading="lazy"
                                     onerror="this.remove()"
                                     class="h-10 w-10 shrink-0 rounded-xl object-cover ring-1 ring-stone-200">
                            {% else %}
                                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl text-sm font-bold text-stone-700 ring-1 ring-black/5"
                                      style="background: {{ article.couleur ?: '#e7e5e4' }}">{{ article.nom|first|upper }}</span>
                            {% endif %}
                            {# _top : ouvrir la fiche remplace la page entière, pas le frame. #}
                            <a href="{{ path('admin_article_show', {id: article.id}) }}" data-turbo-frame="_top"
                               class="cellule-principale hover:text-amber-700">{{ article.nom }}</a>
                        </div>
                    </td>
                    <td class="cellule-douce">{{ article.familleProduit ? article.familleProduit.nom : '—' }}</td>
                    <td class="num font-semibold text-stone-900">{{ fmt.fcfa(article.prixVenteTtc) }}</td>
                    <td class="cellule-douce">{{ fmt.pourcent(article.tauxTva) }}</td>
                    {% if is_granted('ARTICLE_VOIR_COUT') %}
                        {% set cout = couts[article.id] %}
                        <td class="num">
                            {% if cout and cout.calculable %}
                                <div class="text-xs text-stone-500">Revient {{ fmt.fcfa(cout.coutRevient) }}</div>
                                <div class="mt-0.5 flex items-center justify-end gap-2">
                                    <span class="font-semibold {{ cout.margeBrute < 0 ? 'text-red-600' : 'text-stone-800' }}">{{ fmt.fcfa(cout.margeBrute) }}</span>
                                    <span class="text-xs text-stone-500">{{ cout.tauxMargePourcent|number_format(1, ',', ' ') }} %</span>
                                    {% if cout.sousSeuil %}
                                        <span class="badge badge-rouge"
                                              title="Marge sous le seuil de {{ cout.seuilPourcent|number_format(0, ',', ' ') }} %">Marge basse</span>
                                    {% endif %}
                                </div>
                            {% else %}
                                <span class="text-stone-300">—</span>
                            {% endif %}
                        </td>
                    {% endif %}
                    <td>{{ fmt.badge(article.actif) }}</td>
                    <td>
                        <div class="actions-ligne">
                            {# _top également : le message de confirmation s'affiche
                               hors du frame, il serait perdu sinon. #}
                            <form method="post" action="{{ path('admin_article_toggle', {id: article.id}) }}" data-turbo-frame="_top">
                                <input type="hidden" name="_token" value="{{ csrf_token('basculer_article_' ~ article.id) }}">
                                <button class="btn btn-sm btn-fantome">
                                    {{ article.actif ? 'Désactiver' : 'Activer' }}
                                </button>
                            </form>
                            {# La fiche technique est la raison la plus fréquente
                               d'ouvrir un article, et c'était jusqu'ici le seul
                               écran du back-office sans bouton pour y entrer : on
                               ne pouvait y accéder qu'en devinant que le nom, dans
                               la première colonne, était cliquable. Le lien mène
                               directement à l'onglet. #}
                            <a href="{{ path('admin_article_show', {id: article.id, onglet: 'fiche'}) }}" data-turbo-frame="_top"
                               class="btn btn-sm btn-secondaire">Fiche technique</a>
                            <a href="{{ path('admin_article_edit', {id: article.id}) }}" data-turbo-frame="_top"
                               class="btn btn-sm btn-secondaire">{{ ui.icone('modifier') }} Modifier</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="{{ is_granted('ARTICLE_VOIR_COUT') ? 7 : 6 }}" class="cellule-vide">Aucun article ne correspond aux filtres.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{# La barre conserve les filtres en cours (famille, recherche, statut) : changer
   de page ne doit pas les effacer. #}
{{ pagination.barre(articles, 'admin_article_index') }}
</turbo-frame>
{% endblock %}
