{% import 'admin/_macros.html.twig' as fmt %}
{% form_theme ligne_form 'admin/_form_theme.html.twig' %}

<turbo-frame id="fiche_technique">
    {% set fiche = article.ficheTechnique %}
    {% set lignes = fiche ? fiche.lignes : [] %}
    {% set total = lignes|reduce((acc, l) => acc + (l.matierePremiere.coutMoyenPondere * l.quantite / 1000), 0) %}

    <div class="overflow-hidden rounded-2xl border border-stone-200">
    <div class="defilement-x">
    <table class="tableau tableau-compact">
        <thead>
            <tr>
                <th>Matière première</th>
                <th class="num">Quantité</th>
                <th class="num">Perte</th>
                <th class="num">Coût matière</th>
                <th class="num"></th>
            </tr>
        </thead>
        <tbody>
            {% for ligne in lignes %}
                <tr>
                    <td class="cellule-principale">{{ ligne.matierePremiere.nom }}</td>
                    <td class="num">{{ fmt.unites(ligne.quantite) }} <span class="text-stone-400">{{ ligne.matierePremiere.uniteStock }}</span></td>
                    <td class="num cellule-douce">{{ fmt.pourcent(ligne.pourcentagePerte) }}</td>
                    <td class="num">{{ fmt.fcfa((ligne.matierePremiere.coutMoyenPondere * ligne.quantite / 1000)|round) }}</td>
                    <td class="num">
                        <form method="post" action="{{ path('admin_article_fiche_remove', {id: article.id, ligneId: ligne.id}) }}" data-turbo-confirm="Retirer cette matière première ?">
                            <input type="hidden" name="_token" value="{{ csrf_token('retirer_ligne_' ~ ligne.id) }}">
                            <button class="btn btn-sm btn-fantome text-red-600 hover:text-red-700">Retirer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="cellule-vide">Aucune matière première. Ajoutez-en ci-dessous.</td></tr>
            {% endfor %}
        </tbody>
        {% if lignes|length > 0 %}
            <tfoot>
                <tr>
                    <td colspan="3">Coût matières total</td>
                    <td class="num text-stone-900">{{ fmt.fcfa(total|round) }}</td>
                    <td></td>
                </tr>
            </tfoot>
        {% endif %}
    </table>
    </div>
    </div>

    <div class="mt-5 rounded-2xl bg-stone-50 p-4 ring-1 ring-stone-100">
        <h3 class="mb-3 text-sm font-semibold text-stone-800">Ajouter une matière première</h3>
        {{ form_start(ligne_form) }}
        <div class="flex flex-wrap items-end gap-3">
            <div class="min-w-48 flex-1">
                <label class="etiquette-legere">Matière première</label>
                {{ form_widget(ligne_form.matierePremiere) }}
            </div>
            <div class="w-36">
                <label class="etiquette-legere">Quantité</label>
                {{ form_widget(ligne_form.quantite) }}
            </div>
            <div class="w-28">
                <label class="etiquette-legere">Perte (%)</label>
                {{ form_widget(ligne_form.pourcentagePerte) }}
            </div>
            <button class="btn btn-primaire">Ajouter</button>
        </div>
        {{ form_end(ligne_form) }}
    </div>
</turbo-frame>
