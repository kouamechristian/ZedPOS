{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}Importer des articles{% endblock %}
{% block page_sous_titre %}Un fichier CSV à deux colonnes — nom, prix de vente en FCFA — pour garnir le catalogue d'un coup.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_article_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Retour au catalogue</a>
{% endblock %}

{% block admin_content %}
<div class="grid max-w-5xl gap-5">

    {# Le compte rendu d'abord : après un import, c'est la seule chose qu'on vient
       lire. Le formulaire reste en dessous, pour repasser un fichier corrigé. #}
    {% if rapport %}
        <section class="carte apparition overflow-hidden">
            <div class="carte-entete">
                <h2 class="carte-titre">Résultat de l'import</h2>
            </div>

            <div class="grid grid-cols-3 divide-x divide-stone-100 border-b border-stone-100 text-center">
                <div class="px-4 py-5">
                    <div class="text-3xl font-bold tabular-nums text-green-700">{{ rapport.nombreCreees }}</div>
                    <div class="mt-0.5 text-xs text-stone-500">créé{{ rapport.nombreCreees > 1 ? 's' }}</div>
                </div>
                <div class="px-4 py-5">
                    <div class="text-3xl font-bold tabular-nums text-stone-500">{{ rapport.doublons|length }}</div>
                    <div class="mt-0.5 text-xs text-stone-500">déjà au catalogue</div>
                </div>
                <div class="px-4 py-5">
                    <div class="text-3xl font-bold tabular-nums {{ rapport.rejets is empty ? 'text-stone-300' : 'text-red-600' }}">{{ rapport.rejets|length }}</div>
                    <div class="mt-0.5 text-xs text-stone-500">ligne{{ rapport.rejets|length > 1 ? 's' }} refusée{{ rapport.rejets|length > 1 ? 's' }}</div>
                </div>
            </div>

            <div class="space-y-4 p-5">
                {# Les prix écartés faute d'habilitation : à dire en premier et sans
                   détour, sinon le gérant croit à un fichier incomplet et le refait. #}
                {% if rapport.prixIgnores %}
                    <div class="alerte alerte-ambre">
                        {{ ui.icone('info') }}
                        <div>
                            <span class="font-semibold">Les prix du fichier n'ont pas été repris.</span>
                            Seule la dirigeante peut fixer un prix de vente. Les articles ont été créés
                            à 0 FCFA et <strong>restent inactifs</strong> — ils n'apparaîtront en caisse
                            qu'une fois leur prix fixé.
                        </div>
                    </div>
                {% endif %}

                {% set sansPrix = rapport.sansPrix %}
                {% if sansPrix is not empty and not rapport.prixIgnores %}
                    <div class="alerte alerte-ambre">
                        {{ ui.icone('info') }}
                        <div>
                            <span class="font-semibold">{{ sansPrix|length }} article(s) sans prix</span>, donc inactifs :
                            {{ sansPrix|slice(0, 8)|join(', ') }}{% if sansPrix|length > 8 %}…{% endif %}
                        </div>
                    </div>
                {% endif %}

                {% if rapport.rejets is not empty %}
                    <div>
                        <h3 class="mb-2 text-sm font-semibold text-stone-800">Lignes refusées</h3>
                        <div class="overflow-hidden rounded-xl border border-stone-200">
                            <div class="defilement-x">
                                <table class="tableau tableau-compact">
                                    <thead>
                                        <tr>
                                            <th>Ligne</th>
                                            <th>Contenu</th>
                                            <th>Raison</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for rejet in rapport.rejets %}
                                            <tr>
                                                <td class="cellule-douce tabular-nums">{{ rejet.ligne }}</td>
                                                <td class="code text-stone-700">{{ rejet.contenu }}</td>
                                                <td class="text-red-700">{{ rejet.raison }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <p class="aide mt-2">
                            Corrigez ces lignes et repassez le fichier : les articles déjà créés
                            seront reconnus et ignorés, rien ne sera créé en double.
                        </p>
                    </div>
                {% endif %}

                {% if rapport.doublons is not empty %}
                    <p class="text-sm text-stone-600">
                        <span class="font-semibold text-stone-800">Déjà au catalogue, laissés intacts :</span>
                        {{ rapport.doublons|slice(0, 10)|join(', ') }}{% if rapport.doublons|length > 10 %} et {{ rapport.doublons|length - 10 }} autre(s){% endif %}.
                        <span class="text-stone-500">Leur prix n'a pas été touché.</span>
                    </p>
                {% endif %}

                {% if rapport.creees is not empty %}
                    <div>
                        <h3 class="mb-2 text-sm font-semibold text-stone-800">Articles créés</h3>
                        <div class="overflow-hidden rounded-xl border border-stone-200">
                            <table class="tableau tableau-compact">
                                <tbody>
                                    {% for ligne in rapport.creees %}
                                        <tr>
                                            <td class="text-stone-800">{{ ligne.nom }}</td>
                                            <td class="num font-medium {{ ligne.prix == 0 ? 'text-stone-400' : '' }}">
                                                {{ ligne.prix > 0 ? fmt.fcfa(ligne.prix) : '— sans prix' }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <a href="{{ path('admin_article_index', {statut: 'inactifs'}) }}" class="lien mt-3 inline-block text-sm">
                            Voir les articles inactifs du catalogue
                        </a>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <section class="carte apparition p-6" style="--i: 1">
            <h2 class="carte-titre mb-1">Le fichier attendu</h2>
            <p class="mb-4 text-sm text-stone-500">
                Un article par ligne : <strong>son nom</strong>, puis <strong>son prix de vente en
                FCFA</strong>. Une ligne d'en-têtes est reconnue et ignorée.
            </p>

            <pre class="mb-4 overflow-x-auto rounded-xl bg-stone-900 px-4 py-3 text-xs leading-relaxed text-amber-100">Nom;Prix de vente (FCFA)
Baguette;150
Pain au chocolat;300
Sandwich poulet;1500</pre>

            <ul class="mb-5 space-y-2 text-sm text-stone-600">
                {% set regles = [
                    'Séparateur <strong>point-virgule, tabulation ou virgule</strong> — reconnu tout seul.',
                    'Prix en <strong>FCFA entiers</strong>. « 1 500 », « 1.500 » et « 1500 » sont acceptés ; un montant à centimes (« 1500,50 ») est refusé.',
                    'Un article <strong>déjà au catalogue est ignoré</strong>, jamais mis à jour : un import ne doit pas changer un prix en place.',
                    'Unité fixée à <strong>« pièce »</strong>, sans famille ni TVA : à compléter ensuite sur la fiche de l\'article.',
                    constant('App\\Service\\ImportArticles::MAX_LIGNES') ~ ' lignes au maximum par fichier.',
                ] %}
                {% for regle in regles %}
                    <li class="flex gap-2.5">
                        <span class="mt-0.5 text-amber-600">{{ ui.icone('valide', 'h-4 w-4') }}</span>
                        <span>{{ regle|raw }}</span>
                    </li>
                {% endfor %}
            </ul>

            {# data-turbo="false" : Turbo intercepte les clics et attend du HTML — sans
               cet attribut le fichier ne descend pas et la navigation échoue en silence. #}
            <a href="{{ path('admin_article_import_modele') }}" data-turbo="false" class="btn btn-secondaire">
                {{ ui.icone('telecharger') }} Télécharger un modèle à remplir
            </a>
        </section>

        <section class="carte apparition flex flex-col" style="--i: 2">
            <div class="carte-corps flex-1">
                <h2 class="carte-titre mb-4">Déposer le fichier</h2>

                {% if not avec_prix %}
                    {# Dit **avant** le dépôt, pas après : découvrir la règle une fois les
                       soixante articles créés à 0 FCFA serait une mauvaise surprise. #}
                    <div class="alerte alerte-ambre mb-5">
                        {{ ui.icone('info') }}
                        <div>
                            <span class="font-semibold">Les prix ne seront pas repris.</span>
                            Fixer un prix de vente est réservé à la dirigeante : les articles seront créés
                            <strong>inactifs, à 0 FCFA</strong>, et n'apparaîtront pas en caisse tant que leur
                            prix n'aura pas été fixé. Vous pouvez tout de même laisser la colonne des prix
                            dans le fichier — elle sera simplement ignorée.
                        </div>
                    </div>
                {% endif %}

                {{ form_start(form) }}
                    <div class="rounded-2xl border-2 border-dashed border-stone-200 bg-stone-50/70 p-5 transition hover:border-amber-300 hover:bg-amber-50/40">
                        <div class="mb-3 flex items-center gap-3">
                            <span class="kpi-icone">{{ ui.icone('importer') }}</span>
                            <span class="text-sm text-stone-600">Choisissez un fichier <strong>.csv</strong> exporté de votre tableur.</span>
                        </div>
                        {{ form_row(form.fichier) }}
                    </div>
                    <div class="mt-5 flex flex-wrap items-center gap-3">
                        <button class="btn btn-primaire btn-lg">{{ ui.icone('importer') }} Importer</button>
                        <span class="text-xs text-stone-500">Aucun article existant ne sera modifié.</span>
                    </div>
                {{ form_end(form) }}
            </div>
        </section>
    </div>
</div>
{% endblock %}
