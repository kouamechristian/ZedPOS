{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Vendeurs{% endblock %}
{% block page_sous_titre %}Les revendeurs à qui la boutique confie sa marchandise. Ils n'ont pas de compte.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_stand_index') }}" class="btn btn-secondaire">Stands</a>
    <a href="{{ path('admin_vendeur_new') }}" class="btn btn-primaire">{{ ui.icone('plus') }} Nouveau vendeur</a>
{% endblock %}

{% block admin_content %}
{{ recherche.barre('admin_vendeur_index', 'Nom ou téléphone') }}
<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Vendeur</th>
                <th>Téléphone</th>
                <th class="num">Dette en cours</th>
                <th>Statut</th>
                <th class="num">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for vendeur in vendeurs.items %}
                {% set solde = soldes[vendeur.id] ?? 0 %}
                <tr>
                    <td class="cellule-principale"><a href="{{ path('admin_vendeur_show', {id: vendeur.id}) }}" class="lien">{{ vendeur.nom }}</a></td>
                    <td class="cellule-douce tabular-nums">{{ vendeur.telephone ?? '—' }}</td>
                    <td class="num tabular-nums">
                        {% if solde > seuil_dette %}
                            <span class="badge badge-rouge" title="Au-delà du seuil d'alerte de {{ fmt.fcfa(seuil_dette) }}">{{ fmt.fcfa(solde) }}</span>
                        {% elseif solde > 0 %}
                            {{ fmt.fcfa(solde) }}
                        {% else %}
                            <span class="cellule-douce">—</span>
                        {% endif %}
                    </td>
                    <td>{{ fmt.badge(vendeur.actif) }}</td>
                    <td>
                        <div class="actions-ligne">
                            <a href="{{ path('admin_vendeur_show', {id: vendeur.id}) }}" class="btn btn-sm btn-secondaire">{{ ui.icone('document') }} Fiche</a>
                            <a href="{{ path('admin_vendeur_edit', {id: vendeur.id}) }}" class="btn btn-sm btn-secondaire">{{ ui.icone('modifier') }} Modifier</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="cellule-vide">Aucun vendeur.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{{ pagination.barre(vendeurs, 'admin_vendeur_index') }}
{% endblock %}
