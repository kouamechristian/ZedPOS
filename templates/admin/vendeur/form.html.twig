{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}{{ titre }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_vendeur_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Vendeurs</a>
{% endblock %}

{% block admin_content %}
<div class="carte apparition max-w-xl">
    {{ form_start(form) }}
    <div class="carte-corps">
        {{ form_row(form.nom) }}
        {{ form_row(form.telephone) }}
        {{ form_row(form.actif) }}
    </div>
    <div class="carte-pied">
        <button class="btn btn-primaire">{{ ui.icone('valide') }} Enregistrer</button>
        <a href="{{ path('admin_vendeur_index') }}" class="btn btn-fantome">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
