{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}

{% block page_title %}Tableau de bord{% endblock %}

{% block admin_content %}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {% set cartes = [
        { titre: "Chiffre d'affaires du jour", valeur: fmt.fcfa(ca_jour), sous: ventes_jour ~ ' vente(s)' },
        { titre: 'CA 30 derniers jours', valeur: fmt.fcfa(ca_30j), sous: 'Panier moyen ' ~ fmt.fcfa(panier_moyen) },
        { titre: 'Articles actifs', valeur: articles_actifs, sous: 'au catalogue' },
        { titre: 'Alertes de stock', valeur: matieres_alerte, sous: 'matière(s) sous le seuil' },
    ] %}
    {% for carte in cartes %}
        <div class="bg-white rounded-xl shadow-sm p-5">
            <div class="text-sm text-slate-500">{{ carte.titre }}</div>
            <div class="mt-2 text-2xl font-bold text-slate-900">{{ carte.valeur }}</div>
            <div class="mt-1 text-xs text-slate-400">{{ carte.sous }}</div>
        </div>
    {% endfor %}
</div>

<div class="mt-6 bg-white rounded-xl shadow-sm">
    <div class="px-5 py-4 border-b border-slate-100 font-semibold">Meilleures ventes (30 jours)</div>
    <table class="w-full text-sm">
        <thead class="text-left text-slate-500">
            <tr class="border-b border-slate-100">
                <th class="px-5 py-2 font-medium">Article</th>
                <th class="px-5 py-2 font-medium text-right">Quantité vendue</th>
                <th class="px-5 py-2 font-medium text-right">Chiffre d'affaires</th>
            </tr>
        </thead>
        <tbody>
            {% for ligne in top_articles %}
                <tr class="border-b border-slate-50">
                    <td class="px-5 py-2.5">{{ ligne.nom }}</td>
                    <td class="px-5 py-2.5 text-right">{{ ligne.quantite|number_format(0, ',', ' ') }}</td>
                    <td class="px-5 py-2.5 text-right font-medium">{{ fmt.fcfa(ligne.ca) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="px-5 py-4 text-slate-400">Aucune vente sur la période.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
