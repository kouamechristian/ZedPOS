{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}{{ titre }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_fournisseur_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Fournisseurs</a>
{% endblock %}

{% block admin_content %}
<div class="carte apparition max-w-2xl">
    {{ form_start(form) }}
    <div class="carte-corps">
        {{ form_row(form.nom) }}
        <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
            {{ form_row(form.telephone) }}
            {{ form_row(form.email) }}
        </div>
        {{ form_row(form.adresse) }}
        {{ form_row(form.actif) }}
    </div>
    <div class="carte-pied">
        <button class="btn btn-primaire">{{ ui.icone('valide') }} Enregistrer</button>
        <a href="{{ path('admin_fournisseur_index') }}" class="btn btn-fantome">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
