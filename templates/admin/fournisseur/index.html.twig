{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Fournisseurs{% endblock %}
{% block page_sous_titre %}Les contacts qui approvisionnent la boutique en matières premières.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_matiere_index') }}" class="btn btn-secondaire">Stock</a>
    <a href="{{ path('admin_fournisseur_new') }}" class="btn btn-primaire">{{ ui.icone('plus') }} Nouveau fournisseur</a>
{% endblock %}

{% block admin_content %}

{{ recherche.barre('admin_fournisseur_index', 'Nom, téléphone, e-mail') }}
<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Fournisseur</th>
                <th>Téléphone</th>
                <th>E-mail</th>
                <th>Statut</th>
                <th class="num">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for fournisseur in fournisseurs.items %}
                <tr>
                    <td>
                        <div class="flex items-center gap-3">
                            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-stone-100 text-stone-500">{{ ui.icone('fournisseurs', 'h-4.5 w-4.5') }}</span>
                            <span class="cellule-principale">{{ fournisseur.nom }}</span>
                        </div>
                    </td>
                    <td class="cellule-douce tabular-nums">{{ fournisseur.telephone ?: '—' }}</td>
                    <td class="cellule-douce">{{ fournisseur.email ?: '—' }}</td>
                    <td>{{ fmt.badge(fournisseur.actif) }}</td>
                    <td>
                        <div class="actions-ligne">
                            <a href="{{ path('admin_fournisseur_edit', {id: fournisseur.id}) }}" class="btn btn-sm btn-secondaire">{{ ui.icone('modifier') }} Modifier</a>
                            <form method="post" action="{{ path('admin_fournisseur_delete', {id: fournisseur.id}) }}" data-turbo-confirm="Supprimer ce fournisseur ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_fournisseur_' ~ fournisseur.id) }}">
                                <button class="btn btn-sm btn-danger btn-icone" title="Supprimer" aria-label="Supprimer">{{ ui.icone('supprimer') }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="cellule-vide">Aucun fournisseur.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{{ pagination.barre(fournisseurs, 'admin_fournisseur_index') }}
{% endblock %}
