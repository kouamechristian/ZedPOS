{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}

{% block page_title %}Fournisseurs{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_matiere_index') }}" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">Stock</a>
    <a href="{{ path('admin_fournisseur_new') }}" class="rounded-lg bg-slate-800 text-white px-3 py-2 text-sm font-semibold hover:bg-slate-700">+ Nouveau fournisseur</a>
{% endblock %}

{% block admin_content %}
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="text-left text-slate-500 bg-slate-50">
            <tr>
                <th class="px-5 py-3 font-medium">Fournisseur</th>
                <th class="px-5 py-3 font-medium">Téléphone</th>
                <th class="px-5 py-3 font-medium">E-mail</th>
                <th class="px-5 py-3 font-medium">Statut</th>
                <th class="px-5 py-3 font-medium text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for fournisseur in fournisseurs %}
                <tr class="border-t border-slate-100 hover:bg-slate-50">
                    <td class="px-5 py-3 font-medium text-slate-800">{{ fournisseur.nom }}</td>
                    <td class="px-5 py-3 text-slate-600">{{ fournisseur.telephone ?: '—' }}</td>
                    <td class="px-5 py-3 text-slate-600">{{ fournisseur.email ?: '—' }}</td>
                    <td class="px-5 py-3">{{ fmt.badge(fournisseur.actif) }}</td>
                    <td class="px-5 py-3">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('admin_fournisseur_edit', {id: fournisseur.id}) }}" class="rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium hover:bg-slate-100">Modifier</a>
                            <form method="post" action="{{ path('admin_fournisseur_delete', {id: fournisseur.id}) }}" data-turbo-confirm="Supprimer ce fournisseur ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_fournisseur_' ~ fournisseur.id) }}">
                                <button class="rounded-md border border-red-300 text-red-700 px-2.5 py-1 text-xs font-medium hover:bg-red-50">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="px-5 py-6 text-center text-slate-400">Aucun fournisseur.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
