{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Fournisseurs{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_matiere_index') }}" class="rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-medium hover:bg-stone-50">Stock</a>
    <a href="{{ path('admin_fournisseur_new') }}" class="rounded-lg bg-stone-800 text-white px-3 py-2 text-sm font-semibold hover:bg-stone-700">+ Nouveau fournisseur</a>
{% endblock %}

{% block admin_content %}

{{ recherche.barre('admin_fournisseur_index', 'Nom, téléphone, e-mail') }}
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="text-left text-stone-500 bg-stone-50">
            <tr>
                <th class="px-5 py-3 font-medium">Fournisseur</th>
                <th class="px-5 py-3 font-medium">Téléphone</th>
                <th class="px-5 py-3 font-medium">E-mail</th>
                <th class="px-5 py-3 font-medium">Statut</th>
                <th class="px-5 py-3 font-medium text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for fournisseur in fournisseurs.items %}
                <tr class="border-t border-stone-100 hover:bg-stone-50">
                    <td class="px-5 py-3 font-medium text-stone-800">{{ fournisseur.nom }}</td>
                    <td class="px-5 py-3 text-stone-600">{{ fournisseur.telephone ?: '—' }}</td>
                    <td class="px-5 py-3 text-stone-600">{{ fournisseur.email ?: '—' }}</td>
                    <td class="px-5 py-3">{{ fmt.badge(fournisseur.actif) }}</td>
                    <td class="px-5 py-3">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('admin_fournisseur_edit', {id: fournisseur.id}) }}" class="rounded-md border border-stone-300 px-2.5 py-1 text-xs font-medium hover:bg-stone-100">Modifier</a>
                            <form method="post" action="{{ path('admin_fournisseur_delete', {id: fournisseur.id}) }}" data-turbo-confirm="Supprimer ce fournisseur ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_fournisseur_' ~ fournisseur.id) }}">
                                <button class="rounded-md border border-red-300 text-red-700 px-2.5 py-1 text-xs font-medium hover:bg-red-50">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="px-5 py-6 text-center text-stone-400">Aucun fournisseur.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{{ pagination.barre(fournisseurs, 'admin_fournisseur_index') }}
{% endblock %}
