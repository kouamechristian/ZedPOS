{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}

{% block page_title %}Pertes{% endblock %}

{% block page_actions %}
    <form method="get" class="flex items-center gap-2">
        <input type="month" name="mois" value="{{ mois }}"
               class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
        <button class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">Voir</button>
    </form>
    <a href="{{ path('admin_perte_saisie') }}" class="rounded-lg bg-slate-800 text-white px-3 py-2 text-sm font-semibold hover:bg-slate-700">+ Saisir une perte</a>
{% endblock %}

{% block admin_content %}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl shadow-sm p-5 lg:col-span-1">
        <div class="text-sm text-slate-500">Total des pertes valorisées</div>
        <div class="mt-2 text-3xl font-bold text-red-600">{{ fmt.fcfa(total) }}</div>
        <div class="mt-1 text-xs text-slate-400">mois {{ mois }}</div>
    </div>

    <div class="bg-white rounded-xl shadow-sm lg:col-span-2">
        <div class="px-5 py-3 border-b border-slate-100 font-semibold">Ventilation par motif</div>
        <table class="w-full text-sm">
            <thead class="text-left text-slate-500">
                <tr><th class="px-5 py-2 font-medium">Motif</th><th class="px-5 py-2 font-medium text-right">Nombre</th><th class="px-5 py-2 font-medium text-right">Valorisation</th></tr>
            </thead>
            <tbody>
                {% for ligne in ventilation %}
                    <tr class="border-t border-slate-50">
                        <td class="px-5 py-2">{{ ligne.motif.libelle }}</td>
                        <td class="px-5 py-2 text-right text-slate-600">{{ ligne.nombre }}</td>
                        <td class="px-5 py-2 text-right font-medium">{{ fmt.fcfa(ligne.valorisation) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="px-5 py-4 text-slate-400">Aucune perte sur le mois.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 bg-white rounded-xl shadow-sm">
    <div class="px-5 py-3 border-b border-slate-100 font-semibold">Top 5 des produits les plus perdus</div>
    <table class="w-full text-sm">
        <thead class="text-left text-slate-500">
            <tr><th class="px-5 py-2 font-medium">Produit</th><th class="px-5 py-2 font-medium text-right">Quantité</th><th class="px-5 py-2 font-medium text-right">Valorisation</th></tr>
        </thead>
        <tbody>
            {% for ligne in top %}
                <tr class="border-t border-slate-50">
                    <td class="px-5 py-2 font-medium text-slate-800">{{ ligne.nom }}</td>
                    <td class="px-5 py-2 text-right text-slate-600">{{ fmt.unites(ligne.quantite) }}</td>
                    <td class="px-5 py-2 text-right font-medium">{{ fmt.fcfa(ligne.valorisation) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="px-5 py-4 text-slate-400">—</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="mt-4 bg-white rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-100 font-semibold">Détail des pertes</div>
    <table class="w-full text-sm">
        <thead class="text-left text-slate-500 bg-slate-50">
            <tr>
                <th class="px-5 py-3 font-medium">Date</th>
                <th class="px-5 py-3 font-medium">Motif</th>
                <th class="px-5 py-3 font-medium">Élément</th>
                <th class="px-5 py-3 font-medium text-right">Quantité</th>
                <th class="px-5 py-3 font-medium text-right">Valorisation</th>
            </tr>
        </thead>
        <tbody>
            {% for perte in pertes %}
                <tr class="border-t border-slate-100">
                    <td class="px-5 py-2.5 text-slate-600">{{ perte.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="px-5 py-2.5">{{ perte.motif.libelle }}</td>
                    <td class="px-5 py-2.5 text-slate-600">{{ perte.matierePremiere ? perte.matierePremiere.nom : (perte.article ? perte.article.nom : '—') }}</td>
                    <td class="px-5 py-2.5 text-right">{{ fmt.unites(perte.quantite) }}</td>
                    <td class="px-5 py-2.5 text-right font-medium">{{ fmt.fcfa(perte.valorisation) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="px-5 py-6 text-center text-slate-400">Aucune perte enregistrée ce mois-ci.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
