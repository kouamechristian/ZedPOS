{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Pertes{% endblock %}
{% block page_sous_titre %}Casse, périmés et invendus, valorisés au coût : ce que la boutique jette chaque mois.{% endblock %}

{% block page_actions %}
    <form method="get" class="flex items-center gap-2">
        <input type="month" name="mois" value="{{ mois }}" class="champ w-auto" aria-label="Mois consulté">
        <button class="btn btn-secondaire">Voir</button>
    </form>
    <a href="{{ path('admin_perte_saisie') }}" class="btn btn-primaire">{{ ui.icone('plus') }} Saisir une perte</a>
{% endblock %}

{% block admin_content %}

{{ recherche.barre('admin_pertes', 'Produit, matière ou commentaire') }}
<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
    <article class="kpi apparition flex flex-col justify-between">
        <div class="kpi-tete">
            <span class="kpi-libelle">Total des pertes valorisées</span>
            <span class="kpi-icone kpi-icone-rouge">{{ ui.icone('pertes') }}</span>
        </div>
        <div>
            <div class="kpi-valeur text-red-600">{{ fmt.fcfa(total) }}</div>
            <div class="kpi-note">mois {{ mois }}</div>
        </div>
    </article>

    <section class="carte apparition lg:col-span-2" style="--i: 1">
        <div class="carte-entete"><h2 class="carte-titre">Ventilation par motif</h2></div>
        <table class="tableau">
            <thead>
                <tr><th>Motif</th><th class="num">Nombre</th><th class="num">Valorisation</th></tr>
            </thead>
            <tbody>
                {% for ligne in ventilation %}
                    <tr>
                        <td class="text-stone-800">{{ ligne.motif.libelle }}</td>
                        <td class="num cellule-douce">{{ ligne.nombre }}</td>
                        <td class="num font-semibold">{{ fmt.fcfa(ligne.valorisation) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="cellule-vide">Aucune perte sur le mois.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
</div>

<section class="carte apparition mt-5" style="--i: 2">
    <div class="carte-entete"><h2 class="carte-titre">Top 5 des produits les plus perdus</h2></div>
    <table class="tableau">
        <thead>
            <tr><th>Produit</th><th class="num">Quantité</th><th class="num">Valorisation</th></tr>
        </thead>
        <tbody>
            {% for ligne in top %}
                <tr>
                    <td class="cellule-principale">
                        <span class="mr-2 inline-grid h-6 w-6 place-items-center rounded-md bg-red-50 text-xs font-bold text-red-700">{{ loop.index }}</span>{{ ligne.nom }}
                    </td>
                    <td class="num cellule-douce">{{ fmt.unites(ligne.quantite) }}</td>
                    <td class="num font-semibold">{{ fmt.fcfa(ligne.valorisation) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="cellule-vide">—</td></tr>
            {% endfor %}
        </tbody>
    </table>
</section>

{# Le détail reste le **dernier** tableau de la page : c'est celui que la
   recherche filtre, et `RechercheBackOfficeTest` le lit en dernier. #}
<section class="tableau-conteneur apparition mt-5" style="--i: 3">
    <div class="carte-entete"><h2 class="carte-titre">Détail des pertes</h2></div>
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Date</th>
                <th>Motif</th>
                <th>Élément</th>
                <th class="num">Quantité</th>
                <th class="num">Valorisation</th>
            </tr>
        </thead>
        <tbody>
            {% for perte in pertes.items %}
                <tr>
                    <td class="cellule-douce whitespace-nowrap tabular-nums">{{ perte.createdAt|date('d/m/Y H:i') }}</td>
                    <td><span class="badge badge-neutre">{{ perte.motif.libelle }}</span></td>
                    <td class="text-stone-800">{{ perte.matierePremiere ? perte.matierePremiere.nom : (perte.article ? perte.article.nom : '—') }}</td>
                    <td class="num">{{ fmt.unites(perte.quantite) }}</td>
                    <td class="num font-semibold">{{ fmt.fcfa(perte.valorisation) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="cellule-vide">Aucune perte enregistrée ce mois-ci.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</section>
{# Le mois consulté est un paramètre de requête : la barre le conserve. #}
{{ pagination.barre(pertes, 'admin_pertes') }}
{% endblock %}
