{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}

{% block page_title %}{{ rapport.definitif ? 'Rapport Z' : 'Session en cours' }} — {{ rapport.session.utilisateur.nom }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_caisse_rapport_z', {id: rapport.session.id}) }}" target="_blank"
       class="rounded-lg bg-stone-900 px-3 py-2 text-sm font-medium text-white hover:bg-stone-700">Imprimer (58 mm)</a>
    <a href="{{ path('admin_clotures') }}" class="rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-medium hover:bg-stone-50">← Clôtures</a>
{% endblock %}

{% block admin_content %}
{% if not rapport.definitif %}
    <div class="mb-4 rounded-lg bg-blue-50 border border-blue-200 px-4 py-3 text-sm text-blue-800">
        Cette session est <strong>encore ouverte</strong> : les chiffres ci-dessous sont provisoires et ne valent pas rapport Z.
    </div>
{% endif %}

{# ---- Indicateurs clés ---- #}
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    {% set cartes = [
        { titre: 'CA total',      valeur: fmt.fcfa(rapport.caTotal) },
        { titre: 'Tickets',       valeur: rapport.nombreTickets },
        { titre: 'Panier moyen',  valeur: fmt.fcfa(rapport.panierMoyen) },
        { titre: 'Écart de caisse', valeur: rapport.ecart is null ? '—' : (rapport.ecart > 0 ? '+' : '') ~ fmt.fcfa(rapport.ecart) },
    ] %}
    {% for carte in cartes %}
        <div class="bg-white rounded-xl shadow-sm p-5">
            <div class="text-xs uppercase tracking-wide text-stone-400">{{ carte.titre }}</div>
            <div class="mt-1 text-2xl font-black tabular-nums text-stone-900">{{ carte.valeur }}</div>
        </div>
    {% endfor %}
</div>

<div class="grid gap-6 lg:grid-cols-2">

    {# ---- Fond de caisse et écart ---- #}
    <div class="bg-white rounded-xl shadow-sm p-5">
        <h2 class="font-semibold text-stone-800 mb-4">Fond de caisse</h2>
        <dl class="space-y-2 text-sm">
            <div class="flex justify-between"><dt class="text-stone-500">Fond d'ouverture</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.fondCaisse) }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">+ Espèces encaissées</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.especesEncaissees) }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">− Dépenses</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.depenses) }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">− Sorties de caisse</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.sorties) }}</dd></div>
            <div class="flex justify-between border-t border-stone-200 pt-2 font-semibold"><dt>= Théorique</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.theorique) }}</dd></div>
            {% if rapport.montantCompte is not null %}
                <div class="flex justify-between"><dt class="text-stone-500">Compté</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.montantCompte) }}</dd></div>
                <div class="flex justify-between border-t-2 border-stone-300 pt-2 text-base font-black
                            {{ rapport.ecart == 0 ? 'text-green-700' : (rapport.ecart > 0 ? 'text-amber-600' : 'text-red-600') }}">
                    <dt>Écart</dt><dd class="tabular-nums">{{ rapport.ecart > 0 ? '+' }}{{ fmt.fcfa(rapport.ecart) }}</dd>
                </div>
            {% endif %}
        </dl>

        {% if rapport.session.commentaireCloture %}
            <div class="mt-4 rounded-lg bg-stone-50 border border-stone-200 px-3 py-2 text-sm text-stone-700">
                <span class="font-semibold">Commentaire de clôture :</span> {{ rapport.session.commentaireCloture }}
            </div>
        {% endif %}
    </div>

    {# ---- Ventilation par mode de règlement ---- #}
    <div class="bg-white rounded-xl shadow-sm p-5">
        <h2 class="font-semibold text-stone-800 mb-4">Par mode de règlement</h2>
        <table class="w-full text-sm">
            <tbody>
                {% for ligne in rapport.parReglement %}
                    <tr class="border-b border-stone-100 last:border-0">
                        <td class="py-2 font-medium text-stone-700">{{ ligne.libelle }}</td>
                        <td class="py-2 text-right text-stone-500 tabular-nums">{{ ligne.nombre }}</td>
                        <td class="py-2 text-right font-semibold tabular-nums">{{ fmt.fcfa(ligne.montant) }}</td>
                    </tr>
                {% else %}
                    <tr><td class="py-4 text-center text-stone-400">Aucun règlement.</td></tr>
                {% endfor %}
            </tbody>
        </table>
        {% if rapport.renduTotal > 0 %}
            <p class="mt-3 text-xs text-stone-400">Rendu de monnaie déduit de la ligne espèces : {{ fmt.fcfa(rapport.renduTotal) }}.</p>
        {% endif %}
    </div>

    {# ---- Ventilation par famille ---- #}
    <div class="bg-white rounded-xl shadow-sm p-5">
        <h2 class="font-semibold text-stone-800 mb-4">Par famille</h2>
        <table class="w-full text-sm">
            <tbody>
                {% for ligne in rapport.parFamille %}
                    <tr class="border-b border-stone-100 last:border-0">
                        <td class="py-2 font-medium text-stone-700">{{ ligne.famille }}</td>
                        <td class="py-2 text-right text-stone-500 tabular-nums">{{ fmt.unites(ligne.quantite) }}</td>
                        <td class="py-2 text-right font-semibold tabular-nums">{{ fmt.fcfa(ligne.montant) }}</td>
                    </tr>
                {% else %}
                    <tr><td class="py-4 text-center text-stone-400">Aucune vente.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ---- Remises, annulations, mouvements ---- #}
    <div class="bg-white rounded-xl shadow-sm p-5">
        <h2 class="font-semibold text-stone-800 mb-4">Remises, annulations et sorties</h2>
        <dl class="space-y-2 text-sm">
            <div class="flex justify-between"><dt class="text-stone-500">Remises accordées ({{ rapport.remisesNombre }})</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.remisesMontant) }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">Ventes annulées ({{ rapport.annulationsNombre }})</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.annulationsMontant) }}</dd></div>
        </dl>

        <h3 class="mt-5 mb-2 text-sm font-semibold text-stone-600">Dépenses et sorties</h3>
        <ul class="divide-y divide-stone-100 text-sm">
            {% for mouvement in rapport.mouvements %}
                <li class="flex items-start justify-between gap-3 py-2">
                    <div class="min-w-0">
                        <span class="font-medium text-stone-700">{{ mouvement.libelle }}</span>
                        {% if mouvement.commentaire %}<span class="text-stone-500"> — {{ mouvement.commentaire }}</span>{% endif %}
                        <div class="text-xs text-stone-400">{{ mouvement.createdAt|date('d/m H:i') }} — {{ mouvement.utilisateur.nom }}</div>
                    </div>
                    <span class="shrink-0 font-semibold tabular-nums text-red-600">− {{ fmt.fcfa(mouvement.montant) }}</span>
                </li>
            {% else %}
                <li class="py-3 text-center text-stone-400">Aucune sortie d'espèces.</li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}
