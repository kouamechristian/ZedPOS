{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}{{ rapport.definitif ? 'Rapport Z' : 'Session en cours' }} — {{ rapport.session.utilisateur.nom }}{% endblock %}
{% block page_sous_titre %}Session n° {{ rapport.session.id }}, ouverte le {{ rapport.session.ouvertureAt|date('d/m/Y à H:i') }}{% if rapport.session.clotureAt %}, clôturée le {{ rapport.session.clotureAt|date('d/m/Y à H:i') }}{% endif %}.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_clotures') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Clôtures</a>
    <a href="{{ path('app_caisse_rapport_z', {id: rapport.session.id}) }}" target="_blank"
       class="btn btn-primaire">{{ ui.icone('imprimer') }} Imprimer (58 mm)</a>
{% endblock %}

{% block admin_content %}
{% if not rapport.definitif %}
    <div class="alerte alerte-bleu apparition mb-5">
        {{ ui.icone('info') }}
        <div>Cette session est <strong>encore ouverte</strong> : les chiffres ci-dessous sont provisoires et ne valent pas rapport Z.</div>
    </div>
{% endif %}

{# ---- Indicateurs clés ---- #}
{% set ecartTon = rapport.ecart is null ? '' : (rapport.ecart == 0 ? 'kpi-icone-vert' : 'kpi-icone-rouge') %}
<section class="mb-5 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {% set cartes = [
        { titre: 'CA total',        valeur: fmt.fcfa(rapport.caTotal),     icone: 'argent',  ton: '' },
        { titre: 'Tickets',         valeur: rapport.nombreTickets,         icone: 'ventes',  ton: '' },
        { titre: 'Panier moyen',    valeur: fmt.fcfa(rapport.panierMoyen), icone: 'panier',  ton: '' },
        { titre: 'Écart de caisse', valeur: rapport.ecart is null ? '—' : (rapport.ecart > 0 ? '+' : '') ~ fmt.fcfa(rapport.ecart), icone: rapport.ecart == 0 ? 'valide' : 'pertes', ton: ecartTon },
    ] %}
    {% for carte in cartes %}
        <article class="kpi apparition" style="--i: {{ loop.index }}">
            <div class="kpi-tete">
                <span class="kpi-libelle">{{ carte.titre }}</span>
                <span class="kpi-icone {{ carte.ton }}">{{ ui.icone(carte.icone) }}</span>
            </div>
            <div class="kpi-valeur">{{ carte.valeur }}</div>
        </article>
    {% endfor %}
</section>

<div class="grid gap-5 lg:grid-cols-2">

    {# ---- Fond de caisse et écart ---- #}
    <section class="carte apparition" style="--i: 5">
        <div class="carte-entete"><h2 class="carte-titre">Fond de caisse</h2></div>
        <dl class="carte-corps space-y-2.5 text-sm">
            <div class="flex justify-between"><dt class="text-stone-500">Fond d'ouverture</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.fondCaisse) }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">+ Espèces encaissées</dt><dd class="tabular-nums text-green-700">{{ fmt.fcfa(rapport.especesEncaissees) }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">− Dépenses</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.depenses) }}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">− Sorties de caisse</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.sorties) }}</dd></div>
            <div class="flex justify-between border-t border-stone-100 pt-2.5 font-semibold text-stone-900"><dt>= Théorique</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.theorique) }}</dd></div>
            {% if rapport.montantCompte is not null %}
                <div class="flex justify-between"><dt class="text-stone-500">Compté</dt><dd class="tabular-nums">{{ fmt.fcfa(rapport.montantCompte) }}</dd></div>
                <div class="flex items-center justify-between rounded-xl px-3 py-2.5 text-base font-bold
                            {{ rapport.ecart == 0 ? 'bg-green-50 text-green-800' : (rapport.ecart > 0 ? 'bg-amber-50 text-amber-800' : 'bg-red-50 text-red-700') }}">
                    <dt>Écart</dt><dd class="tabular-nums">{{ rapport.ecart > 0 ? '+' }}{{ fmt.fcfa(rapport.ecart) }}</dd>
                </div>
            {% endif %}
        </dl>

        {% if rapport.session.commentaireCloture %}
            <div class="mx-5 mb-5 rounded-xl bg-stone-50 px-4 py-3 text-sm text-stone-700 ring-1 ring-stone-100">
                <span class="font-semibold">Commentaire de clôture :</span> {{ rapport.session.commentaireCloture }}
            </div>
        {% endif %}
    </section>

    {# ---- Ventilation par mode de règlement ---- #}
    <section class="carte apparition" style="--i: 6">
        <div class="carte-entete"><h2 class="carte-titre">Par mode de règlement</h2></div>
        <div class="carte-corps">
            <ul class="space-y-3">
                {% for ligne in rapport.parReglement %}
                    {% set part = rapport.caTotal > 0 ? (ligne.montant * 100 // rapport.caTotal) : 0 %}
                    <li>
                        <div class="flex items-baseline justify-between gap-3 text-sm">
                            <span class="font-medium text-stone-700">{{ ligne.libelle }} <span class="text-xs text-stone-400">× {{ ligne.nombre }}</span></span>
                            <span class="font-semibold tabular-nums text-stone-900">{{ fmt.fcfa(ligne.montant) }}</span>
                        </div>
                        <div class="mt-1.5 flex items-center gap-2">
                            <div class="jauge"><span style="width: {{ part }}%"></span></div>
                            <span class="w-9 text-right text-xs tabular-nums text-stone-400">{{ part }} %</span>
                        </div>
                    </li>
                {% else %}
                    <li class="py-4 text-center text-sm text-stone-400">Aucun règlement.</li>
                {% endfor %}
            </ul>
            {% if rapport.renduTotal > 0 %}
                <p class="aide mt-4">Rendu de monnaie déduit de la ligne espèces : {{ fmt.fcfa(rapport.renduTotal) }}.</p>
            {% endif %}
        </div>
    </section>

    {# ---- Ventilation par famille ---- #}
    <section class="carte apparition" style="--i: 7">
        <div class="carte-entete"><h2 class="carte-titre">Par famille</h2></div>
        <table class="tableau">
            <tbody>
                {% for ligne in rapport.parFamille %}
                    <tr>
                        <td class="cellule-principale">{{ ligne.famille }}</td>
                        <td class="num cellule-douce">{{ fmt.unites(ligne.quantite) }}</td>
                        <td class="num font-semibold">{{ fmt.fcfa(ligne.montant) }}</td>
                    </tr>
                {% else %}
                    <tr><td class="cellule-vide">Aucune vente.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    {# ---- Remises, annulations, mouvements ---- #}
    <section class="carte apparition" style="--i: 8">
        <div class="carte-entete"><h2 class="carte-titre">Remises, annulations et sorties</h2></div>
        <div class="carte-corps">
            <dl class="grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-xl bg-amber-50 px-3 py-2.5 ring-1 ring-amber-100">
                    <dt class="text-xs text-amber-800">Remises accordées ({{ rapport.remisesNombre }})</dt>
                    <dd class="mt-0.5 font-semibold tabular-nums text-amber-900">{{ fmt.fcfa(rapport.remisesMontant) }}</dd>
                </div>
                <div class="rounded-xl bg-red-50 px-3 py-2.5 ring-1 ring-red-100">
                    <dt class="text-xs text-red-700">Ventes annulées ({{ rapport.annulationsNombre }})</dt>
                    <dd class="mt-0.5 font-semibold tabular-nums text-red-800">{{ fmt.fcfa(rapport.annulationsMontant) }}</dd>
                </div>
            </dl>

            <h3 class="mb-2 mt-5 text-sm font-semibold text-stone-700">Dépenses et sorties</h3>
            <ul class="divide-y divide-stone-100 text-sm">
                {% for mouvement in rapport.mouvements %}
                    <li class="flex items-start justify-between gap-3 py-2.5">
                        <div class="min-w-0">
                            <span class="font-medium text-stone-800">{{ mouvement.libelle }}</span>
                            {% if mouvement.commentaire %}<span class="text-stone-500"> — {{ mouvement.commentaire }}</span>{% endif %}
                            <div class="text-xs text-stone-400">{{ mouvement.createdAt|date('d/m H:i') }} — {{ mouvement.utilisateur.nom }}</div>
                        </div>
                        <span class="shrink-0 font-semibold tabular-nums text-red-600">− {{ fmt.fcfa(mouvement.montant) }}</span>
                    </li>
                {% else %}
                    <li class="py-3 text-center text-stone-400">Aucune sortie d'espèces.</li>
                {% endfor %}
            </ul>
        </div>
    </section>
</div>
{% endblock %}
