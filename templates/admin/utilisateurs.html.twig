{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Utilisateurs{% endblock %}

{% block page_actions %}
    {# Gérant et dirigeante créent des comptes. Ce qui les sépare n'est pas ce
       bouton mais la liste des rôles qu'il ouvre : « Dirigeante » n'y figure que
       pour la dirigeante. #}
    {% if is_granted(constant('App\\Security\\Permission::UTILISATEUR_GERER')) %}
        <a href="{{ path('admin_utilisateur_new') }}" class="rounded-lg bg-stone-800 text-white px-3 py-2 text-sm font-semibold hover:bg-stone-700">+ Nouvel utilisateur</a>
    {% endif %}
{% endblock %}

{% block admin_content %}

{{ recherche.barre('admin_utilisateurs', 'Nom, e-mail ou rôle') }}
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="text-left text-stone-500 bg-stone-50">
            <tr>
                <th class="px-5 py-3 font-medium">Nom</th>
                <th class="px-5 py-3 font-medium">E-mail</th>
                <th class="px-5 py-3 font-medium">Rôles</th>
                <th class="px-5 py-3 font-medium">Statut</th>
                <th class="px-5 py-3"></th>
            </tr>
        </thead>
        <tbody>
            {% for utilisateur in utilisateurs.items %}
                <tr class="border-t border-stone-100 hover:bg-stone-50">
                    <td class="px-5 py-3 font-medium text-stone-800">{{ utilisateur.nom }}</td>
                    <td class="px-5 py-3 text-stone-600">{{ utilisateur.email }}</td>
                    <td class="px-5 py-3">
                        {% for role in utilisateur.roles %}
                            {% if role != 'ROLE_USER' %}
                                <span class="inline-flex rounded-full bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-700">{{ role|replace({'ROLE_': ''})|capitalize }}</span>
                            {% endif %}
                        {% endfor %}
                    </td>
                    <td class="px-5 py-3">{{ fmt.badge(utilisateur.actif) }}</td>
                    <td class="px-5 py-3">
                        {# La permission porte sur **ce** compte : les actions
                           disparaissent pour un gérant en face d'une dirigeante,
                           exactement comme les routes le refuseraient. #}
                        {% if is_granted(constant('App\\Security\\Permission::UTILISATEUR_GERER'), utilisateur) %}
                            <div class="flex items-center justify-end gap-2">
                                <a href="{{ path('admin_utilisateur_edit', {id: utilisateur.id}) }}"
                                   class="rounded-lg border border-stone-300 px-3 py-1.5 text-xs font-medium hover:bg-stone-100">
                                    Modifier
                                </a>
                                {# Se désactiver soi-même reviendrait à se mettre
                                   dehors : l'action n'est pas proposée. #}
                                {% if utilisateur != app.user %}
                                    <form method="post" action="{{ path('admin_utilisateur_toggle', {id: utilisateur.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('basculer_utilisateur_' ~ utilisateur.id) }}">
                                        <button class="rounded-lg border border-stone-300 px-3 py-1.5 text-xs font-medium hover:bg-stone-100">
                                            {{ utilisateur.actif ? 'Désactiver' : 'Activer' }}
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="px-5 py-6 text-center text-stone-400">Aucun utilisateur.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{{ pagination.barre(utilisateurs, 'admin_utilisateurs') }}
<p class="mt-3 text-xs text-stone-400">
    Les comptes se créent depuis cet écran, ou en console avec
    <code class="bg-stone-100 px-1 rounded">app:creer-utilisateur</code>.
    Créations et changements de statut sont tracés au journal d'audit.
</p>
{% endblock %}
