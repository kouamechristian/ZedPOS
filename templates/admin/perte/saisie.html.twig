{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}Saisir une perte{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_pertes') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Synthèse</a>
{% endblock %}

{% block admin_content %}
<div class="carte apparition max-w-2xl">
    {{ form_start(form) }}
    <div class="carte-corps">
        <div class="alerte alerte-ambre mb-5">
            {{ ui.icone('info') }}
            <p>Sélectionnez une <strong>matière première</strong> ou un <strong>article</strong>, la quantité perdue et le motif. La valorisation est calculée automatiquement au coût moyen pondéré.</p>
        </div>

        <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
            {{ form_row(form.matierePremiere) }}
            {{ form_row(form.article) }}
            {{ form_row(form.quantite) }}
            {{ form_row(form.motif) }}
        </div>
        {{ form_row(form.commentaire) }}
    </div>

    <div class="carte-pied">
        <button class="btn btn-danger-plein btn-lg">{{ ui.icone('pertes') }} Enregistrer la perte</button>
        <a href="{{ path('admin_pertes') }}" class="btn btn-fantome">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
