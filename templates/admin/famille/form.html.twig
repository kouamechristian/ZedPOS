{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block page_title %}{{ titre }}{% endblock %}

{% block admin_content %}
<div class="max-w-lg bg-white rounded-xl shadow-sm p-6">
    {{ form_start(form) }}
    {{ form_row(form.nom) }}
    <div class="grid grid-cols-2 gap-x-5">
        {{ form_row(form.couleur) }}
        {{ form_row(form.position) }}
    </div>
    {{ form_row(form.actif) }}
    {{ form_row(form.compteVente) }}
    <div class="mt-6 flex items-center gap-3">
        <button class="rounded-lg bg-stone-800 text-white px-4 py-2 text-sm font-semibold hover:bg-stone-700">Enregistrer</button>
        <a href="{{ path('admin_famille_index') }}" class="rounded-lg border border-stone-300 px-4 py-2 text-sm hover:bg-stone-50">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
