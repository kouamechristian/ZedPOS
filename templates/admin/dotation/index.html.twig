{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}
{% import '_pagination.html.twig' as pagination %}
{% import 'admin/_recherche.html.twig' as recherche %}

{% block page_title %}Dotations{% endblock %}
{% block page_sous_titre %}La marchandise confiée aux vendeurs des stands, bon par bon.{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_stand_index') }}" class="btn btn-secondaire">Stands</a>
    <a href="{{ path('admin_dotation_new') }}" class="btn btn-primaire btn-lg">{{ ui.icone('plus') }} Nouvelle dotation</a>
{% endblock %}

{% block admin_content %}
{{ recherche.barre('admin_dotation_index', 'Numéro, stand ou vendeur') }}
<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau">
        <thead>
            <tr>
                <th>Bon</th>
                <th>Date</th>
                <th>Stand</th>
                <th>Vendeur</th>
                <th>Statut</th>
                <th class="num">Net si tout vendu</th>
                <th class="num">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for bon in bons.items %}
                <tr>
                    <td><a href="{{ path('admin_dotation_show', {id: bon.id}) }}" class="cellule-principale lien">{{ bon.numero }}</a></td>
                    <td class="cellule-douce tabular-nums">{{ bon.dateDotation|date('d/m/Y') }}</td>
                    <td>{{ bon.stand.libelle }}</td>
                    <td>{{ bon.vendeur.nom }}</td>
                    <td>{{ include('admin/dotation/_statut.html.twig', {bon: bon}) }}</td>
                    <td class="num tabular-nums">{{ fmt.fcfa(bon.netSiToutVendu) }}</td>
                    <td>
                        <div class="actions-ligne">
                            {% if bon.estBrouillon %}
                                <a href="{{ path('admin_dotation_edit', {id: bon.id}) }}" class="btn btn-sm btn-secondaire">{{ ui.icone('modifier') }} Reprendre</a>
                            {% endif %}
                            <a href="{{ path('admin_dotation_impression', {id: bon.id}) }}" class="btn btn-sm btn-fantome btn-icone" title="Imprimer le bon" aria-label="Imprimer le bon" target="_blank" data-turbo="false">{{ ui.icone('imprimer') }}</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="cellule-vide">Aucun bon de dotation.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{{ pagination.barre(bons, 'admin_dotation_index') }}
{% endblock %}
