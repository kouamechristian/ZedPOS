{% extends 'base.html.twig' %}

{# Le nom vient de /admin/parametres, jamais du gabarit : l'onglet du navigateur
   porte le nom de l'établissement, pas celui du logiciel. #}
{% block title %}{% block page_title %}Administration{% endblock %} — {{ nom_boutique() }}{% endblock %}

{% set nav = [
    { label: 'Tableau de bord', route: 'admin_dashboard',    match: 'admin_dashboard',    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
    { label: 'Ventes',          route: 'admin_ventes',       match: 'admin_ventes',       icon: 'M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z' },
    { label: 'Articles',        route: 'admin_article_index',match: 'admin_article',      icon: 'M7 7h.01M7 3h5a1.99 1.99 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.99 1.99 0 013 12V7a4 4 0 014-4z' },
    { label: 'Stock',           route: 'admin_matiere_index',match: 'admin_matiere',      icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
    { label: 'Inventaire',      route: 'admin_inventaires',  match: 'admin_inventaire',   icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
    { label: 'Production',      route: 'admin_production',   match: 'admin_production',    icon:'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
    { label: 'Pertes',         route: 'admin_pertes',       match: 'admin_pertes',       icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' },
    { label: 'Clôtures',       route: 'admin_clotures',     match: 'admin_clotures',     icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z' },
    { label: 'Comptabilité',   route: 'app_comptabilite',   match: 'app_comptabilite',   icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
    { label: 'Utilisateurs',   route: 'admin_utilisateurs', match: 'admin_utilisateurs', icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 00-3-3.87M9 12a4 4 0 100-8 4 4 0 000 8z' },
    { label: 'Paramètres',     route: 'admin_parametres',   match: 'admin_parametres',   icon: 'M3 6h18M3 12h18M3 18h18M7 4v4M15 10v4M11 16v4' },
] %}
{% set current = app.request.attributes.get('_route') %}

{% block body %}
<div class="min-h-screen flex bg-amber-50 text-stone-800">
    {# Barre latérale « croûte » : brun profond, liseré ambre sur l'entrée active. #}
    <aside class="w-60 shrink-0 bg-stone-900 text-stone-300 flex flex-col">
        <div class="px-5 py-5 border-b border-stone-800/80">
            <div class="flex items-center gap-2.5">
                {# Le logo saisi dans /admin/parametres s'il existe, sinon la
                   pastille « Z » : un back-office sans logo ne doit pas s'ouvrir
                   sur un trou dans sa barre latérale.

                   Variable nommée `logo_entete` et non `logo` : `admin/parametres`
                   reçoit de son contrôleur un `logo` à lui, et il est rendu à
                   l'intérieur de ce bloc — les deux valeurs se valent aujourd'hui,
                   les confondre serait un piège pour demain. #}
                {% set logo_entete = logo_boutique() %}
                {% if logo_entete %}
                    <img src="{{ logo_entete }}" alt="" class="h-9 w-9 shrink-0 rounded-lg bg-white object-contain" onerror="this.remove()">
                {% else %}
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-amber-500 text-stone-900 text-sm font-black">Z</span>
                {% endif %}
                {# Le nom peut faire deux mots longs (« DELICES DU CAMPUS ») dans une
                   barre de 240 px : il passe donc à la ligne au lieu d'être coupé.
                   Tronquer le nom de la boutique dans son propre back-office serait
                   le seul texte de l'écran qu'on ne pourrait pas lire en entier. #}
                <div class="min-w-0 leading-tight">
                    <div class="titre text-base font-bold text-white break-words">{{ nom_boutique() }}</div>
                    <div class="text-[11px] uppercase tracking-widest text-amber-500/80">Back-office</div>
                </div>
            </div>
        </div>

        {# Préchargement au survol : la page suivante est déjà en mémoire au clic. #}
        <nav class="flex-1 p-3 space-y-0.5 text-sm" data-turbo-prefetch="true">
            {% for item in nav %}
                {% set actif = current starts with item.match %}
                <a href="{{ path(item.route) }}"
                   class="relative flex items-center gap-3 px-3 py-2.5 rounded-lg transition
                          {{ actif
                             ? 'bg-stone-800 text-white font-semibold'
                             : 'text-stone-400 hover:bg-stone-800/60 hover:text-white' }}">
                    {% if actif %}
                        <span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-r bg-amber-500"></span>
                    {% endif %}
                    <svg class="h-5 w-5 shrink-0 {{ actif ? 'text-amber-500' : '' }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="{{ item.icon }}"/>
                    </svg>
                    {{ item.label }}
                </a>
            {% endfor %}
        </nav>

        <div class="p-4 border-t border-stone-800/80 text-xs">
            {% if app.user %}
                <div class="text-stone-200 font-medium">{{ app.user.nom }}</div>
                <div class="text-stone-500 truncate">{{ app.user.email }}</div>
            {% endif %}
            <a href="{{ path('app_logout') }}" class="mt-2 inline-block text-stone-400 hover:text-amber-400 underline">Déconnexion</a>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white/80 backdrop-blur border-b border-amber-200/70 px-6 py-4 flex items-center justify-between gap-4">
            <h1 class="titre text-2xl font-bold text-stone-900">{{ block('page_title') }}</h1>
            <div class="flex items-center gap-2">{% block page_actions %}{% endblock %}</div>
        </header>

        <main class="flex-1 p-6 min-w-0">
            {% set sousSeuil = alertesStock.matieresSousSeuil %}
            {% if sousSeuil is not empty %}
                <div class="mb-4 rounded-lg bg-amber-50 border border-amber-300 px-4 py-3 text-sm text-amber-900">
                    <span class="font-semibold">⚠ Stock bas :</span>
                    {{ sousSeuil|length }} matière(s) sous le seuil —
                    {% for matiere in sousSeuil|slice(0, 4) %}{{ matiere.nom }}{{ not loop.last ? ', ' }}{% endfor %}{% if sousSeuil|length > 4 %}…{% endif %}
                    <a href="{{ path('admin_matiere_index') }}" class="ml-1 font-medium underline">voir le stock</a>
                </div>
            {% endif %}

            {% for type, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}
                    <div class="mb-4 rounded-lg px-4 py-3 text-sm {{ type == 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}
