{% extends 'base.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{# Le nom vient de /admin/parametres, jamais du gabarit : l'onglet du navigateur
   porte le nom de l'établissement, pas celui du logiciel. #}
{% block title %}{% block page_title %}Administration{% endblock %} — {{ nom_boutique() }}{% endblock %}

{# Navigation en trois groupes. `match` liste les préfixes de route qui allument
   l'entrée : les familles appartiennent aux articles, les fournisseurs au stock —
   sans quoi la barre n'indiquerait plus où l'on est dès qu'on descend d'un niveau.
   `role` restreint une entrée ; la barre et la palette ⌘K lisent la même liste,
   ce qu'on ne peut pas ouvrir n'apparaît donc nulle part. Un groupe dont aucune
   entrée n'est visible disparaît avec son titre.

   Les entrées hors Magasin portent au minimum ROLE_GERANT : le magasinier
   (ROLE_MAGASIN) partage cette coquille mais ne voit que la section « Magasin »,
   ouverte par MAGASIN_VOIR.

   « Catalogue et stock » et « Administration » sont réservés à la dirigeante, à
   la demande de l'exploitante : la gérante ne les voit plus dans le menu, et
   `access_control` (security.yaml) lui en ferme aussi les URL. #}
{% set groupes = [
    { titre: 'Activité', entrees: [
        { label: 'Tableau de bord', route: 'admin_dashboard',     match: ['admin_dashboard'],                   icone: 'accueil', role: 'ROLE_GERANT' },
        { label: 'Ventes',          route: 'admin_ventes',        match: ['admin_ventes'],                      icone: 'ventes', role: 'ROLE_GERANT' },
        { label: 'Clôtures',        route: 'admin_clotures',      match: ['admin_cloture'],                     icone: 'clotures', role: 'ROLE_GERANT' },
    ]},
    { titre: 'Catalogue et stock', entrees: [
        { label: 'Articles',        route: 'admin_article_index', match: ['admin_article', 'admin_famille'],    icone: 'articles', role: 'ROLE_DIRIGEANTE' },
        { label: 'Stock',           route: 'admin_matiere_index', match: ['admin_matiere', 'admin_fournisseur'], icone: 'stock', role: 'ROLE_DIRIGEANTE' },
        { label: 'Inventaire',      route: 'admin_inventaires',   match: ['admin_inventaire'],                  icone: 'inventaire', role: 'ROLE_DIRIGEANTE' },
        { label: 'Production',      route: 'admin_production',    match: ['admin_production'],                  icone: 'production', role: 'ROLE_DIRIGEANTE' },
        { label: 'Pertes',          route: 'admin_pertes',        match: ['admin_perte'],                       icone: 'pertes', role: 'ROLE_DIRIGEANTE' },
    ]},
    { titre: 'Magasin', entrees: [
        { label: 'Tableau de bord', route: 'magasin_tableau_de_bord',  match: ['magasin_tableau_de_bord'], icone: 'accueil', role: 'MAGASIN_VOIR' },
        { label: 'Réceptions',      route: 'magasin_reception_index',   match: ['magasin_reception'],   icone: 'fournisseurs', role: 'MAGASIN_VOIR' },
        { label: 'Sorties',         route: 'magasin_sortie_index',      match: ['magasin_sortie'],      icone: 'document', role: 'MAGASIN_VOIR' },
        { label: 'Stock magasin',   route: 'magasin_stock_index',       match: ['magasin_stock'],       icone: 'stock', role: 'MAGASIN_VOIR' },
        { label: 'Analyse',         route: 'magasin_analyse',           match: ['magasin_analyse', 'magasin_fiche_stock'], icone: 'pilotage', role: 'MAGASIN_VOIR' },
        { label: 'Inventaires',     route: 'magasin_inventaire_index',  match: ['magasin_inventaire'],  icone: 'inventaire', role: 'MAGASIN_VOIR' },
        { label: 'Produits',        route: 'magasin_produit_index',     match: ['magasin_produit'],     icone: 'articles', role: 'MAGASIN_VOIR' },
        { label: 'Emplacements',    route: 'magasin_emplacement_index', match: ['magasin_emplacement'], icone: 'filtre', role: 'MAGASIN_VOIR' },
    ]},
    { titre: 'Production et vitrine', entrees: [
        { label: 'Fiche de production', route: 'app_atelier',          match: ['app_atelier'],                      icone: 'production', role: 'ROLE_GERANT' },
    ]},
    { titre: 'Revendeurs', entrees: [
        { label: 'Dotations',       route: 'admin_dotation_index', match: ['admin_dotation'],                   icone: 'fournisseurs', role: 'ROLE_GERANT' },
        { label: 'Points',          route: 'admin_point_index',    match: ['admin_point'],                      icone: 'clotures', role: 'ROLE_GERANT' },
        { label: 'Rapports',        route: 'admin_rapport_stand',  match: ['admin_rapport_stand'],              icone: 'pilotage', role: 'ROLE_GERANT' },
        { label: 'Stands',          route: 'admin_stand_index',    match: ['admin_stand', 'admin_vendeur'],      icone: 'accueil', role: 'ROLE_GERANT' },
    ]},
    { titre: 'Administration', entrees: [
        { label: 'Comptabilité',    route: 'app_comptabilite',    match: ['app_comptabilite'],                  icone: 'comptabilite', role: 'ROLE_DIRIGEANTE' },
        { label: 'Utilisateurs',    route: 'admin_utilisateurs',  match: ['admin_utilisateur'],                 icone: 'utilisateurs', role: 'ROLE_DIRIGEANTE' },
        { label: 'Paramètres',      route: 'admin_parametres',    match: ['admin_parametres'],                  icone: 'parametres', role: 'ROLE_DIRIGEANTE' },
        { label: 'Pilotage',        route: 'app_pilotage',        match: ['app_pilotage'],                      icone: 'pilotage', role: 'ROLE_DIRIGEANTE' },
    ]},
] %}
{% set current = app.request.attributes.get('_route') %}

{% block body %}
{# Groupe et entrée de la page courante : ils nourrissent le fil d'Ariane et le
   sur-titre de l'en-tête. #}
{% set groupe_courant = null %}
{% set entree_courante = null %}
{% for groupe in groupes %}
    {% for entree in groupe.entrees %}
        {% if entree_courante is null and entree.match|filter(prefixe => current starts with prefixe)|length > 0 %}
            {% set groupe_courant = groupe.titre %}
            {% set entree_courante = entree.label %}
        {% endif %}
    {% endfor %}
{% endfor %}

{# Barre repliée : lue dans un cookie et rendue ici, côté serveur — appliquée en
   JavaScript après coup, elle se déplierait puis se replierait à chaque clic. #}
{% set replie = app.request.cookies.get('zp_barre_repliee') == '1' %}
{% set nom_utilisateur = app.user ? app.user.nom : '' %}
{% set initiales = nom_utilisateur|split(' ')|filter(mot => mot is not empty)|slice(0, 2)|map(mot => mot|first|upper)|join('') %}

<div class="espace-gestion">
<div class="coquille" data-controller="coquille palette" {{ replie ? 'data-replie' }}>

    {# ======================= Barre latérale ======================= #}
    <aside class="barre-laterale" aria-label="Navigation du back-office">
        <div class="marque">
            {# Le logo saisi dans /admin/parametres s'il existe, sinon la pastille
               « Z » : un back-office sans logo ne doit pas s'ouvrir sur un trou.

               Variable nommée `logo_entete` et non `logo` : `admin/parametres`
               reçoit de son contrôleur un `logo` à lui, et il est rendu à
               l'intérieur de ce bloc. #}
            {% set logo_entete = logo_boutique() %}
            {% if logo_entete %}
                <img src="{{ logo_entete }}" alt="" class="marque-logo" onerror="this.remove()">
            {% else %}
                <span class="marque-pastille">Z</span>
            {% endif %}
            {# Le nom passe à la ligne au lieu d'être coupé : tronquer le nom de la
               boutique dans son propre back-office serait le seul texte de l'écran
               qu'on ne pourrait pas lire en entier. #}
            <div class="masque-replie min-w-0 flex-1 leading-tight">
                <div class="break-words text-[15px] font-bold tracking-tight text-stone-900">{{ nom_boutique() }}</div>
                <div class="mt-0.5 text-[10.5px] font-semibold uppercase tracking-[.14em] text-amber-700">Back-office</div>
            </div>
            <button type="button" class="btn btn-fantome btn-sm btn-icone lg:hidden"
                    data-action="coquille#fermer" aria-label="Fermer le menu">
                {{ ui.icone('fermer', 'h-4 w-4') }}
            </button>
        </div>

        {# Préchargement au survol : la page suivante est déjà en mémoire au clic.
           **Un seul** <nav> préchargé sur la page : `TurboNavigationTest` le fige. #}
        {# Compteur rouge sur « Stock magasin » : les produits au seuil d'alerte. #}
        {% set compteurs = is_granted('MAGASIN_VOIR') ? {magasin_stock_index: magasin_alertes()|length} : {} %}
        <nav class="flex-1 overflow-y-auto overflow-x-hidden pb-3" data-turbo-prefetch="true">
            {% for groupe in groupes %}
                {% set visibles = groupe.entrees|filter(entree => entree.role is not defined or is_granted(entree.role)) %}
                {% if visibles is not empty %}
                    <div class="nav-groupe">{{ groupe.titre }}</div>
                    {% for entree in visibles %}
                        {% set actif = entree.match|filter(prefixe => current starts with prefixe)|length > 0 %}
                        <a href="{{ path(entree.route) }}" class="lien-nav" title="{{ entree.label }}"
                           {% if actif %}aria-current="page"{% endif %}>
                            {{ ui.icone(entree.icone) }}
                            <span class="masque-replie">{{ entree.label }}</span>
                            {% if (compteurs[entree.route] ?? 0) > 0 %}
                                <span class="badge badge-rouge masque-replie ml-auto" data-compteur-seuil title="Produits au seuil d'alerte">{{ compteurs[entree.route] }}</span>
                            {% endif %}
                        </a>
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </nav>

        <div class="border-t border-stone-100 py-3">
            <button type="button" class="lien-nav w-[calc(100%-1.5rem)] max-lg:hidden"
                    data-action="coquille#replier" title="Réduire ou déplier le menu">
                <span class="icone-replier">{{ ui.icone('replier') }}</span>
                <span class="masque-replie">Réduire le menu</span>
            </button>
            <a href="{{ path('app_logout') }}" class="lien-nav" title="Déconnexion">
                {{ ui.icone('deconnexion') }}
                <span class="masque-replie">Déconnexion</span>
            </a>
        </div>
    </aside>

    <div class="voile-tiroir" data-action="click->coquille#fermer"></div>

    {# ======================= Colonne principale ======================= #}
    <div class="flex min-w-0 flex-col">
        <header class="barre-haute">
            <button type="button" class="btn btn-fantome btn-icone lg:hidden"
                    data-action="coquille#ouvrir" aria-label="Ouvrir le menu">
                {{ ui.icone('menu') }}
            </button>

            <div class="fil">
                <span class="hidden sm:inline">{{ nom_boutique() }}</span>
                {% if groupe_courant %}
                    <span class="hidden sm:inline text-stone-300">{{ ui.icone('chevron', 'h-3.5 w-3.5') }}</span>
                    <span class="hidden md:inline">{{ groupe_courant }}</span>
                    <span class="hidden md:inline text-stone-300">{{ ui.icone('chevron', 'h-3.5 w-3.5') }}</span>
                    <strong class="truncate">{{ entree_courante }}</strong>
                {% endif %}
            </div>

            <div class="ml-auto flex items-center gap-2">
                <button type="button" class="declencheur-palette max-sm:hidden" data-action="palette#ouvrir">
                    {{ ui.icone('recherche', 'h-4 w-4') }}
                    <span>Aller à…</span>
                    <kbd class="touche-clavier">Ctrl K</kbd>
                </button>
                <button type="button" class="btn btn-fantome btn-icone sm:hidden" data-action="palette#ouvrir" aria-label="Aller à un écran">
                    {{ ui.icone('recherche') }}
                </button>

                {% if app.user %}
                    {# Initiales et non photo : `header img` est réservé au logo de la
                       boutique, que `LogoBoutiqueTest` y cherche. #}
                    <details class="menu">
                        <summary class="flex items-center gap-2.5 rounded-full py-1 pl-1 pr-2 transition hover:bg-white/80">
                            <span class="avatar">{{ initiales ?: '?' }}</span>
                            <span class="hidden text-left leading-tight md:block">
                                <span class="block text-[13px] font-semibold text-stone-800">{{ nom_utilisateur }}</span>
                                <span class="block text-[11px] text-stone-500">{{ is_granted('ROLE_DIRIGEANTE') ? 'Dirigeante' : (is_granted('ROLE_GERANT') ? 'Gérance' : 'Magasin') }}</span>
                            </span>
                        </summary>
                        <div class="menu-panneau">
                            <div class="px-3 pb-2 pt-1.5">
                                <div class="text-sm font-semibold text-stone-900">{{ nom_utilisateur }}</div>
                                <div class="truncate text-xs text-stone-500">{{ app.user.email }}</div>
                            </div>
                            <div class="my-1 h-px bg-stone-100"></div>
                            <a href="{{ path('app_compte_mot_de_passe') }}" class="menu-lien">
                                {{ ui.icone('cle') }} Changer mon mot de passe
                            </a>
                            <a href="{{ path('app_logout') }}" class="menu-lien">
                                {{ ui.icone('deconnexion') }} Déconnexion
                            </a>
                        </div>
                    </details>
                {% endif %}
            </div>
        </header>

        <main class="contenu">
            <div class="entete-page apparition">
                <div class="min-w-0">
                    {% if groupe_courant %}<div class="sur-titre">{{ groupe_courant }}</div>{% endif %}
                    <h1>{{ block('page_title') }}</h1>
                    {% if block('page_sous_titre') is defined %}
                        <p class="mt-1.5 max-w-2xl text-sm text-stone-500">{{ block('page_sous_titre') }}</p>
                    {% endif %}
                </div>
                <div class="actions-page">{% block page_actions %}{% endblock %}</div>
            </div>

            {# Alerte du stock de la boutique : sans objet pour le magasinier, dont le
               module a son propre stock. #}
            {% set sousSeuil = is_granted('ROLE_GERANT') ? alertesStock.matieresSousSeuil : [] %}
            {% if sousSeuil is not empty %}
                <div class="alerte alerte-ambre apparition mb-5" style="--i: 1">
                    {{ ui.icone('pertes') }}
                    <div class="min-w-0 flex-1">
                        <span class="font-semibold">Stock bas :</span>
                        {{ sousSeuil|length }} matière(s) sous le seuil —
                        {% for matiere in sousSeuil|slice(0, 4) %}{{ matiere.nom }}{{ not loop.last ? ', ' }}{% endfor %}{% if sousSeuil|length > 4 %}…{% endif %}
                    </div>
                    {# Le stock est réservé à la dirigeante : la gérante voit l'alerte, pas un lien vers un 403. #}
                    {% if is_granted('ROLE_DIRIGEANTE') %}
                        <a href="{{ path('admin_matiere_index') }}" class="lien shrink-0 text-amber-900">Voir le stock</a>
                    {% endif %}
                </div>
            {% endif %}

            {{ include('magasin/_alerte_seuil.html.twig') }}

            {% block admin_content %}{% endblock %}
        </main>
    </div>

    {# ======================= Messages flash ======================= #}
    {{ include('admin/_toasts.html.twig') }}

    {# ======================= Palette ⌘K ======================= #}
    <dialog class="palette" data-palette-target="dialogue" data-action="click->palette#fermerSurFond" aria-label="Aller à un écran">
        <div class="palette-recherche">
            {{ ui.icone('recherche') }}
            <input type="text" placeholder="Aller à un écran…" autocomplete="off"
                   data-palette-target="champ"
                   data-action="input->palette#filtrer keydown->palette#naviguer">
            <kbd class="touche-clavier">Échap</kbd>
        </div>
        <div class="palette-liste" role="listbox">
            {% for groupe in groupes %}
                {% for entree in groupe.entrees|filter(entree => entree.role is not defined or is_granted(entree.role)) %}
                    <a href="{{ path(entree.route) }}" class="palette-element" role="option" aria-selected="false"
                       data-palette-target="element" data-recherche="{{ entree.label }} {{ groupe.titre }}"
                       data-action="mouseenter->palette#survoler">
                        {{ ui.icone(entree.icone) }}
                        <span>{{ entree.label }}</span>
                        <small>{{ groupe.titre }}</small>
                    </a>
                {% endfor %}
            {% endfor %}
            <p class="palette-vide" data-palette-target="vide" hidden>Aucun écran ne correspond.</p>
        </div>
    </dialog>
</div>
</div>
{% endblock %}
