{# Formatage cohérent des montants (centimes → FCFA), quantités (millièmes → unités) et pourcentages (points de base). #}

{% macro fcfa(centimes) %}{{ (centimes / 100)|number_format(0, ',', ' ') }} FCFA{% endmacro %}

{% macro unites(millimes) %}{{ (millimes / 1000)|number_format((millimes % 1000 == 0) ? 0 : 3, ',', ' ') }}{% endmacro %}

{% macro pourcent(bp) %}{{ (bp / 100)|number_format((bp % 100 == 0) ? 0 : 2, ',', ' ') }} %{% endmacro %}

{% macro badge(actif) %}
    {% if actif %}
        <span class="badge badge-vert badge-point">Actif</span>
    {% else %}
        <span class="badge badge-neutre badge-point">Inactif</span>
    {% endif %}
{% endmacro %}

{# Détail d'un ticket en une ligne : « 2 × Croissant, 1 × Café » — même écriture
   « quantité × nom » que le ticket imprimé (templates/ticket/_contenu.html.twig).
   Appelle `vente.lignes` : la jointure anticipée appartient au repository, pas
   à ce gabarit (voir VenteRepository::journee() et ::pourSession()). #}
{% macro articlesVente(vente) %}
    {%- for ligne in vente.lignes -%}
        {{- not loop.first ? ', ' -}}{{ _self.unites(ligne.quantite) }} × {{ ligne.article.nom }}
    {%- endfor -%}
{% endmacro %}
