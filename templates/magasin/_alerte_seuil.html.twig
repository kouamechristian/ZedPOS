{# Bannière « seuil atteint » du magasin, en tête de chaque écran de gestion et du
   pilotage, pour qui voit le magasin (MAGASIN_VOIR : gérante, dirigeante,
   magasinier). Relue sur le stock à chaque page : elle disparaît d'elle-même
   quand une réception fait remonter le produit — rien à acquitter.

   Trois produits nommés au plus ; le détail est sur le tableau de bord, qui la
   montre déjà en tableau — d'où son absence sur cet écran. #}
{% if is_granted('MAGASIN_VOIR') and app.request.attributes.get('_route') != 'magasin_tableau_de_bord' %}
    {% set auSeuil = magasin_alertes() %}
    {% if auSeuil is not empty %}
        {# role="status" et non "alert" : un bandeau permanent s'annonce sans couper la
           parole, et `[role="alert"]` reste aux erreurs de formulaire de la page. #}
        <div class="alerte alerte-rouge apparition mb-5" role="status" id="alerte-seuil-magasin">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
            <div class="min-w-0 flex-1">
                <span class="font-semibold">Magasin — {{ auSeuil|length }} produit{{ auSeuil|length > 1 ? 's' }} au seuil d'alerte :</span>
                {% for ligne in auSeuil|slice(0, 3) %}
                    {{ ligne.produit.nom }} ({{ magasin_quantite(ligne.produit, ligne.quantite) }}, seuil {{ magasin_quantite(ligne.produit, ligne.produit.seuilAlerte) }}){{ not loop.last ? ' ;' }}
                {% endfor %}
                {% if auSeuil|length > 3 %}et {{ auSeuil|length - 3 }} autre{{ auSeuil|length - 3 > 1 ? 's' }}.{% endif %}
            </div>
            <a href="{{ path('magasin_tableau_de_bord') }}#sous-seuil" class="lien shrink-0">Voir</a>
        </div>
    {% endif %}
{% endif %}
