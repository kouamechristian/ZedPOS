{% extends 'admin/base.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}
{% import 'magasin/reception/_frise.html.twig' as rec %}

{# Étape 3 — l'inspection. Pour chaque ligne : ce qui est rejeté et pourquoi ;
   l'accepté se déduit (compté − rejeté) et s'affiche en direct
   (`reception_inspection_controller.js`). Une livraison sans incident s'inspecte
   donc d'un seul appui sur « Valider ». Le motif n'est demandé que s'il y a un
   rejet ; l'entité refuse un rejet sans motif. #}

{% block page_title %}Inspection — {{ reception.numero }}{% endblock %}
{% block page_sous_titre %}Étape 3 — vérifiez l'état de la marchandise : ce qui est rejeté n'entre pas en stock.{% endblock %}

{% block page_actions %}
    <a href="{{ path('magasin_reception_show', {id: reception.id}) }}" class="btn btn-fantome">{{ ui.icone('retour') }} Fiche</a>
{% endblock %}

{% block admin_content %}
{{ rec.frise(reception, 'INSPECTEE') }}
{{ rec.erreur(erreur) }}

<form method="post" class="carte apparition max-w-5xl" data-controller="reception-inspection">
    <input type="hidden" name="_token" value="{{ csrf_token('reception_' ~ reception.id) }}">
    <div class="carte-corps">
        <div class="defilement-x">
        <table class="tableau" id="lignes-inspection">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th class="num">Compté</th>
                    <th class="num">Rejeté</th>
                    <th>Motif du rejet</th>
                    <th class="num">Accepté</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in reception.lignes %}
                    {% set s = saisie is not null ? (saisie[ligne.id] ?? {}) : {rejetee: ligne.qteRejetee ? rec.champ(ligne.qteRejetee) : '', motif: ligne.motifRejet ? ligne.motifRejet.value : ''} %}
                    <tr data-reception-inspection-target="ligne" data-comptee="{{ rec.champ(ligne.qteComptee) }}" data-unite="{{ ligne.uniteSaisie }}">
                        <td class="cellule-principale">{{ ligne.produit.nom }}</td>
                        <td class="num tabular-nums">{{ rec.qte(ligne.qteComptee, ligne) }}</td>
                        <td class="num">
                            <input name="decisions[{{ ligne.id }}][rejetee]" class="champ w-24 text-right tabular-nums" inputmode="decimal"
                                   value="{{ s.rejetee ?? '' }}" placeholder="0"
                                   data-action="input->reception-inspection#calculer" aria-label="Quantité rejetée — {{ ligne.produit.nom }}">
                        </td>
                        <td>
                            <select name="decisions[{{ ligne.id }}][motif]" class="champ" aria-label="Motif du rejet — {{ ligne.produit.nom }}">
                                <option value="">—</option>
                                {% for m in motifs %}
                                    <option value="{{ m.value }}" {{ (s.motif ?? '') == m.value ? 'selected' }}>{{ m.libelle }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td class="num tabular-nums">
                            <strong data-accepte>{{ rec.qte(ligne.qteAcceptee ?? ligne.qteComptee, ligne) }}</strong>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
        <p class="aide mt-3">Accepté = compté − rejeté. Le rejeté est rendu au fournisseur ; il figure sur le bon imprimé avec son motif.</p>
    </div>
    <div class="carte-pied">
        <button class="btn btn-primaire btn-lg">{{ ui.icone('valide') }} Valider l'inspection</button>
    </div>
</form>
{% endblock %}
