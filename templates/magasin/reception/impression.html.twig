{# Bon de réception A4, à classer avec le bon de livraison du fournisseur.

   Il dit ce qui était annoncé, ce qui a été compté, ce qui a été **rejeté et
   pourquoi** — c'est la pièce qu'on oppose au fournisseur pour un avoir — et ce
   qui est entré. Page autonome en noir et blanc, comme le bon de sortie d'une
   dotation. Les prix n'y figurent qu'avec MAGASIN_VOIR_PRIX. Une réception non
   stockée ou annulée s'imprime barrée de son état. #}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'magasin/reception/_frise.html.twig' as rec %}
{% set voir_prix = is_granted('MAGASIN_VOIR_PRIX') %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Bon de réception {{ reception.numero }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; font-size: 12px; color: #000; background: #fff; padding: 12mm; }
        .entete { display: flex; justify-content: space-between; align-items: flex-start; gap: 8mm; margin-bottom: 8mm; }
        .boutique { display: flex; align-items: center; gap: 4mm; }
        .boutique img { max-height: 18mm; max-width: 40mm; object-fit: contain; }
        .boutique .nom { font-size: 15px; font-weight: 700; }
        h1 { font-size: 18px; text-align: right; }
        .numero { text-align: right; font-size: 14px; font-weight: 700; letter-spacing: .03em; }
        .infos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3mm; margin-bottom: 6mm; }
        .infos div { border: 1px solid #999; padding: 2mm 3mm; }
        .infos span { display: block; font-size: 10px; text-transform: uppercase; color: #444; }
        .infos strong { font-size: 13px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border-bottom: 1px solid #999; padding: 5px 4px; text-align: left; vertical-align: top; }
        th { font-size: 10px; text-transform: uppercase; letter-spacing: .04em; }
        .droite { text-align: right; font-variant-numeric: tabular-nums; }
        .ecart { font-weight: 700; }
        .statut { margin-bottom: 6mm; padding: 3mm; border: 3px double #000; font-size: 16px; font-weight: 800; text-align: center; text-transform: uppercase; }
        .notes { margin-top: 5mm; }
        .notes p { margin-bottom: 2mm; }
        .etapes { margin-top: 5mm; display: grid; grid-template-columns: repeat(4, 1fr); gap: 3mm; font-size: 11px; }
        .etapes div { border: 1px solid #999; padding: 2mm; }
        .etapes span { display: block; font-size: 10px; text-transform: uppercase; color: #444; }
        .signatures { display: grid; grid-template-columns: 1fr 1fr; gap: 10mm; margin-top: 12mm; }
        .signature { border-top: 1px solid #000; padding-top: 2mm; min-height: 24mm; }
        .signature strong { display: block; margin-bottom: 1mm; }
        @page { size: A4 portrait; margin: 0; }
        @media print { thead { display: table-header-group; } tr { break-inside: avoid; } .signatures { break-inside: avoid; } }
    </style>
</head>
<body>
    <div class="entete">
        <div class="boutique">
            {% set logo = logo_boutique() %}
            {% if logo %}<img src="{{ logo }}" alt="" onerror="this.remove()">{% endif %}
            <div class="nom">{{ nom_boutique() }}</div>
        </div>
        <div>
            <h1>Bon de réception</h1>
            <div class="numero">{{ reception.numero }}</div>
        </div>
    </div>

    {% if reception.statut.value == 'ANNULEE' %}
        <div class="statut">Réception annulée — sans valeur ({{ reception.motifAnnulation }})</div>
    {% elseif not reception.estStockee %}
        <div class="statut">Réception non stockée — étape en cours : {{ reception.statut.prochaineEtape }}</div>
    {% endif %}

    <div class="infos">
        <div><span>Fournisseur</span><strong>{{ reception.fournisseur.nom }}</strong></div>
        <div><span>Bon de livraison</span><strong>{{ reception.bonLivraison ?: '—' }}</strong></div>
        <div><span>Date de réception</span><strong>{{ reception.dateReception|date('d/m/Y') }}</strong></div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Produit</th>
                <th class="droite">Annoncé</th>
                <th class="droite">Compté</th>
                <th class="droite">Rejeté</th>
                <th>Motif du rejet</th>
                <th class="droite">Accepté</th>
                <th>Emplacement</th>
                {% if voir_prix %}<th class="droite">Prix unit.</th><th class="droite">Valeur</th>{% endif %}
            </tr>
        </thead>
        <tbody>
            {% for ligne in reception.lignes %}
                <tr>
                    <td>{{ ligne.produit.nom }}</td>
                    <td class="droite">{{ rec.qte(ligne.qteAnnoncee, ligne) }}</td>
                    <td class="droite {{ ligne.aUnEcartDeComptage ? 'ecart' }}">{{ rec.qte(ligne.qteComptee, ligne) }}{{ ligne.aUnEcartDeComptage ? ' *' }}</td>
                    <td class="droite">{{ ligne.qteRejetee ? rec.qte(ligne.qteRejetee, ligne) : '—' }}</td>
                    <td>{{ ligne.motifRejet ? ligne.motifRejet.libelle : '—' }}</td>
                    <td class="droite">{{ rec.qte(ligne.qteAcceptee, ligne) }}</td>
                    <td>{{ ligne.emplacement ? ligne.emplacement.libelle : '—' }}</td>
                    {% if voir_prix %}
                        <td class="droite">{{ ligne.prixUnitaire is not null ? fmt.fcfa(ligne.prixUnitaire) : '—' }}</td>
                        <td class="droite">{{ ligne.valeurAcceptee is not null and ligne.qteAcceptee is not null ? fmt.fcfa(ligne.valeurAcceptee) : '—' }}</td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="notes">
        {% if reception.aDesEcartsDeComptage %}<p>* Écart entre le bon de livraison et le comptage : {{ reception.commentaireControle }}</p>{% endif %}
        {% if reception.aDesRejets %}<p>Les quantités rejetées sont rendues au fournisseur et n'entrent pas en stock.</p>{% endif %}
        {% if reception.commentaire %}<p>Commentaire : {{ reception.commentaire }}</p>{% endif %}
    </div>

    <div class="etapes">
        <div><span>Reçue</span>{{ reception.recuePar.nom }}<br>{{ reception.createdAt|date('d/m/Y H:i') }}</div>
        <div><span>Contrôlée</span>{% if reception.controleePar %}{{ reception.controleePar.nom }}<br>{{ reception.controleeAt|date('d/m/Y H:i') }}{% else %}—{% endif %}</div>
        <div><span>Inspectée</span>{% if reception.inspecteePar %}{{ reception.inspecteePar.nom }}<br>{{ reception.inspecteeAt|date('d/m/Y H:i') }}{% else %}—{% endif %}</div>
        <div><span>Stockée</span>{% if reception.stockeePar %}{{ reception.stockeePar.nom }}<br>{{ reception.stockeeAt|date('d/m/Y H:i') }}{% else %}—{% endif %}</div>
    </div>

    <div class="signatures">
        <div class="signature"><strong>Le magasin</strong><small>Nom et signature</small></div>
        <div class="signature"><strong>Le livreur</strong><small>« Pris acte des quantités et des rejets ci-dessus », signature</small></div>
    </div>
</body>
</html>
