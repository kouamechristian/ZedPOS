{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{# Fiche d'un produit du magasin. Ni stock ni coût moyen : le stock ne bouge que
   par les bons du module (le premier inventaire fait le stock de départ), le coût
   moyen découle des prix saisis à la réception. #}

{% block page_title %}{{ titre }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('magasin_produit_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Produits</a>
{% endblock %}

{% block admin_content %}
<div class="carte apparition max-w-3xl">
    {{ form_start(form) }}
    <div class="carte-corps">
        <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
            <div class="sm:col-span-2">{{ form_row(form.nom) }}</div>
            {{ form_row(form.categorie) }}
            {{ form_row(form.uniteStock) }}
            {{ form_row(form.uniteAchat) }}
            {{ form_row(form.contenanceAchat) }}
            {{ form_row(form.seuilAlerte) }}
            {{ form_row(form.fournisseurHabituel) }}
            {{ form_row(form.actif) }}
        </div>
        <div class="alerte alerte-bleu mt-1">
            {{ ui.icone('info') }}
            <p>Le stock ne se saisit pas ici : il entre par les réceptions, et le premier inventaire sert de stock de départ.</p>
        </div>
    </div>
    <div class="carte-pied">
        <button class="btn btn-primaire">{{ ui.icone('valide') }} Enregistrer</button>
        <a href="{{ path('magasin_produit_index') }}" class="btn btn-fantome">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
