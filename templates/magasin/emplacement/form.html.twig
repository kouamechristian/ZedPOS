{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}{{ titre }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('magasin_emplacement_index') }}" class="btn btn-fantome">{{ ui.icone('retour') }} Emplacements</a>
{% endblock %}

{% block admin_content %}
<div class="carte apparition max-w-2xl">
    {{ form_start(form) }}
    <div class="carte-corps">
        {% if form.code is defined %}
            {{ form_row(form.code) }}
        {% else %}
            <p class="mb-3 text-sm text-stone-600">Code : <strong>{{ emplacement.code }}</strong> — il ne se modifie pas.</p>
        {% endif %}
        {{ form_row(form.libelle) }}
        {{ form_row(form.actif) }}
    </div>
    <div class="carte-pied">
        <button class="btn btn-primaire">{{ ui.icone('valide') }} Enregistrer</button>
        <a href="{{ path('magasin_emplacement_index') }}" class="btn btn-fantome">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
