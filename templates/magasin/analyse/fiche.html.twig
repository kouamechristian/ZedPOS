{% extends 'admin/base.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}
{% import 'magasin/analyse/_filtre.html.twig' as af %}

{# Fiche de stock d'un produit : ses mouvements de la période dans l'ordre, avec
   le solde après chacun, à partir du stock au début de la période. Le document
   d'origine (réception, sortie) est cliquable ; l'auteur est celui du mouvement. #}

{% block page_title %}Fiche de stock — {{ produit.nom }}{% endblock %}
{% block page_sous_titre %}Mouvements {{ filtre.libelle }}{{ filtre.emplacement ? ' — ' ~ filtre.emplacement.libelle }}.{% endblock %}

{% block page_actions %}
    <a href="{{ path('magasin_fiche_stock_pdf', {id: produit.id}|merge(filtre.parametres)) }}" class="btn btn-secondaire" data-turbo="false" target="_blank">{{ ui.icone('telecharger') }} PDF</a>
    <a href="{{ path('magasin_analyse', filtre.parametres) }}" class="btn btn-fantome">{{ ui.icone('retour') }} Analyse</a>
{% endblock %}

{% block admin_content %}
{{ af.barre('magasin_fiche_stock', filtre, emplacements, null, {id: produit.id}) }}

<div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
    <div class="carte"><div class="carte-corps"><div class="sur-titre">Stock au début</div><div class="text-lg font-semibold tabular-nums" id="stock-debut">{{ magasin_quantite(produit, fiche.debut) }}</div></div></div>
    <div class="carte"><div class="carte-corps"><div class="sur-titre">Mouvements</div><div class="text-lg font-semibold tabular-nums">{{ fiche.mouvements|length }}</div></div></div>
    <div class="carte"><div class="carte-corps"><div class="sur-titre">Stock à la fin</div><div class="text-lg font-semibold tabular-nums" id="stock-fin">{{ magasin_quantite(produit, fiche.fin) }}</div></div></div>
</div>

<div class="tableau-conteneur apparition">
    <div class="defilement-x">
    <table class="tableau" id="fiche-stock">
        <thead>
            <tr>
                <th>Date</th>
                <th>Mouvement</th>
                <th>Document</th>
                <th>Emplacement</th>
                <th class="num">Entrée</th>
                <th class="num">Sortie</th>
                <th class="num">Solde</th>
                <th>Par</th>
            </tr>
        </thead>
        <tbody>
            {% for m in fiche.mouvements %}
                <tr>
                    <td class="cellule-douce tabular-nums">{{ m.date|date('d/m/Y H:i') }}</td>
                    <td>{{ m.type.libelle }}</td>
                    <td>{{ _self.document(m) }}</td>
                    <td class="cellule-douce">{{ m.emplacement }}</td>
                    <td class="num tabular-nums text-green-800">{{ m.quantite > 0 ? '+' ~ magasin_quantite(produit, m.quantite) : '' }}</td>
                    <td class="num tabular-nums text-red-800">{{ m.quantite < 0 ? '−' ~ magasin_quantite(produit, -m.quantite) : '' }}</td>
                    <td class="num tabular-nums font-semibold">{{ magasin_quantite(produit, m.solde) }}</td>
                    <td class="cellule-douce">{{ m.auteur ?? '—' }}</td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="cellule-vide">Aucun mouvement sur la période.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endblock %}

{% macro document(m) %}
    {% set routes = {reception: 'magasin_reception_show', sortie: 'magasin_sortie_show', inventaire: 'magasin_inventaire_show'} %}
    {% if routes[m.documentType] is defined %}
        <a href="{{ path(routes[m.documentType], {id: m.documentId}) }}" class="lien">{{ m.numero ?? (m.documentType ~ ' n° ' ~ m.documentId) }}</a>
    {% else %}
        <span class="cellule-douce">{{ m.numero ?? m.documentType ~ ' n° ' ~ m.documentId }}</span>
    {% endif %}
{% endmacro %}
