<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ticket {{ ticket.numero }}</title>
    {% import 'admin/_macros.html.twig' as fmt %}
    {# Format du ticket : partagé avec le reçu de l'écran de caisse. #}
    {{ include('ticket/_styles.html.twig') }}
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Courier New', ui-monospace, monospace; font-size: 12px; color: #000; background: #e5e7eb; }
        .barre { max-width: 80mm; margin: 10px auto 0; display: flex; gap: 8px; }
        .barre button { flex: 1; padding: 8px; font: inherit; cursor: pointer; border: 1px solid #334155; background: #0f172a; color: #fff; border-radius: 6px; }
        .barre button.secondaire { background: #fff; color: #0f172a; }
        .ticket { margin: 10px auto; }

        /* À l'écran seulement : le ticket a l'air d'un morceau de papier posé là.
           Rien de tout cela ne part à l'imprimante (voir @media print). */
        @media screen {
            .ticket { box-shadow: 0 1px 6px rgba(0, 0, 0, .18); }
        }

        @media print {
            body { background: #fff; }
            .barre { display: none; }
            /* La page EST le ticket : ni largeur imposée, ni blanc autour. */
            .ticket { width: auto; margin: 0; padding: 0; box-shadow: none; }
            @page { size: 80mm auto; margin: 0; }
        }
    </style>
</head>
<body>
    <div class="barre">
        <button type="button" onclick="window.print()">Imprimer</button>
        <button type="button" class="secondaire" onclick="window.close()">Fermer</button>
    </div>

    {{ include("ticket/_contenu.html.twig") }}
    {% if auto %}
    <script>
        window.addEventListener('load', function () { window.print(); });
    </script>
    {% endif %}
</body>
</html>
