{# Cadre de l'espace comptable. Lecture seule : aucune action d'écriture n'y a
   sa place, la navigation ne propose donc que des consultations et des exports. #}
{% extends 'base.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block title %}{% block page_title %}Comptabilité{% endblock %} — ZedPOS{% endblock %}

{% block body %}
<div class="espace-gestion min-h-screen pb-10">
    <header class="entete-flottante">
        <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
            <div class="flex min-w-0 items-center gap-3">
                <span class="marque-pastille">Z</span>
                <div class="min-w-0 leading-tight">
                    <div class="text-[15px] font-bold tracking-tight text-stone-900">ZedPOS</div>
                    <div class="truncate text-xs font-medium text-amber-700">Comptabilité · SYSCOHADA révisé</div>
                </div>
            </div>
            <div class="flex items-center gap-2 text-sm">
                {% if app.user %}
                    <span class="mr-1 hidden truncate text-stone-600 md:inline">{{ app.user.nom }}</span>
                {% endif %}
                {# Retour au back-office pour qui y a accès — le gérant vient
                   d'ici et n'aurait sinon que la déconnexion pour ressortir. On
                   teste bien le **rôle** et non une permission : c'est le pare-feu
                   `^/admin` qu'on reproduit, pas une décision métier. Le comptable
                   ne voit pas ce lien, qui ne lui rendrait qu'un 403. #}
                {% if is_granted('ROLE_GERANT') %}
                    <a href="{{ path('admin_dashboard') }}" data-turbo-prefetch="true" class="btn btn-secondaire btn-sm max-sm:hidden">
                        {{ ui.icone('backoffice') }} Back-office
                    </a>
                {% endif %}
                <a href="{{ path('app_compte_mot_de_passe') }}" class="btn btn-secondaire btn-sm"
                   title="Changer mon mot de passe" aria-label="Changer mon mot de passe">
                    {{ ui.icone('cle') }}<span class="max-lg:hidden">Mot de passe</span>
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-secondaire btn-sm">
                    {{ ui.icone('deconnexion') }}<span class="max-sm:hidden">Quitter</span>
                </a>
            </div>
        </div>
    </header>

    <main class="contenu max-w-6xl">
        {% block comptabilite_content %}{% endblock %}
    </main>

    {{ include('admin/_toasts.html.twig') }}
</div>
{% endblock %}
