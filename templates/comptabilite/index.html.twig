{% extends 'comptabilite/base.html.twig' %}
{% import 'admin/_macros.html.twig' as fmt %}
{% import 'admin/_icones.html.twig' as ui %}

{% block page_title %}Exports comptables SYSCOHADA{% endblock %}

{% block comptabilite_content %}

<div class="entete-page apparition">
    <div>
        <div class="sur-titre">Comptabilité</div>
        <h1>Exports comptables SYSCOHADA</h1>
        <p class="mt-1.5 max-w-2xl text-sm text-stone-500">Les écritures d'une période, rapprochées de la caisse avant de partir au cabinet.</p>
    </div>
</div>

{# --- Période -------------------------------------------------------------- #}
<section class="carte apparition p-4" style="--i: 1">
    <form method="get" class="flex flex-wrap items-end gap-3">
        <div>
            <label for="du" class="etiquette-legere">Du</label>
            <input type="date" id="du" name="du" value="{{ du|date('Y-m-d') }}" class="champ">
        </div>
        <div>
            <label for="au" class="etiquette-legere">Au</label>
            <input type="date" id="au" name="au" value="{{ au|date('Y-m-d') }}" class="champ">
        </div>
        <button class="btn btn-primaire">Afficher</button>

        <div class="onglets sm:ml-auto" data-turbo-prefetch="true">
            {% for raccourci in raccourcis %}
                {% set actif = du|date('Y-m-d') == raccourci.du and au|date('Y-m-d') == raccourci.au %}
                <a href="{{ path('app_comptabilite', {du: raccourci.du, au: raccourci.au}) }}" class="onglet"
                   {% if actif %}aria-current="page"{% endif %}>
                    {{ raccourci.label }}
                </a>
            {% endfor %}
        </div>
    </form>
</section>

{% if jeu.estVide %}
    <div class="carte apparition mt-5 px-5 py-14 text-center" style="--i: 2">
        <span class="mx-auto mb-3 grid h-12 w-12 place-items-center rounded-2xl bg-stone-100 text-stone-400">{{ ui.icone('comptabilite', 'h-6 w-6') }}</span>
        <p class="text-stone-500">Aucune écriture sur cette période.</p>
    </div>
{% else %}

{# --- Contrôles ------------------------------------------------------------
   Ce bloc est le cœur de l'écran : avant de transmettre un fichier, on vérifie
   qu'il dit la même chose que la caisse. Il vire à l'ambre au moindre écart. #}
{% set bons = jeu.controlesSontBons %}
<section class="carte apparition mt-5 overflow-hidden {{ bons ? 'ring-1 ring-green-200' : 'ring-2 ring-amber-300' }}" style="--i: 2">
    <div class="carte-entete {{ bons ? 'bg-green-50/70' : 'bg-amber-50' }}">
        <h2 class="carte-titre flex items-center gap-2 {{ bons ? 'text-green-900' : 'text-amber-900' }}">
            <span class="{{ bons ? 'text-green-600' : 'text-amber-600' }}">{{ ui.icone(bons ? 'valide' : 'pertes') }}</span>
            {{ bons ? 'Contrôles conformes' : 'Contrôles à vérifier' }}
        </h2>
        <span class="text-sm {{ bons ? 'text-green-700' : 'text-amber-800' }}">
            {{ jeu.nombreEcritures }} écriture{{ jeu.nombreEcritures > 1 ? 's' }},
            {{ jeu.nombreLignes }} ligne{{ jeu.nombreLignes > 1 ? 's' }}
        </span>
    </div>

    <div class="defilement-x">
        <table class="tableau">
            <thead>
                <tr>
                    <th>Rapprochement</th>
                    <th class="num">Application</th>
                    <th class="num">Écritures</th>
                    <th class="num">Écart</th>
                </tr>
            </thead>
            <tbody>
                {% for controle in jeu.controles %}
                    <tr>
                        <td>
                            <span class="{{ controle.estBon ? 'text-green-700' : 'font-semibold text-amber-800' }}">
                                {{ controle.estBon ? '✓' : '⚠' }}
                            </span>
                            {{ controle.libelle }}
                            {% if not controle.estBon %}
                                <div class="text-xs text-amber-800">{{ controle.explication }}</div>
                            {% endif %}
                        </td>
                        <td class="num">{{ fmt.fcfa(controle.attendu) }}</td>
                        <td class="num">{{ fmt.fcfa(controle.obtenu) }}</td>
                        <td class="num {{ controle.estBon ? 'text-stone-400' : 'font-semibold text-amber-900' }}">
                            {{ fmt.fcfa(controle.ecart) }}
                        </td>
                    </tr>
                {% endfor %}
                <tr>
                    <td>
                        <span class="{{ jeu.estEquilibre ? 'text-green-700' : 'font-semibold text-amber-800' }}">
                            {{ jeu.estEquilibre ? '✓' : '⚠' }}
                        </span>
                        Équilibre débit / crédit
                    </td>
                    <td class="num">{{ fmt.fcfa(jeu.totalDebit) }}</td>
                    <td class="num">{{ fmt.fcfa(jeu.totalCredit) }}</td>
                    <td class="num text-stone-400">
                        {{ fmt.fcfa(jeu.totalDebit - jeu.totalCredit) }}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

{# --- Téléchargements ------------------------------------------------------
   `data-turbo="false"` est indispensable : Turbo intercepte les clics sur les
   liens et attend une page HTML en retour. Sans lui, le fichier ne se
   téléchargerait pas — la navigation échouerait silencieusement. #}
<section class="mt-5 grid gap-4 sm:grid-cols-3">
    {% for format in formats %}
        <a href="{{ path('comptabilite_telecharger', {format: format.value, du: du|date('Y-m-d'), au: au|date('Y-m-d')}) }}"
           data-turbo="false"
           class="carte carte-interactive apparition group flex flex-col p-5" style="--i: {{ loop.index + 2 }}">
            <div class="flex items-center justify-between gap-2">
                <span class="kpi-icone">{{ ui.icone('telecharger') }}</span>
                <span class="badge badge-ambre uppercase tracking-wide">.{{ format.extension }}</span>
            </div>
            <span class="mt-3 font-bold text-stone-900">{{ format.libelle }}</span>
            <p class="mt-1 flex-1 text-xs leading-relaxed text-stone-500">{{ format.description }}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-amber-700">
                Télécharger
                <span class="transition-transform duration-300 group-hover:translate-x-1">{{ ui.icone('suivant', 'h-4 w-4') }}</span>
            </span>
        </a>
    {% endfor %}
</section>

{# --- Journaux -------------------------------------------------------------- #}
<section class="mt-5 grid gap-4 sm:grid-cols-3">
    {% for ligne in jeu.parJournal %}
        <article class="kpi apparition" style="--i: {{ loop.index + 5 }}">
            <div class="kpi-libelle">
                <span class="code rounded bg-stone-100 px-1.5 py-0.5 font-semibold text-stone-700">{{ ligne.journal.value }}</span>
                {{ ligne.journal.libelle }}
            </div>
            <div class="kpi-valeur">{{ fmt.fcfa(ligne.total) }}</div>
            <div class="kpi-note">{{ ligne.ecritures }} écriture{{ ligne.ecritures > 1 ? 's' }}</div>
        </article>
    {% endfor %}
</section>

{# --- Balance --------------------------------------------------------------- #}
<section class="tableau-conteneur apparition mt-5" style="--i: 9">
    <div class="carte-entete"><h2 class="carte-titre">Balance générale</h2></div>
    <div class="defilement-x">
        <table class="tableau">
            <thead>
                <tr>
                    <th>Compte</th>
                    <th>Libellé</th>
                    <th class="num">Débit</th>
                    <th class="num">Crédit</th>
                    <th class="num">Solde</th>
                </tr>
            </thead>
            <tbody>
                {% for compte in jeu.balance %}
                    <tr>
                        <td><span class="code rounded bg-stone-100 px-1.5 py-0.5 text-stone-700">{{ compte.compte }}</span></td>
                        <td class="text-stone-700">{{ compte.libelle }}</td>
                        <td class="num cellule-douce">{{ compte.debit ? fmt.fcfa(compte.debit) : '—' }}</td>
                        <td class="num cellule-douce">{{ compte.credit ? fmt.fcfa(compte.credit) : '—' }}</td>
                        <td class="num font-medium {{ compte.solde < 0 ? 'text-stone-500' : 'text-stone-900' }}">{{ fmt.fcfa(compte.solde) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2">Total</td>
                    <td class="num">{{ fmt.fcfa(jeu.totalDebit) }}</td>
                    <td class="num">{{ fmt.fcfa(jeu.totalCredit) }}</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

<p class="aide mt-4 leading-relaxed">
    Plan de comptes <strong>SYSCOHADA révisé</strong>. Le journal des ventes centralise
    les tickets par rapport Z : une écriture par session de caisse et par journée,
    la pièce justificative étant le Z correspondant. Les ventes annulées sont exclues.
    Le compte de produits d'une famille se règle dans le back-office
    (<em>Familles → Compte de vente</em>) ; à défaut, les articles avec fiche technique
    sont traités en produits finis et les autres en marchandises.
</p>

{% endif %}
{% endblock %}
