{% extends 'base.html.twig' %}
{% import 'admin/_icones.html.twig' as ui %}

{% block title %}{{ titre }} — ZedPOS{% endblock %}

{% block body %}
<div class="espace-gestion min-h-screen">
    <header class="entete-flottante">
        <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-3 px-4">
            <div class="flex min-w-0 items-center gap-3">
                <span class="marque-pastille">Z</span>
                <div class="min-w-0 leading-tight">
                    <h1 class="truncate text-[15px] font-bold text-stone-900">{{ titre }}</h1>
                    <p class="truncate text-xs text-stone-500">{{ sous_titre }}</p>
                </div>
            </div>
            <div class="flex items-center gap-3 text-sm">
                {% if app.user %}
                    <span class="hidden text-stone-600 sm:inline">{{ app.user.nom }} ({{ app.user.email }})</span>
                {% endif %}
                <a href="{{ path('app_logout') }}" class="btn btn-secondaire btn-sm">
                    {{ ui.icone('deconnexion') }} Déconnexion
                </a>
            </div>
        </div>
    </header>

    <main class="contenu max-w-5xl">
        <div class="carte apparition p-8 text-center">
            <p class="text-stone-600">Bienvenue dans l'espace <strong>{{ titre }}</strong>.</p>
        </div>
    </main>
</div>
{% endblock %}
