{% extends 'base.html.twig' %}

{% block title %}Caisse — Code PIN{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 text-gray-900 flex flex-col items-center justify-center select-none"
     data-controller="numpad">
    <span class="mb-4 grid h-14 w-14 place-items-center rounded-2xl bg-amber-500 text-stone-900 text-xl font-black">Z</span>
    <h1 class="titre text-3xl font-bold mb-1">ZedPOS</h1>
    <p class="text-amber-700 mb-8">Saisissez votre code PIN</p>

    {% for message in app.flashes('caisse_erreur') %}
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-2 text-sm text-red-800">
            {{ message|trans({}, 'security') }}
        </div>
    {% endfor %}

    {# Points indiquant le nombre de chiffres saisis #}
    <div class="flex gap-4 mb-10" data-numpad-target="dots">
        {% for i in 1..4 %}
            <span class="h-5 w-5 rounded-full border-2 border-amber-400/50 transition-colors" data-dot></span>
        {% endfor %}
    </div>

    <form method="post" data-numpad-target="form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <input type="hidden" name="code_pin" data-numpad-target="input">

        <div class="grid grid-cols-3 gap-4">
            {% for chiffre in [1, 2, 3, 4, 5, 6, 7, 8, 9] %}
                <button type="button" data-action="numpad#appuyer" data-chiffre="{{ chiffre }}"
                        class="h-20 w-20 rounded-full bg-white border border-gray-300 text-3xl font-semibold text-gray-800 shadow-sm hover:bg-gray-200 active:bg-gray-300 transition">
                    {{ chiffre }}
                </button>
            {% endfor %}

            <button type="button" data-action="numpad#effacer"
                    class="h-20 w-20 rounded-full bg-gray-200 text-sm font-medium text-gray-700 hover:bg-gray-300 transition">
                Effacer
            </button>

            <button type="button" data-action="numpad#appuyer" data-chiffre="0"
                    class="h-20 w-20 rounded-full bg-white border border-gray-300 text-3xl font-semibold text-gray-800 shadow-sm hover:bg-gray-200 active:bg-gray-300 transition">
                0
            </button>

            <button type="button" data-action="numpad#reculer"
                    class="h-20 w-20 rounded-full bg-gray-200 text-2xl text-gray-700 hover:bg-gray-300 transition">
                ⌫
            </button>
        </div>
    </form>

    <a href="{{ path('app_login') }}" class="mt-10 text-sm text-gray-600 underline">Connexion par mot de passe</a>
</div>
{% endblock %}
